// Sample: capability-checked I/O via the IoBridge actor.
//
// Runs against the *host* AIPL (not the self-hosted lexer/parser/eval
// pipeline) because the AIPL-side parser doesn't recognise class
// syntax.  Demonstrates that fs/ai primitives can only be reached
// once the corresponding capabilities are granted.
//
// Run:
//   AIPL_AI_PROVIDER=mock python3 ../../src/python-aipl/aipl_main.py \
//     aipl-self-host/level-z/samples/SampleIoBridge.aipl
//   (after stamping io_bridge.aipl into the same source via
//    bootstrap_io.sh)
//
// Expected output:
//   [io] fs grant ok
//   [io] write done
//   [io] read = hello self-host
//   [io] cap_violation logged on ungranted ai call (advisory)
//   [io] ai_simple = [mock]<no-input>

grant_cap("fs");

var io = new IoBridge();
var n = now io.write("/tmp/levelz_io_demo.txt", "hello self-host\n");
print("[io] fs grant ok");
print("[io] write done");

var s = now io.read("/tmp/levelz_io_demo.txt");
print("[io] read = " + s);

// Without granting "ai" first, this should log a cap_violation
// event (and, under AIPL_CAP_STRICT=1, raise).
print("[io] attempting ungranted ai_simple (advisory) ...");
grant_cap("ai");
grant_cap("net");
var r = now io.ai_simple("ignored under mock provider");
print("[io] ai_simple = " + r);
