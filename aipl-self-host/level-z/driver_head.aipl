// Level Z — Driver head.
//
// Concatenated at build time *after* level-c/lexer.aipl + parser.aipl
// + eval.aipl by `bootstrap.py`, giving us tokenize / parse_program /
// run_program in scope.  This file just adds the actor that ties them
// together and emits a one-line completion marker.

class Bootstrap {
  method run(src: string) {
    var tokens = tokenize(src);
    print("[level-z] lex   : " + array_len(tokens) + " tokens");

    var prog = parse_program(tokens);
    print("[level-z] parse : " + array_len(prog.main) + " stmts");

    print("[level-z] eval  :");
    run_program(prog);
    print("[level-z] done");
  }
}
