class Line {
  var cx = 200.0;
  var cy = 200.0;
  var angle = 0.0;
  var offset = 0.0;
  var len = 50.0;

  method start() {
    call sdl_clear();
    call sdl_line(100, 100, 400, 300);
    call adl_present();
  }
  method rotate() {
    angle = angle + 5.0;
//    if (angle >= 360.0) {
//      angle = 0.0;
//    }
    if (angle >= 360.0) { angle = 0.0; } else { angle = angle; }

    var rad = (angle + offset) * 3.14159 / 180.0;
    var dx = len * cos(rad);
    var dy = len * sin(rad);
    var x1 = cx - dx;
    var y1 = cy - dy;
    var x2 = cx + dx;
    var y2 = cy + dy;
    call sdl_line(x1, y1, x2, y2);    
    send self.rotate();
  }
}

