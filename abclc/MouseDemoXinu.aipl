// MouseDemoXinu.aipl
// G3 demo: PL050 mouse → AIPL actor message dispatch.
//
// MouseLogger subscribes itself to all three event kinds, then
// synthesises 4 events via mouse_inject() so the smoke can verify the
// path end-to-end without depending on a QEMU mouse.  Each callback
// also writes back a digest field so a final dump confirms the actor
// thread actually received the message (not just the [aipl] marker).
//
// _smoke_g3.sh expects:
//   (1) mouse_on_{click,move,release} subscribe markers all observed
//   (2) mouse_event kind=click|move|release markers observed in order
//   (3) actor digests printed — proves messages reached the AIPL thread
//   (4) mouse_state encodes (x<<20)|(y<<8)|btn after the last event

class MouseLogger {
  var n_click   = 0;
  var n_move    = 0;
  var n_release = 0;
  var last_x    = 0;
  var last_y    = 0;
  var last_btn  = 0;

  method init() {
    // Subscribe self to each event kind.  The runtime stamps target =
    // self.obj_id and copies the method name into a static table.
    mouse_on_click(self, "on_click");
    mouse_on_move(self, "on_move");
    mouse_on_release(self, "on_release");

    // Synthesise 4 events.  In production these would arrive from the
    // WM main loop via abcl_mouse_dispatch_*; mouse_inject lets the
    // smoke run headless.
    mouse_inject(0, 100, 200, 1);      // click @ (100,200), left btn
    mouse_inject(1, 105, 210, 1);      // move while holding left
    mouse_inject(1, 110, 220, 1);      // move
    mouse_inject(2, 110, 220, 0);      // release
  }

  method on_click(x, y, btn) {
    n_click  = n_click + 1;
    last_x   = x;
    last_y   = y;
    last_btn = btn;
    print(1000 + x);                   // 1100  -> tagged digest
  }

  method on_move(x, y, btn) {
    n_move   = n_move + 1;
    last_x   = x;
    last_y   = y;
    last_btn = btn;
    print(2000 + x);                   // 2105 / 2110
  }

  method on_release(x, y, btn) {
    n_release = n_release + 1;
    last_x    = x;
    last_y    = y;
    last_btn  = btn;
    print(3000 + x);                   // 3110

    // After the final event, also dump aggregate state so the smoke
    // can check counters + the packed mouse_state() value.
    print(9000 + n_click);             // 9001
    print(9100 + n_move);              // 9102
    print(9200 + n_release);           // 9201
    print(mouse_state());              // (110<<20)|(220<<8)|0 = 115399680
  }
}

var m = new MouseLogger();
