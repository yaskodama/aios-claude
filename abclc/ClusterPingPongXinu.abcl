// ClusterPingPongXinu.abcl — minimal 2-node ping-pong demo for N3
// (xinu-raz multi-Pi actor cluster, Phase A).
//
// Same .abcl source is compiled twice with different -DNODE_ID flags
// on the Xinu side.  At runtime the program branches on
// cluster_node_id() so node 0 instantiates a Pinger and node 1
// instantiates a Ponger.
//
// Wire path (one round):
//   Node 0 Pinger.start  → XSEND 1 0 ping 1      ↑
//   bridge rewrites      → SEND   0 ping 1       ↓ on node 1
//   Node 1 Ponger.ping(v)→ XSEND 0 0 pong (v+1)  ↑
//   bridge rewrites      → SEND   0 pong V       ↓ on node 0
//   Node 0 Pinger.pong(v)→ prints 90000 + v
//
// Builtins consumed (all to be defined in xinu-raz apps/abcl_xinu_cluster.c):
//   cluster_node_id() -> int       (0 or 1, baked at compile time)
//   cluster_size()    -> int       (always 2 in Phase A)
//   cluster_send(dst_node, actor_id, "method", arg_int)
//
// Smoke markers:
//   80001  — Ponger received first ping (v=1)
//   90002  — Pinger received pong back (v=2)
//   60000+ — additional pings/pongs in subsequent rounds

class Pinger {
  var rounds = 4;
  var sent   = 0;

  method init() {
    print(70000);                 // pinger-up marker
    send self.start();
  }

  method start() {
    sent = sent + 1;
    cluster_send(1, 0, "ping", sent);
  }

  method pong(v) {
    print(90000 + v);             // received pong with bumped value
    if (sent < rounds) {
      send self.start();
    } else {
      print(99999);               // pinger done
    }
  }
}

class Ponger {
  var seen = 0;

  method init() {
    print(70001);                 // ponger-up marker
  }

  method ping(v) {
    seen = seen + 1;
    print(80000 + v);             // received ping with v
    cluster_send(0, 0, "pong", v + 1);
  }
}

// Cluster-wide bootstrap: node 0 spawns Pinger, node 1 spawns Ponger.
// Both nodes need at least one actor at id 0 so the bridge's
// `SEND 0 ...` rewrite hits a live mailbox.  We wrap the conditional
// in a Bootstrap actor because AIPL only permits top-level VarDecl /
// Send / CallStmt, not bare `if`.
class Bootstrap {
  var pinger = nil;
  var ponger = nil;

  method init() {
    if (cluster_node_id() == 0) {
      pinger = new Pinger();
    } else {
      ponger = new Ponger();
    }
  }
}

var boot = new Bootstrap();
