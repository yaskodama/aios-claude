// MakinaDisplayActor.abcl - actor-to-actor "Blender display system" on Xinu.
// Display = the display-system actor (cls/tri via the kernel op_tri solid fill).
// Makina  = the 3-D-DATA actor; it STREAMS its 10500 triangles to Display with `send`.
// Main spawns both and wires them.  Full 24-bit colour: col = 0x1000000 | 0xRRGGBB.

class Main {
  var d = 0; var m = 0;
  method tick() { d = new Display(); m = new Makina(); send m.run(d); }
}

class Display {                 // the Blender display-system actor
  method clear() { cls(); }
  method tri(a,b,c,d,e,f,g) { tri(a,b,c,d,e,f,g); }   // -> kernel op_tri (full colour)
}

