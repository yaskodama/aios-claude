// AIPL top-level functions (OCaml runtime).
//
//   function name(p1, p2) {
//     ...
//     return expr;       // returns expr as the call's value
//   }
//
// Functions are callable from top-level statements and from inside
// class methods. They get a fresh parameter scope shadowed over the
// caller's environment; on `return` the value is propagated to the
// call site.

function add(a, b) {
  return a + b;
}

function id(x) {
  return x;
}

function describe(x) {
  return "value = " + x;
}

// fib via tail-style recursion (uses if as a statement; no expression-form).
function fib(n) {
  if (n < 2) {
    return n;
  }
  return fib(n - 1) + fib(n - 2);
}

print("add(3, 4)        = " + add(3, 4));
print("id(\"hi\")        = " + id("hi"));
print("describe(42)     = " + describe(42));
print("fib(10)          = " + fib(10));

// Call from inside a method body.
class Caller {
  method init() {
    print("[Caller] add(5, 6) = " + add(5, 6));
    print("[Caller] fib(7)    = " + fib(7));
  }
}

var c = new Caller();
