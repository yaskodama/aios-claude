// RemoteRpcDemoXinu.aipl
// H4 demo: actors that the host PC drives over UART1 RPC.
//
// Boot-time globals (`var c = new Counter()` / `var g = new Greeter()`)
// give them stable actor ids 0 and 1.  The host then talks to them via
// the RPC dispatcher (apps/abcl_xinu_rpc.c) running on PL011 UART1
// (0x101F2000), exposed by QEMU as TCP socket 127.0.0.1:5555.
//
// Expected flow when host_rpc_demo.sh / .py runs:
//   PING                       -> OK pong=1
//   SEND 0 bump                -> AIPL prints 7001 to UART0
//   SEND 0 bump                -> AIPL prints 7002
//   SEND 0 dump                -> AIPL prints 8002
//   SEND 1 set_who 42          -> AIPL prints 9042
//   SEND 1 hello               -> AIPL prints 10042
//   QUERY 0 0                  -> OK value=2     (Counter.n)
//   QUERY 1 0                  -> OK value=42    (Greeter.who_tag)
//   LIST                       -> OK n_actors=2

class Counter {
  var n = 0;

  method bump() {
    n = n + 1;
    print(7000 + n);                  // 7001, 7002, ...
  }

  method dump() {
    print(8000 + n);                  // 8000 + current n
  }
}

class Greeter {
  var who_tag = 0;

  method set_who(t) {
    who_tag = t;
    print(9000 + t);                  // 9042 for t=42
  }

  method hello() {
    print(10000 + who_tag);           // 10042 if who_tag=42
  }
}

// Boot-time instantiation.  Each `new` increments n_objects in
// objects[]; Counter lands at id=0, Greeter at id=1 because they
// are the only `new` statements in this program.
var c = new Counter();
var g = new Greeter();
