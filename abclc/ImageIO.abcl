// Image file I/O built-ins (OCaml runtime + JS-O).
//
//   image_create(w, h, r, g, b [, a])  -> image    solid-colour RGBA
//   image_load(path)                   -> image    reads PPM P6
//   image_save(image, path)            -> int (1)  writes PPM P6
//   image_size(image)                  -> tuple(w, h)
//   image_pixel(image, x, y)           -> tuple(r, g, b, a)
//   image_set_pixel(image, x, y, r, g, b [, a]) -> int (1)
//
// PPM (P6) is a header + raw RGB bytes — viewable in Preview.app,
// GIMP, ImageMagick, etc.  Alpha is dropped on save and set to 255
// on load.
var path = "/tmp/_aipl_img_test.ppm";

// 8x8 magenta canvas.
var img = image_create(8, 8, 200, 50, 200);
print("created          " + img);
print("image_size       = " + image_size(img));

// Paint a small green dot at (3,3).
image_set_pixel(img, 3, 3, 0, 255, 0);
print("pixel(3,3)       = " + image_pixel(img, 3, 3));
print("pixel(0,0)       = " + image_pixel(img, 0, 0));

// Persist + round-trip.
image_save(img, path);
print("saved to         " + path);

var loaded = image_load(path);
print("loaded           " + loaded);
print("loaded size      = " + image_size(loaded));
print("loaded(3,3)      = " + image_pixel(loaded, 3, 3));
print("loaded(0,0)      = " + image_pixel(loaded, 0, 0));

// Programmatic fill: draw a vertical gradient. We wrap the loops in
// a method because top-level `while` is not in the decl grammar.
class GradGen {
  method init() {
    var grad = image_create(16, 16, 0, 0, 0);
    var y = 0;
    while (y < 16) do {
      var x = 0;
      while (x < 16) do {
        image_set_pixel(grad, x, y, x * 16, y * 16, 128);
        x = x + 1;
      }
      y = y + 1;
    }
    image_save(grad, "/tmp/_aipl_img_grad.ppm");
    print("gradient saved to /tmp/_aipl_img_grad.ppm");
  }
}
var gg = new GradGen();
