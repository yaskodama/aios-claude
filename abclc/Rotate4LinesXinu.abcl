// Rotate4LinesXinu.abcl
// Xinu 上で 4 本の線分を回転させる AIPL プログラム + Start/Stop ボタン。
// 各 Spinner は Xinu thread (アクター) として動き、tick で角度更新。
// Controller はボタン押下を受けて全 spinner に start/stop を broadcast。

class Spinner {
  var idx: int = 0;
  var angle: float = 0.;
  var speed: int = 5;
  var cx: int = 0;
  var cy: int = 0;
  var radius: int = 60;
  var running: int = 1;
  var rr: int = 200;
  var gg: int = 220;
  var bb: int = 255;

  method init(i: int, sp: int, mx: int, my: int, r: int, g: int, b: int) {
    idx = i;
    speed = sp;
    cx = mx;
    cy = my;
    rr = r; gg = g; bb = b;
    running = 1;     // 起動時は走っている状態に
    send self.tick();
  }

  method start() { running = 1; }
  method stop()  { running = 0; }

  method tick() {
    if (running == 1) {
      angle = angle + speed;
      if (angle >= 360) {
        angle = angle - 360;
      }
    }
    var c = cos(angle);
    var s = sin(angle);
    var dx = c * radius / 1024;
    var dy = s * radius / 1024;
    var x1 = cx + dx;
    var y1 = cy + dy;
    var x2 = cx - dx;
    var y2 = cy - dy;
    xinu_gui_set_line(idx, x1, y1, x2, y2, rr, gg, bb);
  }
}

class Controller {
  var s1: any = 0; var s2: any = 0; var s3: any = 0; var s4: any = 0;

  method init() {
    // 正方形の 4 角
    s1 = new Spinner(0, 3, 200, 160, 255, 100, 100);
    s2 = new Spinner(1, 5, 440, 160, 100, 220, 130);
    s3 = new Spinner(2, 7, 200, 320, 100, 150, 255);
    s4 = new Spinner(3, 9, 440, 320, 240, 200, 100);

    xinu_gui_register_ticker(s1);
    xinu_gui_register_ticker(s2);
    xinu_gui_register_ticker(s3);
    xinu_gui_register_ticker(s4);

    // 画面上端 (640x480 LCD、ステータスバー直下) にボタン配置
    xinu_gui_add_button("Start",  40, 26, 90, 30, self, "start");
    xinu_gui_add_button("Stop",  510, 26, 90, 30, self, "stop");
  }

  method start() {
    send s1.start();
    send s2.start();
    send s3.start();
    send s4.start();
  }

  method stop() {
    send s1.stop();
    send s2.stop();
    send s3.stop();
    send s4.stop();
  }
}

var ctrl = new Controller();
