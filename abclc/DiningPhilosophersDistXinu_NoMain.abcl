// DiningPhilosophersDistXinu.abcl
// Distributed dining philosophers across host PC + Xinu, over UART1.
//
// Forks F0..F4  — Xinu AIPL actors (ids 0..4).
// Philosophers  — P1, P2, P3 on host (Python threads);
//                 P4, P5 on Xinu (AIPL actors ids 5, 6).
//
// Communication topology:
//   PC philosophers use the UART1 RPC channel — SEND fork.acquire(pid)
//     then QUERY the fork's `holder` field to see if they won.
//   Xinu philosophers use AIPL message passing — Fork.acquire calls
//     back via `send sender.fork_granted(pid)` / fork_denied(pid).
//     When the caller is a PC RPC (sender=-1), abcl_enqueue silently
//     drops the callback — which is what we want, because PC polls
//     instead.
//
// Deadlock avoidance: each philosopher acquires its LOWER-numbered
// fork first (classical resource hierarchy).
//
//     P1 (PC):  low=F0  high=F4
//     P2 (PC):  low=F0  high=F1
//     P3 (PC):  low=F1  high=F2
//     P4 (X):   low=F2  high=F3
//     P5 (X):   low=F3  high=F4
//
// Each philosopher eats 100 times then stops.  Eat marker:
//   60000 + 100 * pid + meal_idx
// (meal_idx ranges 0..99, so per-philosopher marker stays within
// a 100-wide bucket: P4 -> 60400..60499, P5 -> 60500..60599.)
// Done marker: 70000 + pid  (e.g. P4 -> 70004, P5 -> 70005).

class Fork {
  var holder = 0;     // 0 = free; >= 1 = pid currently holding

  method acquire(pid) {
    if (holder == 0) {
      holder = pid;
      send sender.fork_granted(pid);
    } else {
      send sender.fork_denied(pid);
    }
  }

  method release(pid) {
    if (holder == pid) {
      holder = 0;
    }
  }
}

class Philosopher {
  var my_id     = 0;
  var f_low     = nil;
  var f_high    = nil;
  var meals     = 100;
  var meal_idx  = 0;
  var state     = 0;   // 0 = idle, 1 = have_low, 2 = eating-in-progress

  method init(id_arg, lo, hi) {
    my_id    = id_arg;
    f_low    = lo;
    f_high   = hi;
    meals    = 100;
    meal_idx = 0;
    state    = 0;
    send self.try_eat();
  }

  method try_eat() {
    if (meals == 0) {
      print(70000 + my_id);
    } else {
      send f_low.acquire(my_id);
    }
  }

  method fork_granted(pid) {
    if (state == 0) {
      state = 1;
      send f_high.acquire(my_id);
    } else {
      // state == 1 -> we already had low; this grant is for high.
      // Marker range: 60000 + 100*pid + meal_idx
      //   P4 (my_id=4) : 60400..60419 (20 meals)
      //   P5 (my_id=5) : 60500..60519 (20 meals)
      print(60000 + 100 * my_id + meal_idx);
      meal_idx = meal_idx + 1;
      meals    = meals    - 1;
      send f_high.release(my_id);
      send f_low.release(my_id);
      state = 0;
      send self.try_eat();
    }
  }

  method fork_denied(pid) {
    if (state == 1) {
      // got low but couldn't get high — release low, retry.
      send f_low.release(my_id);
      state = 0;
    }
    // Real backoff: AIPL wait(ms) (mangled to b_wait → Xinu kernel
    // sleep(ms)).  Without this, fork_denied → try_eat → acquire
    // → fork_denied loops at native dispatch speed (~800K msg/sec)
    // when a PC philosopher holds a contested fork, overflowing
    // the kernel mailbox and rebooting Xinu.  20 ms is well below
    // the PC eat-cycle (~150 ms) yet long enough to avoid runaway.
    wait(20);
    send self.try_eat();
  }
}

// NOTE: no top-level `new` here — the actor table starts empty.
// The host PC will send the SPAWN RPC commands at runtime to
// instantiate exactly the same topology as the static version:
//
//    SPAWN Fork                  → actor 0 = F0
//    SPAWN Fork                  → actor 1 = F1
//    SPAWN Fork                  → actor 2 = F2
//    SPAWN Fork                  → actor 3 = F3
//    SPAWN Fork                  → actor 4 = F4
//    SPAWN Philosopher 4 2 3     → actor 5 = P4 (my_id=4, lo=F2, hi=F3)
//    SPAWN Philosopher 5 3 4     → actor 6 = P5 (my_id=5, lo=F3, hi=F4)
//    SEND  5 try_eat             → kick P4
//    SEND  6 try_eat             → kick P5
