    if (s0 == 0) { t0 = t0 - 1; if (t0 < 1) { s0 = 1; h0 = 0; } }
    if (s0 == 1) {
      h0 = h0 + 1;
      if (s4 < 2) { if (s1 < 2) {
        ok = 1;
        if (s4 == 1) { if (h0 < h4) { ok = 0; } }
        if (s1 == 1) { if (h0 < h1) { ok = 0; } }
        if (ok == 1) { s0 = 2; t0 = 3; }
      } }
    }
    if (s0 == 2) { t0 = t0 - 1; if (t0 < 1) { s0 = 0; t0 = 4; } }
    if (s1 == 0) { t1 = t1 - 1; if (t1 < 1) { s1 = 1; h1 = 0; } }
    if (s1 == 1) {
      h1 = h1 + 1;
      if (s0 < 2) { if (s2 < 2) {
        ok = 1;
        if (s0 == 1) { if (h1 < h0) { ok = 0; } }
        if (s2 == 1) { if (h1 < h2) { ok = 0; } }
        if (ok == 1) { s1 = 2; t1 = 4; }
      } }
    }
    if (s1 == 2) { t1 = t1 - 1; if (t1 < 1) { s1 = 0; t1 = 6; } }
    if (s2 == 0) { t2 = t2 - 1; if (t2 < 1) { s2 = 1; h2 = 0; } }
    if (s2 == 1) {
      h2 = h2 + 1;
