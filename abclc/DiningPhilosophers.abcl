// DiningPhilosophers.abcl — the 5 dining philosophers as a live AIPL actor.
// 5 philosophers (sN: 0=THINK 1=HUNGRY 2=EAT) + 5 forks, simulated each frame
// with a no-adjacent-eaters rule (deadlock-free), drawn with cls()/line/tri so
// it renders in the browser AND compiles to a portable .avm.  Generated by
// abclc/gen_philosophers.mjs.  Colours: blue=think amber=hungry green=eat.
class Diners {
  // field 0 must be a MONOTONIC frame counter: the Xinu VM treats field 0 as a
  // turntable frame index and, if it ever decreases, switches to replaying a few
  // cached frames (=flicker).  A never-wrapping counter keeps it in LIVE mode.
  var fctr = 0;
  var s0 = 0; var s1 = 0; var s2 = 0; var s3 = 0; var s4 = 0;   // state 0=think 1=hungry 2=eat
  var t0 = 2; var t1 = 4; var t2 = 6; var t3 = 3; var t4 = 8;   // think/eat timers (staggered)
  var h0 = 0; var h1 = 0; var h2 = 0; var h3 = 0; var h4 = 0;   // hunger age (frames spent hungry)
  var ok = 0;
