      h4 = h4 + 1;
      if (s3 < 2) { if (s0 < 2) {
        ok = 1;
        if (s3 == 1) { if (h4 < h3) { ok = 0; } }
        if (s0 == 1) { if (h4 < h0) { ok = 0; } }
        if (ok == 1) { s4 = 2; t4 = 4; }
      } }
    }
