        ok = 1;
        if (s1 == 1) { if (h2 < h1) { ok = 0; } }
        if (s3 == 1) { if (h2 < h3) { ok = 0; } }
        if (ok == 1) { s2 = 2; t2 = 3; }
      } }
    }
    if (s2 == 2) { t2 = t2 - 1; if (t2 < 1) { s2 = 0; t2 = 5; } }
    if (s3 == 0) { t3 = t3 - 1; if (t3 < 1) { s3 = 1; h3 = 0; } }
    if (s3 == 1) {
      h3 = h3 + 1;
      if (s2 < 2) { if (s4 < 2) {
        ok = 1;
        if (s2 == 1) { if (h3 < h2) { ok = 0; } }
        if (s4 == 1) { if (h3 < h4) { ok = 0; } }
        if (ok == 1) { s3 = 2; t3 = 5; }
      } }
    }
