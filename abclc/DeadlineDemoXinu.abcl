// DeadlineDemoXinu.abcl
// S3 DeadlineHints demo — kernel evolution Round 1.
//
// Two actors run side-by-side:
//   Hoarder (priority high)  — busy-loop, prints `81000+i` 30 times.
//                              Without S3 this would keep the CPU.
//   Urgent  (priority low)   — a single `run()` that prints `90042`.
//                              By itself it would be starved while
//                              Hoarder spins.
//
// S3 setup: BEFORE we kick Hoarder off, mark Urgent's next dispatch
// with a 50ms deadline.  The kernel's resched picks Urgent ahead of
// the priority-high Hoarder, so `90042` lands EARLY in the trace —
// before Hoarder has finished its 30 spin steps.
//
// Smoke expectations (the run inside QEMU emits both digests to UART0):
//   * `90042` appears at least once.
//   * Among the lines emitted up to the first `90042` there are
//     STRICTLY FEWER than 30 Hoarder steps (`81001..81030`).  That
//     proves Urgent jumped the queue — without S3 it would land at
//     or after `81030`.

class Hoarder priority(high) {
  var i = 0;

  method spin() {
    i = i + 1;
    print(81000 + i);
    if (i < 30) {
      send self.spin();
    } else {
      print(82000);     // marker: Hoarder finished
    }
  }
}

class Urgent priority(low) {
  method run() {
    print(90042);       // marker: Urgent ran
  }
}

var h = new Hoarder();
var u = new Urgent();

// Mark Urgent's next dispatch as urgent — 5000ms deadline so it
// survives Xinu's ~hundreds-of-ms boot banner + WM init time.
// (At 50ms the deadline was sometimes already past by the time
// resched first ran, and S3 quietly ignores missed deadlines.)
set_deadline(u, 5000);

// Now wake both actors.  Hoarder is high-prio so without S3 it
// would normally dominate; Urgent's deadline overrides.
send h.spin();
send u.run();
