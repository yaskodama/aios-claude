// TextDrawXinu.aipl
// G2 demo: bitmap font text rendering on PL110.
//
// Painter exercises every G2 surface:
//   * fb_text(x,y,str,color24)         — multi-char string
//   * fb_char(x,y,ASCII int,color24)   — single char from int
//   * fb_text_size(str)                — measured width in pixels
//
// _smoke_g2.sh expects, on serial:
//   (1) fb_text marker with the original 24-bit color in color=…
//   (2) fb_char marker with ch=0x?? for at least one ASCII code
//   (3) fb_text_size returns chars * 16

class Painter {
  var red    = 0;
  var green  = 0;
  var white  = 0;
  var width1 = 0;
  var width2 = 0;

  method init() {
    // 0xFF0000 / 0x00FF00 / 0xFFFFFF
    red   = 16711680;
    green = 65280;
    white = 16777215;

    // (1) string at (16, 16) in red
    fb_text(16, 16, "AIPL on Xinu", red);

    // (1') second string at (16, 40) in green — verifies font runs and
    // colour pass-through for non-primary RGB channel.
    fb_text(16, 40, "G2 bitmap text", green);

    // (2) single char 'X' (0x58) at (200, 64) in white — exercises
    // the fb_char ASCII-int path.
    fb_char(200, 64, 88, white);

    // (3) report measured widths so the smoke can verify the formula
    // (width = len * 16).
    width1 = fb_text_size("AIPL on Xinu");      // 12 chars -> 192
    width2 = fb_text_size("G2 bitmap text");    // 14 chars -> 224
    print(width1);
    print(width2);
  }
}

var p = new Painter();
