// SEND + user-defined reply method — Erlang-actor-OOP style.
//
// This mirrors `src/python-aipl/samples-ai/_send_reply_demo/
// send_reply_style.aipl` from the Python (type-inferred) AIPL runtime.
// After commit 590e3aa landed fix (1) (reply-on-send routing), the
// same pattern that worked there works here too — `reply(r)` on the
// send path now delivers a synthetic `reply(r)` message back to the
// sender's mailbox, which the sender's actor loop dispatches through
// a normal user-defined `reply` method.  No `select` block needed.
//
// Two equivalent shapes for the same receive semantics in OCaml AIPL:
//
//   (a) `select { case reply(r) -> { ... } }`   (explicit, OCaml-only)
//   (b) `method reply(r) { ... }`                (this file — both runtimes)
//
// Run:
//   ABCL_AI_PROVIDER=mock dune exec src/repl_thread.exe -- \
//     -f abclc/ai-samples/run_send_reply_method.bat

class Worker {
  method ask(q) {
    var r = ai_call(q);
    reply(r);
  }
}

class Driver {
  // Plain method — the actor loop dispatches `reply(r)` to it when
  // Worker's reply-on-send routes the value back into Driver's mailbox.
  method reply(r) {
    print("[reply-method] got: " + r);
  }
  method run(q) {
    var w = new Worker();
    send w.ask(q);
  }
}

var d = new Driver();
send d.run("hello via send-reply-method");
