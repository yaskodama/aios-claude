// Integration / sample 1 — routing + structured_log together.
//
// Two everyday-observability features active simultaneously.  Each
// actor's spawn carries the route, and every event in the log is
// timestamped + queryable.  Nothing in the .aipl source references
// aipl_dist — all integration is via env vars + runtime hooks.
//
// Run:
//   AIPL_DIST_ENABLE=1 \
//   AIPL_ROUTE="Worker:fast,Reporter:slow" \
//   AIPL_DIST_LOG_FILE=/tmp/int1.ndjson \
//   dune exec src/repl_thread.exe -- -f run.bat
//
//   jq -r 'select(.event=="spawn") | .actor_class + " -> " + (.route // "-")' \
//      /tmp/int1.ndjson

class Worker {
  method run() { print("working"); }
}
class Reporter {
  method tick() { print("reporting"); }
}

var w = new Worker();
var r = new Reporter();
send w.run();
send r.tick();
