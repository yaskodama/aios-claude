// DR-2 / sample 1 — structured_log basic.
//
// Demonstrates that just enabling AIPL_DIST_LOG_FILE turns every
// spawn + method-call into an NDJSON event with `ts_ns`,
// `actor_id`, `actor_class`, `event`, plus event-specific keys.
// The .aipl source itself contains no aipl_dist references — all
// integration is via runtime hooks in eval_thread.ml.
//
// Run:
//   AIPL_DIST_ENABLE=1 AIPL_DIST_LOG_FILE=/tmp/log1.ndjson \
//   dune exec src/repl_thread.exe -- -f run.bat
//
// Expected: /tmp/log1.ndjson with N lines, one per spawn / send.
// Each line: valid JSON with monotonically-increasing ts_ns.

class Hello {
  method speak() { print("hello"); }
}
class World {
  method speak() { print("world"); }
}

var h = new Hello();
var w = new World();
send h.speak();
send w.speak();
