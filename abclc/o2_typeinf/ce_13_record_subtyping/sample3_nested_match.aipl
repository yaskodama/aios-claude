// CE-13 / sample 3 — width subtyping composes with depth subtyping
// (the per-field unify of common fields is still strict).
//
// Run:
//   _build/default/src/repl_thread.exe --check \
//     abclc/o2_typeinf/ce_13_record_subtyping/sample3_nested_match.aipl
//
// Expected: `[type] no issues.` — `inner` has a matching shape; the
// outer record's extra `tag` field is ignored.

class Outer {
  method read(r: record{inner: record{key: string, value: int}}) -> int {
    return r.inner.value;
  }
}

var o = new Outer();
var rec = {inner: {key: "k1", value: 42, debug: "x"}, tag: "ignored"};
var v = now o.read(rec) timeout 5000 else 0;
print(v);
