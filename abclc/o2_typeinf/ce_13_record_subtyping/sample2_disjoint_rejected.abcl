// CE-13 / sample 2 — wholly-disjoint records still rejected.
//
// Run:
//   _build/default/src/repl_thread.exe --check \
//     abclc/o2_typeinf/ce_13_record_subtyping/sample2_disjoint_rejected.abcl
//
// Expected: `[type] record fields disjoint: [name] vs [label]`.
// Width subtyping permits *extra* fields; it doesn't relax the
// requirement that the expected fields actually appear.

class Greeter {
  method greet(p: {name: string}) -> string { return "Hi, " + p.name; }
}

var g = new Greeter();
var x = {label: "abc"};
var s = now g.greet(x);
print(s);
