// CE-4 / O-2.d: actor field shared across methods.
//
// `Counter` has a single field `n` that init() writes from `initial`,
// bump() reads-modifies-writes, and peek() reads.  The class-local
// env hands every method the same scheme for `n` so HM unifies
// every usage into one type (Int here).  An inconsistent use (e.g.
// writing a string to `n`) would surface as a Type_error during
// Typecheck.run.

class Counter {
  var n = 0;
  method init(initial: int) { n = initial; }
  method bump(delta: int) -> int {
    n = n + delta;
    return n;
  }
  method peek() -> int { return n; }
}

var c = new Counter(0);
var v1: int = now c.bump(7);
var v2: int = now c.bump(3);
var p: int = now c.peek();
print(v1); print(v2); print(p);
