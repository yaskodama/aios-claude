// CE-16 V1 / sample 1 — row-polymorphic record (OCaml).
//
// Two methods read disjoint single fields on `p`.  Under CE-13
// width subtyping each access only constrained `p` to a single
// closed shape.  Under CE-16 V1 (AIPL_ROWPOLY=1) each access
// adds a constraint with a fresh row variable, so `p`'s inferred
// shape accumulates `{name: string, id: string | ρ}` and a caller
// record with extra fields {email} unifies cleanly via the tail.
//
// Verify with:
//   AIPL_ROWPOLY=1 _build/default/src/aipl2c.exe \
//     abclc/o2_typeinf/ce_16_rowpoly/sample1_basic_rowvar.aipl --check

class Greeter {
  method greet(p) -> string {
    return "Hello, " + p.name;
  }
  method label(p) -> string {
    return "id=" + p.id;
  }
}

var g = new Greeter();
var u = {name: "Alice", id: "u-001", email: "alice@example.com"};
var hi  = now g.greet(u);
var aud = now g.label(u);
print(hi);
print(aud);
