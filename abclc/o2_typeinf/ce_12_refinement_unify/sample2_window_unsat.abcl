// CE-12 / sample 2 — refinement window that is unsatisfiable on Int.
//
// Run:
//   AIPL_REFINE_CHECK=1 \
//   _build/default/src/repl_thread.exe --check \
//     abclc/o2_typeinf/ce_12_refinement_unify/sample2_window_unsat.abcl
//
// Expected on stderr: `[refine warning] vacuously-false refinement: int where x > 5 and x < 5`

class C {
  method narrow(p: int where x > 5 and x < 5) -> int { return p; }
}
