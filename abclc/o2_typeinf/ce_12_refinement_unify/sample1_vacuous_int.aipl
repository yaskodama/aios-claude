// CE-12 / sample 1 — vacuously-false Int refinement (declaration-time
// Z3 check). The OCaml unify-side early-flag hook for refinement
// subset is deferred; what runs today is the declaration-time check
// already shipped in Phase O-2.b that uses the same Z3 backend that
// `Refinement.check_subset` now reuses for the CE-12 API.
//
// Run:
//   AIPL_REFINE_CHECK=1 \
//   _build/default/src/repl_thread.exe --check \
//     abclc/o2_typeinf/ce_12_refinement_unify/sample1_vacuous_int.aipl
//
// Expected on stderr: `[refine warning] vacuously-false refinement: int where x > x`

class C {
  method bad(p: int where x > x) -> int { return p; }
}
