class Line {
  var angle = 0.;
  var cx = 320.;
  var cy = 240.;
  var length = 100.;

  method spin() {
    call sdl_clear();
    var x1 = cx + length * cos(angle);
    var y1 = cy + length * sin(angle);
    var x2 = cx - length * cos(angle);
    var y2 = cy - length * sin(angle);
    call sdl_line(x1, y1, x2, y2);
    call sdl_present();
    angle = angle + 0.1;
    send self.spin();
  }
}



