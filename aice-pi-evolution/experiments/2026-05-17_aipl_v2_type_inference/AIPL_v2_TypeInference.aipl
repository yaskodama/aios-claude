}

// --------------------------------------------------------------------
// DigitOps — peer actor for parse_score so Util can avoid self-call.
// --------------------------------------------------------------------

class DigitOps {
  method val(c) {
    if (c == "0") { reply(0); }
    else if (c == "1") { reply(1); }
    else if (c == "2") { reply(2); }
    else if (c == "3") { reply(3); }
    else if (c == "4") { reply(4); }
    else if (c == "5") { reply(5); }
    else if (c == "6") { reply(6); }
    else if (c == "7") { reply(7); }
    else if (c == "8") { reply(8); }
    else if (c == "9") { reply(9); }
    else { reply(-1); }
  }
}

// --------------------------------------------------------------------
// Worker — compound operations that orchestrate Util/Evaluator/Profiles.
// Lives in its own actor so its callers (e.g. Coordinator) can use `now`
// without re-entering themselves.
// --------------------------------------------------------------------

class Worker {
  var util = 0;
  var evaluator = 0;
  var profiles = 0;

  method init(u, e, p) {
    util = u;
    evaluator = e;
    profiles = p;
  }

  method compute_cell(genome, cell_axes_csv) {
    var n = now util.count_csv(cell_axes_csv) timeout 5000 else 0;
    var i = 0;
    var out = "";
    while (i < n) do {
      var axis = now util.nth_csv(cell_axes_csv, i) timeout 5000 else 0;
      var v = now util.get_axis(genome, axis) timeout 5000 else "";
      if (i == 0) { out = axis ++ "=" ++ v; }
      else { out = out ++ "|" ++ axis ++ "=" ++ v; }
      i = i + 1;
    }
    reply(out);
  }

  method compute_score(genome, task_csv) {
    var n = now util.count_csv(task_csv) timeout 5000 else 0;
    var i = 0;
    var sum = 0.0;
    while (i < n) do {
      var task = now util.nth_csv(task_csv, i) timeout 5000 else 0;
      var prof = now profiles.get(task) timeout 5000 else "";
      var s = now evaluator.score_for_task(genome, prof) timeout 5000 else 0;
      sum = sum + s;
      i = i + 1;
    }
    var avg = sum;
    if (n > 0) { avg = sum / (n + 0.0); }
    reply(avg);
  }
}

// --------------------------------------------------------------------
// Generator — seed / mutate / crossover
// --------------------------------------------------------------------

class Generator {
  var util = 0;
  var axes_csv = "";
  var values_table = "";

  method init(u, axes, values) {
    util = u;
    axes_csv = axes;
    values_table = values;
  }

  // v4 (2026-05-17): seed / mutate / cross now rejection-sample on the
  // schema's coherence rules (via Util.is_coherent).  Up to 50 attempts;
  // on every retry exhausted, the last candidate is returned even if
  // incoherent, so the evolution never deadlocks on infeasible schemas.

  method seed() {
    var tries = 0;
    var g = "";
    var ok = 0;
    while (ok == 0) do {
      var n_axes = now util.count_csv(axes_csv) timeout 5000 else 0;
      var i = 0;
      var cand = "";
      while (i < n_axes) do {
        var axis = now util.nth_csv(axes_csv, i) timeout 5000 else 0;
        var vals = now util.axis_values(values_table, axis) timeout 5000 else "";
        var n_vals = now util.count_csv(vals) timeout 5000 else 0;
        var v = now util.nth_csv(vals, random(n_vals)) timeout 5000 else 0;
        if (i == 0) { cand = axis ++ "=" ++ v; }
        else { cand = cand ++ "|" ++ axis ++ "=" ++ v; }
        i = i + 1;
      }
      g = cand;
      ok = now util.is_coherent(g) timeout 5000 else 0;
      tries = tries + 1;
      if (tries >= 50) { ok = 1; }
    }
    reply(g);
  }

  method mutate(parent) {
    var tries = 0;
    var child = parent;
    var ok = 0;
    while (ok == 0) do {
      var n_axes = now util.count_csv(axes_csv) timeout 5000 else 0;
      var idx = random(n_axes);
      var axis = now util.nth_csv(axes_csv, idx) timeout 5000 else 0;
      var vals = now util.axis_values(values_table, axis) timeout 5000 else "";
      var n_vals = now util.count_csv(vals) timeout 5000 else 0;
      var v = now util.nth_csv(vals, random(n_vals)) timeout 5000 else 0;
      var cand = now util.set_axis(parent, axis, v) timeout 5000 else 0;
      child = cand;
      ok = now util.is_coherent(child) timeout 5000 else 0;
      tries = tries + 1;
      if (tries >= 50) { ok = 1; }
    }
    reply(child);
  }

  method cross(a, b) {
    var tries = 0;
    var child = a;
    var ok = 0;
    while (ok == 0) do {
      var n_axes = now util.count_csv(axes_csv) timeout 5000 else 0;
      var i = 0;
      var cand = "";
      while (i < n_axes) do {
        var axis = now util.nth_csv(axes_csv, i) timeout 5000 else 0;
        var src = a;
        if (random(2) == 1) { src = b; }
        var v = now util.get_axis(src, axis) timeout 5000 else "";
        if (i == 0) { cand = axis ++ "=" ++ v; }
        else { cand = cand ++ "|" ++ axis ++ "=" ++ v; }
        i = i + 1;
      }
      child = cand;
      ok = now util.is_coherent(child) timeout 5000 else 0;
      tries = tries + 1;
      if (tries >= 50) { ok = 1; }
    }
    reply(child);
  }
}

// --------------------------------------------------------------------
// Reviewer — one ai_call_with_system per score request (Phase 6),
//            deterministic scoring (Phase 5).
// --------------------------------------------------------------------

class Reviewer {
  var name = "";
  var persona = "";
  var use_ai = 0;
  var weight = 0.0;
  var util = 0;
  var digits = 0;

  method init(n, p, u, w, util_actor, digits_actor) {
    name = n;
    persona = p;
    use_ai = u;
    weight = w;
    util = util_actor;
    digits = digits_actor;
  }

  method score(genome, task_profile) {
    if (use_ai == 1) {
      var prompt = "評価対象の遺伝子: " ++ genome ++
                   "\n理想プロファイル: " ++ task_profile ++
                   "\n\nこのプロファイルに対する適合度を 0.0 から 1.0 の単一の decimal number で返してください。説明禁止。数値1つだけ。";
      var ai_text = ai_call_with_system(persona, prompt);
      var ai_score = now util.parse_score(ai_text, digits) timeout 5000 else 0;
      reply(ai_score);
    } else {
    // Deterministic: fraction of profile axes the genome matches.
    var matches = 0;
    var total = 0;
    var rest = task_profile;
    while (str_len(rest) > 0) do {
      var bar = str_index(rest, "|");
      var pair = "";
      if (bar < 0) {
        pair = rest;
        rest = "";
      } else {
        pair = str_sub(rest, 0, bar);
        rest = str_sub(rest, bar + 1);
      }
      var eq = str_index(pair, "=");
      if (eq >= 0) {
        var axis = str_sub(pair, 0, eq);
        var want = str_sub(pair, eq + 1);
        var key = axis ++ "=";
        var gidx = str_index(genome, key);
        if (gidx >= 0) {
          var gstart = gidx + str_len(key);
          var grest = str_sub(genome, gstart);
          var gbar = str_index(grest, "|");
          var got = "";
          if (gbar < 0) { got = grest; }
          else { got = str_sub(grest, 0, gbar); }
          if (got == want) { matches = matches + 1; }
        }
        total = total + 1;
      }
    }
    var s = 0.0;
    if (total > 0) { s = (matches + 0.0) / (total + 0.0); }
    reply(s);
    }
  }

  method get_weight() { reply(weight); }
}

// --------------------------------------------------------------------
// Evaluator — fans out reviewer scoring with `future`, awaits, aggregates.
// The class is codegen'd with exactly n_reviewers slots (see
// aipl_codegen.py) so init() arity matches the bootstrap call for any N.
// --------------------------------------------------------------------

class Evaluator {
  var r1 = 0;
  var r2 = 0;
  var r3 = 0;
  var r4 = 0;
  var r5 = 0;
  var r6 = 0;

  method init(rev1, rev2, rev3, rev4, rev5, rev6) {
    r1 = rev1;
    r2 = rev2;
    r3 = rev3;
    r4 = rev4;
    r5 = rev5;
    r6 = rev6;
  }

  method score_for_task(genome, profile) {
    var f1 = future r1.score(genome, profile);
    var f2 = future r2.score(genome, profile);
    var f3 = future r3.score(genome, profile);
    var f4 = future r4.score(genome, profile);
    var f5 = future r5.score(genome, profile);
    var f6 = future r6.score(genome, profile);
    var s1 = await(f1) timeout 5000 else 0;
    var w1 = now r1.get_weight() timeout 5000 else 0;
    var s2 = await(f2) timeout 5000 else 0;
    var w2 = now r2.get_weight() timeout 5000 else 0;
    var s3 = await(f3) timeout 5000 else 0;
    var w3 = now r3.get_weight() timeout 5000 else 0;
    var s4 = await(f4) timeout 5000 else 0;
    var w4 = now r4.get_weight() timeout 5000 else 0;
    var s5 = await(f5) timeout 5000 else 0;
    var w5 = now r5.get_weight() timeout 5000 else 0;
    var s6 = await(f6) timeout 5000 else 0;
    var w6 = now r6.get_weight() timeout 5000 else 0;
    // v4 hard-floor: if reviewer 6 ('R6_RealWorldPrecedent') returned 0.0, overall fitness = 0.0.
    if (s6 == 0.0) { reply(0.0); }
    else {
      var combined = s1 * w1 + s2 * w2 + s3 * w3 + s4 * w4 + s5 * w5 + s6 * w6;
      reply(combined);
    }
  }
}

// --------------------------------------------------------------------
// EliteMap — cell -> champion id mapping with parallel arrays
// --------------------------------------------------------------------

class EliteMap {
  var cells = [];
  var ids = [];
  var scores = [];
  var genomes = [];

  method propose(cell, ind_id, genome, score) {
    var n = array_len(cells);
    var i = 0;
    var idx = -1;
    while (i < n) do {
      if (array_get(cells, i) == cell) {
        idx = i;
        i = n;
      } else {
        i = i + 1;
      }
    }
    if (idx < 0) {
      array_push(cells, cell);
      array_push(ids, ind_id);
      array_push(scores, score);
      array_push(genomes, genome);
      reply(1);
    } else {
      var existing = array_get(scores, idx);
      if (score > existing) {
        array_set(ids, idx, ind_id);
        array_set(scores, idx, score);
        array_set(genomes, idx, genome);
        reply(1);
      } else {
        reply(0);
      }
    }
  }

  method size() { reply(array_len(cells)); }

  method sample_random_genome() {
    var n = array_len(cells);
    if (n == 0) { reply(""); }
    else { reply(array_get(genomes, random(n))); }
  }

  method best_summary(top_k) {
    var n = array_len(cells);
    var i = 0;
    var out = "";
    while (i < n) do {
      var line = "  cell=" ++ array_get(cells, i) ++
                 "  score=" ++ array_get(scores, i) ++
                 "  id=" ++ array_get(ids, i);
      if (i == 0) { out = line; }
      else { out = out ++ "\n" ++ line; }
      i = i + 1;
    }
    reply(out);
  }
}

// --------------------------------------------------------------------
// Lineage — append-only individual record
// --------------------------------------------------------------------

class Lineage {
  var ids = [];
  var genomes = [];
  var parents = [];
  var scores = [];
  var generations = [];
  var operators = [];
  var cells = [];

  method add(id, genome, parent, score, gen, op, cell) {
    array_push(ids, id);
    array_push(genomes, genome);
    array_push(parents, parent);
    array_push(scores, score);
    array_push(generations, gen);
    array_push(operators, op);
    array_push(cells, cell);
    reply(array_len(ids));
  }

  method dump(path) {
    var n = array_len(ids);
    var i = 0;
    var out = "[\n";
    while (i < n) do {
      // score gets a trailing "0" so 0.0 stringifies to "0.00"
      // (Python runtime emits "0." which would be invalid JSON).
      var entry = "  {\"id\":\"" ++ array_get(ids, i) ++ "\"," ++
                  "\"genome\":\"" ++ array_get(genomes, i) ++ "\"," ++
                  "\"parent\":\"" ++ array_get(parents, i) ++ "\"," ++
                  "\"score\":" ++ array_get(scores, i) ++ "0," ++
                  "\"generation\":" ++ array_get(generations, i) ++ "," ++
                  "\"operator\":\"" ++ array_get(operators, i) ++ "\"," ++
                  "\"cell\":\"" ++ array_get(cells, i) ++ "\"}";
      if (i < n - 1) { out = out ++ entry ++ ",\n"; }
      else { out = out ++ entry ++ "\n"; }
      i = i + 1;
    }
    out = out ++ "]\n";
    write_file(path, out);
    reply(n);
  }
}

// --------------------------------------------------------------------
// TaskProfiles — embedded per-task ideal genome fragments
// --------------------------------------------------------------------

class TaskProfiles {
  // task profiles inlined into get(); no separate methods.

  method get(task_name) {
    if (task_name == "InferPsiLang2Chudnovsky") { reply(""); }
    else if (task_name == "InferPiPhase1Aipl") { reply(""); }
    else if (task_name == "BackwardCompatExisting") { reply(""); }
    else if (task_name == "ErrorMsgQuality") { reply(""); }
    else if (task_name == "ImplCostOnTypeck") { reply(""); }
    else { reply(""); }
  }
}

// --------------------------------------------------------------------
// Coordinator — main loop
// --------------------------------------------------------------------

class Coordinator {
  var util = 0;
  var generator = 0;
  var evaluator = 0;
  var elite = 0;
  var lineage = 0;
  var profiles = 0;
  var worker = 0;

  var seed_count = 8;
  var generations = 30;
  var cell_axes_csv = "inference_algorithm,inference_scope,type_system_strength,subtyping,annotation_requirement,implementation_strategy";
  var task_csv = "InferPsiLang2Chudnovsky,InferPiPhase1Aipl,BackwardCompatExisting,ErrorMsgQuality,ImplCostOnTypeck";
  var next_id = 0;

  method init(u, g, e, em, lg, tp, w) {
    util = u;
    generator = g;
    evaluator = e;
    elite = em;
    lineage = lg;
    profiles = tp;
    worker = w;
  }

  method run() {
    print("=== AIPL_v2_TypeInference (AIPL — Actor-based Intelligent Parallel Language — orchestrator) ===");
    print("seed_count=" ++ seed_count ++ "  generations=" ++ generations);

    // Phase 1: seed
    var i = 0;
    while (i < seed_count) do {
      var g = now generator.seed() timeout 5000 else 0;
      next_id = next_id + 1;
      var id = "I" ++ next_id;
      var cell = now worker.compute_cell(g, cell_axes_csv) timeout 5000 else 0;
      var score = now worker.compute_score(g, task_csv) timeout 5000 else 0;
      send lineage.add(id, g, "", score, 0, "seed", cell);
      send elite.propose(cell, id, g, score);
      i = i + 1;
    }
    print("[seed] elite cells filled: " ++ (now elite.size() timeout 5000 else 0));

    // Phase 2: evolution
    var gen = 1;
    while (gen <= generations) do {
      var parent = now elite.sample_random_genome() timeout 5000 else "";
      var size = now elite.size() timeout 5000 else 0;
      var do_cross = 0;
      if (random(10) < 3) {
        if (size >= 2) { do_cross = 1; }
      }
      var child = "";
      var op = "";
      if (do_cross == 1) {
        var partner = now elite.sample_random_genome() timeout 5000 else "";
        child = now generator.cross(parent, partner) timeout 5000 else 0;
        op = "uniform_crossover";
      } else {
        child = now generator.mutate(parent) timeout 5000 else 0;
        op = "axis_resample";
      }
      next_id = next_id + 1;
      var cid = "I" ++ next_id;
      var ccell = now worker.compute_cell(child, cell_axes_csv) timeout 5000 else 0;
      var cscore = now worker.compute_score(child, task_csv) timeout 5000 else 0;
      send lineage.add(cid, child, "", cscore, gen, op, ccell);
      send elite.propose(ccell, cid, child, cscore);
      // crash-recovery: flush lineage every generation so silent SDK
      // hangs (cf. Pi_Phase1_OpenSearch v3 attempt 2026-05-16) do not
      // lose the partial result.  Cost: one fs write per generation.
      var ckpt_n = now lineage.dump("out/AIPL_v2_TypeInference.aipl_lineage.json") timeout 5000 else 0;
      print("[ckpt gen=" ++ gen ++ "] flushed " ++ ckpt_n ++ " individuals");
      gen = gen + 1;
    }

    print("[done] cells filled: " ++ (now elite.size() timeout 5000 else 0));
    print(now elite.best_summary(5) timeout 5000 else 0);

    var n = now lineage.dump("out/AIPL_v2_TypeInference.aipl_lineage.json") timeout 5000 else 0;
    print("[lineage] wrote " ++ n ++ " individuals to out/AIPL_v2_TypeInference.aipl_lineage.json");
  }
}

// --------------------------------------------------------------------
// Bootstrap (top-level)
// --------------------------------------------------------------------

var util = new Util();
var digits = new DigitOps();
var generator = new Generator(util, "inference_algorithm,inference_scope,type_system_strength,generics_model,subtyping,annotation_requirement,default_inference_target,error_recovery,error_message_style,effect_system,recursive_types,implementation_strategy", "inference_algorithm:no_inference,local_only,hindley_milner,bidirectional,constraint_based_global|inference_scope:function_local,module_local,whole_program,incremental_per_method|type_system_strength:dynamic_only,static_simple,hindley_milner,bidirectional_w_refinement,dependent|generics_model:monomorphic_only,parametric,ad_hoc_polymorphism,higher_kinded,bounded_quantification|subtyping:none,nominal,structural,row_polymorphism,gradual|annotation_requirement:none_inferred,optional_with_fallback_dyn,optional_strict,mandatory_for_public,mandatory_for_all|default_inference_target:any_aka_dyn,never_type,error_node_for_recovery,union_of_candidates,principal_type_from_use|error_recovery:stop_on_first,collect_all_continue,suggestion_with_did_you_mean,interactive_repair,unification_trace|error_message_style:terse_one_line,elm_style_with_pointer,rust_style_with_help,ocaml_style_with_path,prose_with_examples|effect_system:none,monadic_io,algebraic_effects,capability_based,linear_resources|recursive_types:none,simple_rec,iso_recursive,equi_recursive_with_mu|implementation_strategy:extend_aipl_typeck_inline,new_aipl_inference_module,rewrite_typeck_full,external_z3_smt,external_zarith_solver");
var elite = new EliteMap();
var lineage = new Lineage();
var profiles = new TaskProfiles();

var rev1 = new Reviewer("R1_InferenceCoverage", "あなたは R1 (推論カバレッジ) を判定するレビュアーです。候補の inference_algorithm, inference_scope, type_system_strength を見て、注釈なしの式のうち何%に型を付けられるかを判定。1.0 = ≥90% (Hindley-Milner レベル)、0.7 = 60-90%、0.3 = 30-60%、0.0 = no_inference。半角数字 1 つで。", 1, 0.25, util, digits);
var rev2 = new Reviewer("R2_PsiLang2Recovery", "あなたは R2 (PsiLang2 推論可能性) を判定するレビュアーです。候補が PsiLang2 chudnovsky.psi の `let sign = if k mod 2 == 0 then 1 else -1 in ...` のような条件分岐を含む式から `sign: Int` を推論できるかを判定。candidate の inference_algorithm, subtyping, default_inference_target を主に見る。1.0 = 余裕、0.7 = 大半、0.3 = 一部のみ、0.0 = 全く。半角数字 1 つで。", 1, 0.2, util, digits);
var rev3 = new Reviewer("R3_BackwardCompat", "あなたは R3 (後方互換) を判定するレビュアーです。candidate の annotation_requirement, default_inference_target, error_recovery を見て、既存 4 つの Pi_Phase*.aipl が注釈なしのまま型検査を通るかを判定。1.0 = optional_with_fallback_dyn 等で 100% 通る、0.7 = 1-2 警告、0.3 = 半分要 annotation、0.0 = 大破壊。半角数字 1 つで。", 1, 0.15, util, digits);
var rev4 = new Reviewer("R4_ImplementabilityTypeck", "あなたは R4 (実装可能性) を判定するレビュアーです。candidate の inference_algorithm, implementation_strategy, generics_model, recursive_types を見て、aipl_typeck.py (現 877 行) + 新コードの拡張行数を判定。1.0 = +500 行 (Algorithm W シンプル版)、0.7 = +1000 行、0.3 = +2000 行、0.0 = +2500 行超 or external solver 必須。半角数字 1 つで。", 1, 0.15, util, digits);
var rev5 = new Reviewer("R5_ErrorMessageQuality", "あなたは R5 (エラー品質) を判定するレビュアーです。candidate の error_message_style, error_recovery が、初心者にも分かりやすい型エラーを出すかを判定。1.0 = Elm/Rust 風親切メッセージ、0.7 = OCaml 風 (パス + 期待型)、0.3 = 1 行短い、0.0 = 'type error' のみ。半角数字 1 つで。", 1, 0.1, util, digits);
var rev6 = new Reviewer("R6_RealWorldPrecedent", "あなたは R6 (現実先例) を判定するレビュアーです。候補が現実に存在する Python ホストの型システムにどれだけ近いかを判定する。先例: (1) mypy = gradual typing + structural + parametric + bidirectional, (2) Pyre = gradual + flow-sensitive, (3) Pyright = bidirectional + strict mode, (4) pytype = whole-program inference + Google scale, (5) OCaml typer = HM + nominal + collect_all, (6) Hindley-Damas-Milner = pure HM, (7) TypeScript = structural + union types。スコア: 5 軸以上一致 → 1.0、3-4 軸 → 0.5、2 軸以下 → 0.0 (hard floor で fitness=0)。半角数字 1 つで。", 1, 0.15, util, digits);
var eval_actor = new Evaluator(rev1, rev2, rev3, rev4, rev5, rev6);
var worker = new Worker(util, eval_actor, profiles);
var coord = new Coordinator(util, generator, eval_actor, elite, lineage, profiles, worker);
send coord.run();
