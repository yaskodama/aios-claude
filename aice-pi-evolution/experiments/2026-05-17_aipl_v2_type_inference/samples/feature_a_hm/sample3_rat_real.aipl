// Feature A (HM inference) — Sample 3: Float arithmetic.
// Demonstrates HM inference flowing through Float-only operations
// plus the `sqrt` and `abs` builtins (both registered in
// aipl_interp).  The program type-infers cleanly AND runs at the
// same time, producing visible output.

class Numerics {
  method circle_area(radius) {
    var pi  = 3.14159265358979;
    var r2  = radius * radius;
    reply(pi * r2);
  }
  method hypotenuse(a, b) {
    var sq = a * a + b * b;
    reply(sqrt(sq));
  }
  method scale_by(x, factor) {
    reply(x * factor);
  }
  method abs_diff(x, y) {
    reply(abs(x - y));
  }
}

var n  = new Numerics();
var a  = now n.circle_area(2.0);
var h  = now n.hypotenuse(3.0, 4.0);
var s  = now n.scale_by(10.0, 0.5);
var d  = now n.abs_diff(7.5, 3.0);
println("area=", a, " hyp=", h, " scale=", s, " absdiff=", d);
