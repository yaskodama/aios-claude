// @expect reject: フィールドの型が衝突する例。拒否されるのが正しい
// Feature D (Phase E-β) — Sample 3: cross-method type conflict.
//
// The field `s` is consistently used as an Int through the
// initializer and asInt()/asBool().  Then writeBool() tries to write
// a Bool into it — the inference engine flags a unify failure at
// `assign to s` (Int vs Bool).  This is the kind of bug that was
// completely invisible before Phase E-β.

class Mixed {
  var s = 0;
  method asInt(x: int)      { s = x; }
  method asBool()           { reply(s == 0); }       // OK: read Int, returns Bool
  method writeBool(b: bool) { s = b; }               // BAD: int field <- Bool
}

var m = new Mixed();
