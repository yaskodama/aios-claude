// Feature F (Phase E-γ-R: Real/Rat refinement) — Sample 1.
// All predicates are satisfiable over the reals.  No issues should
// be reported by the Z3 backend, because the inference engine now
// translates `Real where ...` annotations through Z3's Real theory
// (previously they fell through as "non-Int refinement deferred").

class Reals {
  method unit_open(x: Real where x > 0.0 and x < 1.0) -> Real {
    reply(x);
  }
  method nonneg(y: Real where y >= 0.0) -> Real {
    reply(y);
  }
  method positive_below(z: Real where 0.0 < z and z < 100.0) -> Real {
    reply(z);
  }
  method offset_window(w: Real where w > a and w < a + 1.0) -> Real {
    reply(w);
  }
  method monotone(p: Real where p == 2.0 * q + 1.0) -> Real {
    reply(p);
  }
}

var r = new Reals();
