// Feature C (refinement types) — Sample 2: unsatisfiable predicates.
// The Z3 backend should flag every method below — no Int can make
// these predicates true, so the refinement is *vacuously false*.
// Each declaration produces one `refinement issue`.

class Unsat {
  method bad_range(k: int where k >= 5 and k <= 3) -> int {
    reply(k);
  }
  method bad_sign(x: int where x > 0 and x < 0) -> int {
    reply(x);
  }
  method bad_century(n: int where n >= 100 and n <= 10) -> int {
    reply(n);
  }
  method bad_dual(k: int where k == 1 and k == 2) -> int {
    reply(k);
  }
}

var u = new Unsat();
