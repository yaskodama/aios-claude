// Feature C (refinement types) — Sample 3: mixed-shape predicates.
// Exercises every refinement grammar feature (Phase E-α):
//   - chained-style conjunctions  (a >= 0 and a <= 100)
//   - `not`                       (not (b == 0))
//   - disjunction with parens     ((c == 0) or (c > 5 and c < 10))
//   - linear arithmetic           (2 * d + 1 == 7)
//   - mixed satisfiable+unsat in one class

class Mixed {
  method range_pred(a: int where 0 <= a and a <= 100) -> int {
    reply(a);
  }
  method nonzero(b: int where not (b == 0)) -> int {
    reply(b);
  }
  method holed(c: int where (c == 0) or (c > 5 and c < 10)) -> int {
    reply(c);
  }
  method solves_for_three(d: int where 2 * d + 1 == 7) -> int {
    reply(d);
  }
  // The next two are UNSAT and will produce refinement issues.
  method shadow_unsat(x: int where (x > 10) and not (x > 5)) -> int {
    reply(x);
  }
  method arith_unsat(y: int where y + 1 == y) -> int {
    reply(y);
  }
}

var m = new Mixed();
var v1 = now m.range_pred(50) timeout 5000 else 0;
var v2 = now m.nonzero(7) timeout 5000 else 0;
var v3 = now m.holed(8) timeout 5000 else 0;
var v4 = now m.solves_for_three(3) timeout 5000 else 0;
