// Feature G (Phase E-2) — Sample 2: typeck passes clean, inference catches.
// No `: type` annotations and no builtin misuses, so the typeck
// gradual checker has nothing to report.  But the HM inference
// + Phase E-α refinements + Phase E-β actor fields detect deeper
// problems:
//   - `bumped` is Int (init's `n = initial` + reply path) and the
//     `where k >= 5 and k <= 3` refinement on `narrow` is UNSAT.

class Counter {
  var n = 0;
  method init(initial)  { n = initial; }
  method bump(delta)    { n = n + delta; reply(n); }
  method narrow(k: int where k >= 5 and k <= 3) -> int { reply(k); }
}

var c   = new Counter(100);
var v   = now c.bump(7) timeout 5000 else 0;
var bad = now c.narrow(4) timeout 5000 else 0;
