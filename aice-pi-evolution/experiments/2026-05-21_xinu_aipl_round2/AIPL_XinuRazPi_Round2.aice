// AIPL_XinuRazPi_Round2.aice  (2026-05-21)
//
// AIPL を Embedded Xinu (arm-qemu / 実 Raspberry Pi) 上で進化させる
// 2 回目のラウンド.Round 1 (AIPL_XinuRazPi_Round1.aice) で
//   R0/R1, P1-P4, F1-F4, G1-G3/G5, N1 部分, R_BackwardCompat
// を達成し、その後の追加トラックとして
//   - LOAD/COMPILE/RUN 動的 compile pipeline (in-kernel abclc + cc + aoutRun)
//   - pure-AIPL host orchestrator (host_diners_dynamic.aipl)
//   - WM Console + 2nd shell window (WMCON0 + 60×16 cell grid + VT100-lite)
//   - readline + history (Ctrl-P/N + 矢印 + ESC sequence + 32 entry 循環)
//   - WM halt 共通化 (SYS_EXIT で QEMU + Cocoa クリーン終了)
//   - in-Xinu memfs (XFS on RAMDISK0) + shell utilities (ls/pwd/cd/mkdir/cat/cp)
//   - in-Xinu make (cwd の .c/.abcl から Makefile 自動生成 + cc/abclc + run)
// が揃った.Round 2 はこれらを Round 1 で出ていなかった 3 方向で
// 活用しつつ進化させる:
//
//   D (In-Xinu Developer Experience) — REPL / editor / hot-reload /
//       debugger / 共有 module を memfs + abclc + AIPL の上に立ち上げ、
//       「Xinu の中で AIPL を書いて動かして直す」サイクルを完成
//   C (Multi-Pi Cluster) — Round 1 で deferred になっていた N3 を
//       完成、pure-AIPL host orchestrator を peer 相互運用に拡張、
//       actor migration + cluster LWW (CRDT) を取り込む
//   O (Observability + Profiling) — per-actor latency histogram、
//       framebuffer dashboard、distributed trace を pure-AIPL で
//       書き起こし、kernel evo Round 1 の scheduler 変更が AIPL から
//       観測できるようにする
//
// 不変条件: Round 1 で固定した 17 smoke + RemoteRPC 系 2 smoke +
// _smoke_backwardcompat.sh (Gate1 ≥ 85/85 + Gate2 ≥ 74/85) を
// 全 phase で保持.壊れたら phase 取り消し.

aice AIPL_XinuRazPi_Round2 {
  dialect = "aice_evolution_v2";

  task = "AIPL を Embedded Xinu / Raspberry Pi 系 (arm-qemu + 実 Pi) でさらに進化させる.Round 1 + その後のトラック (LOAD/COMPILE/RUN, pure-AIPL host, WM Console, readline+history, halt, in-Xinu memfs, in-Xinu make) を base に、(D) In-Xinu Developer Experience、(C) Multi-Pi Cluster、(O) Observability + Profiling の 3 方向で進化.全 phase は (1) aipl2c の .abcl → C 翻訳 ✅ + (2) Xinu kernel build ✅ + (3) QEMU で xsh$ プロンプト到達 ✅ + (4) Round 1 の 17 smoke + RemoteRPC の 2 smoke + 既存 backwardcompat gate が全 PASS、の 4 段ゲートを通過すること.";

  gene_schema = "../../../aice-evolution-v2/schemas/programming_paradigm.schema.json";

  seed_from {
    base_round1        = "AIPL_XinuRazPi_Round1.aice 完了状態 (R0/R1, P1-P4, F1-F4, G1-G3/G5, N1 部分, R_BackwardCompat)";
    base_kernel_evo    = "Xinu_KernelEvolution_Round1 phase 6 完了 (S1 PriorityAging, S2 MLFQ, S3 DeadlineHints, S4 IdlePower, Sec1 StackCanaries) + LOAD/COMPILE/RUN";
    base_compiler      = "src/aipl2c.ml --xinu + src/c_translator.ml::gen_program_xinu";
    base_in_kernel_vm  = "abclcTranslate + ccCompile + aoutRun (in-kernel stack VM、PUSH/ADD/PRINT 等)";
    base_host_orch     = "src/python-aipl/aipl_interp.py に TCP builtin (tcp_connect/send_line/send_bytes/recv_line/close) + host_diners_dynamic.aipl (162 行、Coordinator + Philosopher×3)";
    base_wm            = "WMCON0 60x16 cell grid + VT100-lite ESC sequence、2nd shell window、readline + 32-entry history";
    base_memfs         = "XFS on RAMDISK0 (/) + ls/pwd/cd/mkdir/cat/cp/make/abclc が動作";
    base_remote_rpc    = "PL011 UART1 ↔ host TCP socket、LOAD/COMPILE/RUN/SEND/QUERY/LIST 命令、host_rpc_demo.py 9/9 + host_diners.py 50 meals";
    smoke_baseline     = "17 AIPL smokes (R1/P1-P4/F1-F4/G1-G3/G5/N1) + RemoteRPC 2 smoke + S1-S4/Sec1 kernel smoke + memfs/make smoke";
    parity_anchor      = "AIPL CE-1..13 + DR-1..13 × 6 ランタイム (project_aipl_nextgen_parity)";
  }

  // ─── 評価タスク = phase 候補 ───────────────────────────────────
  evaluation_tasks {

    // ═══════════════════════════════════════════════════════════
    //  Direction D — In-Xinu Developer Experience
    //    memfs + abclc + LOAD/COMPILE/RUN + WM Console をベースに
    //    Xinu の中で AIPL を書く / 走らせる / 直す サイクルを完成
    // ═══════════════════════════════════════════════════════════

    task D1_AiplRepl {
      spec = "WM Console (= 2nd shell) から `aipl` コマンドで REPL を起動.各行を in-kernel abclc に送り、宣言 (class/method/var) は累積環境に積み、式は eval して結果を表示.history は既存 readline の循環バッファを再利用.セッション抜けは Ctrl-D or `:quit`.";
      weight = 0.10;
      acceptance = "5 assertion: (1) `aipl` プロンプトが出る、(2) `1+2` で `3` が表示、(3) `class C { method m() { print 42 } }` で class が登録され `now C.m()` 相当が動く、(4) 構文エラーは 1 行 abort で REPL は生き残る、(5) Ctrl-P/N で履歴が再利用できる.";
    }

    task D2_LineEditor {
      spec = "memfs 上の .aipl / .abcl / .c ファイルを WM Console から編集できる line-mode editor `ed` を実装.最小機能: 行番号表示、行追加 (a)、置換 (s/pat/rep/)、削除 (d)、書き出し (w)、終了 (q).vi に近い体験は後続 phase で.";
      weight = 0.08;
      acceptance = "4 assertion: (1) `ed /hello.aipl` でファイルを開く、(2) 編集後 `w` で memfs に書き戻り、(3) 編集後 `abclc /hello.aipl && run hello.elf` が成立、(4) 既存 ls/cat/cp の動作に regression なし.";
    }

    task D3_HotReload {
      spec = "走っている actor の class を、新しい .abcl source の再 LOAD/COMPILE で差し替える.actor state (field) はそのまま、method table だけ swap.既存 in-kernel VM の actor 表に `class_version` 列を足し、send 時に最新版に dispatch.";
      weight = 0.10;
      acceptance = "5 assertion: (1) v1 の Counter.bump() が走る、(2) `LOAD Counter v2 ...` で method 内容を変更、(3) 既存インスタンスの次回 send で v2 が呼ばれる、(4) field 値 (n=5) が保持される、(5) host_rpc_demo.py 9/9 PASS (regression).";
    }

    task D4_BreakpointDebugger {
      spec = "in-kernel VM に simple debugger を足し、`break <fn>:<line>` で停止、`step` / `cont` / `print <var>` ができる.UART0 console + WM Console どちらからでも attach 可.actor mailbox は debugger 停止中 backlog として保持.";
      weight = 0.08;
      acceptance = "4 assertion: (1) break が出る、(2) step で 1 命令進む、(3) print で local var が見える、(4) cont で actor が走り抜けて他の actor も progress.";
    }

    task D5_ModuleSystem {
      spec = "memfs 上の `/lib/*.aipl` を `import` 文 で参照できるようにする.import 解決は in-kernel make が cwd → /lib の順で.同じ class 名が衝突したら後勝ち警告.in-kernel abclc に `import` token を追加.";
      weight = 0.07;
      acceptance = "4 assertion: (1) `/lib/list.aipl` を import した program が build、(2) module 内 class が main 側から見える、(3) 衝突警告が UART0 に出る、(4) 既存 abclc 入力との後方互換 (import 無し sample 全 PASS).";
    }

    // ═══════════════════════════════════════════════════════════
    //  Direction C — Multi-Pi Cluster
    //    Round 1 N3 を完成、pure-AIPL host を多ノード化、
    //    actor migration + CRDT LWW で分散意味論を強化
    // ═══════════════════════════════════════════════════════════

    task C1_ClusterBootstrap {
      spec = "Round 1 で deferred だった N3 を完成.node_id (1..N) を起動 config で受け取り、`cluster_peers` builtin で他ノード一覧を返す.peer 探索は UART1 RPC または smc91c111 NIC の lwIP socket.peer table は 8 slot 固定.";
      weight = 0.10;
      acceptance = "5 assertion: (1) 2 ノード QEMU で互いが peers に出現、(2) ノード A 落として B が peers から消す、(3) cluster_peers() が AIPL から呼べる、(4) 既存 RemoteRPC の 2 smoke regression なし、(5) panic 無し.";
    }

    task C2_RemoteSpawn {
      spec = "pure-AIPL host orchestrator を多ノード対応に拡張.Coordinator が `spawn_remote(node_id, class_name, args...)` で他ノードに actor 生成依頼.node 側は LOAD/COMPILE 済 class を受け、新 actor_id を返却.send は actor_id を持ち回って routing.";
      weight = 0.10;
      acceptance = "4 assertion: (1) host から node A に Counter を spawn → actor_id 返却、(2) host から node B にも Counter spawn、(3) host が A.Counter.bump / B.Counter.bump を交互に呼べる、(4) どちらかの node 落ちても host が graceful error.";
    }

    task C3_ActorMigration {
      spec = "走っている actor を別 node に移送する.F1 checkpoint で snapshot を取り (project_xinu_razpi_aipl の F1 既存)、UART1 経由で peer に転送、新 node で復元、旧 actor は終了.message routing は migration epoch で旧 actor_id → 新 actor_id を transparent に書き換え.";
      weight = 0.08;
      acceptance = "4 assertion: (1) Counter(n=5) を A → B に migrate、(2) migrate 後 bump で n=6 になる、(3) 移送中の in-flight message が drop しない (再送 or 保留)、(4) F1 既存 smoke 7/7 PASS.";
    }

    task C4_ClusterLWW {
      spec = "F2 LWW cell を cluster 全域に拡張.各 cell の write は (key, value, lamport_ts, node_id) で broadcast.node_id は tie-break key.受信側は ts > stored_ts のとき (or tie 時 node_id larger) のみ commit、CRDT として monotonic.partition 解消後の re-sync は missing key を gossip.";
      weight = 0.08;
      acceptance = "4 assertion: (1) 2 ノードで concurrent write が一意の cone に収束、(2) partition 中 write が解消後 sync、(3) F2 既存 8/8 PASS、(4) Lamport ts が ノード間で monotonic.";
    }

    // ═══════════════════════════════════════════════════════════
    //  Direction O — Observability + Profiling
    //    kernel evo Round 1 の scheduler 変更を AIPL から観測可能に、
    //    distributed trace を pure-AIPL で記述
    // ═══════════════════════════════════════════════════════════

    task O1_ActorLatencyHistogram {
      spec = "actor が message を dequeue してから method return するまでを clkticks で計測、per-actor HDR-like 8 bucket histogram (1us/10us/100us/1ms/10ms/100ms/1s/inf) を保持.builtin `actor_latency(id)` で配列で取得.MLFQ (S2) や DeadlineHints (S3) の効果を AIPL から確認.";
      weight = 0.08;
      acceptance = "4 assertion: (1) 8 bucket counter が累積される、(2) busy actor の p99 と idle actor の p99 が分離できる、(3) S3 deadline actor の p99 が non-deadline より小さい、(4) overhead < 5% (idle baseline 比).";
    }

    task O2_FramebufferDashboard {
      spec = "P4 SchedulingVisualizer の bar-chart を拡張、4 領域に分割: (TL) sched 4 state、(TR) memory (heap/array_pool/slab)、(BL) net (TX/RX bytes/sec)、(BR) actor latency p50/p99.G1 fb_rect + G2 fb_text を活用.300ms ごとに refresh.";
      weight = 0.07;
      acceptance = "4 assertion: (1) 4 領域が描かれる、(2) サンプル program で actor latency が動的に変化、(3) memory bar が getmem 呼び出しに応答、(4) P4 既存 smoke 3/3 PASS.";
    }

    task O3_DistributedTrace {
      spec = "AIPL message に trace_id + span_id を埋め込み、send で propagate.span 終了時に UART0 (single node) or UART1 (cluster) に CSV 出力 `trace,t=N,id=H,span=H,actor=N,method=S,dur_us=N`.pure-AIPL host が cluster 全域の trace を集約.";
      weight = 0.07;
      acceptance = "4 assertion: (1) 1 message の trace が grep できる、(2) cluster 越し send で trace_id が継承、(3) host で 2-node span tree が再構築できる、(4) trace 無効化フラグで overhead 復元.";
    }

    task O4_MemoryProfiler {
      spec = "getmem / freemem / array_new / string_alloc に hook を入れ、call site (PC) → bytes-in-use の集計.builtin `mem_profile()` で top 10 を返す.WM Console から `mem` コマンドで表示.kernel evo の buddy/slab (Round 1 M1/M2 未実装でも freelist) と整合.";
      weight = 0.06;
      acceptance = "3 assertion: (1) leak demo program で top 1 が一致、(2) FbPrimitivesXinu の array_pool 利用がトラッキングされる、(3) `mem` コマンドが出力する.";
    }

    // ═══════════════════════════════════════════════════════════
    //  横断的タスク
    // ═══════════════════════════════════════════════════════════

    task R_BackwardCompat {
      spec = "各 phase 完了時に Round 1 の 17 AIPL smoke (R1/P1-P4/F1-F4/G1-G3/G5/N1 部分) + RemoteRPC の host_rpc_demo.py (9/9) + host_diners.py (50 meals) + kernel evo の S1-S4/Sec1 smoke + memfs/make smoke + _smoke_backwardcompat.sh (Gate1 ≥ 85/85, Gate2 ≥ 74/85) が全 PASS.regression が出たら phase 取り消し.";
      weight = 0.06;
      acceptance = "全 smoke 100% PASS、Gate1 ≥ 85/85 維持、Gate2 ≥ 74/85 維持、新規 sample 追加分は Gate1 にも全数 PASS.";
    }

    task ImplCost {
      spec = "Round 2 全 13 phase 合計で xinu-raz (apps/ + system/) +1500..+3500 LOC、abclcp-project の src/ は +200..+500 LOC、新規 abclc/*.abcl sample は +1000..+2000 LOC.kernel.elf binary size 増加は +150KB 以内.";
      weight = 0.05;
    }
  }

  // ─── レビュアー (Gemini 進化計算の選択圧) ───────────────────
  evaluator = "ai_v1";

  reviewers {

    reviewer R_DevExperience {
      persona = "あなたは R_DevExperience を判定するレビュアーです。候補設計 (paradigm / state_model / concurrency / type_strength / effect_handling / ownership の 6 軸) を見て、Xinu の中で AIPL を書く・走らせる・直す サイクル (REPL / editor / hot-reload / debugger / module system) が現実的に立ち上げられるかを判定する。スコア基準: 1.0 = paradigm=ParallelOOP + state_model=symbol_owned + type_strength=high (= 静的型 + actor-local state、REPL で再宣言してもクラッシュしにくい)、0.7 = paradigm=ParallelOOP + state_model=local + type_strength=medium (= 型情報あり、shadow が限定)、0.3 = paradigm=FunctionalOOP + state_model=immutable (= 純粋関数で REPL は容易だが hot-reload が状態転送で複雑)、0.0 = paradigm=BASIC + type_strength=low (= 型情報 0、エディタ補完 / debugger が役立たない)。半角数字の decimal で答えてください。";
      weight = 0.25;
    }

    reviewer R_DistributedCorrectness {
      persona = "あなたは R_DistributedCorrectness を判定するレビュアーです。candidate の concurrency / state_model / ownership を見て、multi-Pi cluster で (a) actor の remote spawn が deadlock を起こさない、(b) actor migration が in-flight message を失わない、(c) cluster LWW が CRDT として monotonic に収束する、を判定する。基準: 1.0 = concurrency=actor_messages + state_model=symbol_owned + ownership=affine_per_actor (= state がアクター単位で閉じる + linear ownership、migration 安全)、0.7 = concurrency=actor_messages + state_model=local + ownership=gc (= mailbox 中心、GC が後始末)、0.3 = concurrency=csp_channels + state_model=shared_locked (= channel 経由だが共有状態あり)、0.0 = concurrency=threads_shared + state_model=global_mutable (= 古典 thread + 共有変数、cluster 化困難)。半角数字の decimal で答えてください。";
      weight = 0.30;
    }

    reviewer R_ObservabilityCoverage {
      persona = "あなたは R_ObservabilityCoverage を判定するレビュアーです。候補の type_strength / effect_handling / state_model が、(a) per-actor latency histogram、(b) framebuffer dashboard、(c) distributed trace、(d) memory profiler、の 4 機能の実装容易性と低オーバヘッドを担保するかを判定する。基準: 1.0 = effect_handling=algebraic_effects + type_strength=high (= effect で計測 hook を型レベル安全に挿入、overhead < 5%)、0.7 = effect_handling=capability + type_strength=medium (= ケーパビリティで profiler を渡せる)、0.3 = effect_handling=monad + type_strength=low (= monad だが型が弱く trace 連鎖が脆い)、0.0 = effect_handling=none (= hook が ad-hoc、measurement が AIPL ランタイム本体に hard-code)。半角数字の decimal で答えてください。";
      weight = 0.20;
    }

    reviewer R_BackwardCompat {
      persona = "あなたは R_BackwardCompat を判定するレビュアーです。候補設計の変更が AIPL Round 1 で確立した 17 smoke + RemoteRPC host_rpc_demo / host_diners + kernel evo Round 1 の S1-S4/Sec1 smoke + memfs/make smoke を壊さない確率を判定する。重視: (a) gen_program_xinu の出力 (apps/abcl_program.c) が現行の object_t / mailbox API に従っているか、(b) UART0 console と UART1 RPC を両方 alive に保てるか、(c) WM Console + readline + memfs の前提 (RAMDISK0 layout、escape sequence の解釈、循環 history) を破らないか、(d) in-kernel abclc + cc + aoutRun のサブセット (PUSH/ADD/PRINT 等の stack VM) を破らないか。スコア基準: 1.0 = paradigm=ParallelOOP + state_model=symbol_owned + concurrency=actor_messages (= Round 1 の主軸とほぼ同じ、変更影響 < 5%)、0.7 = paradigm=ParallelOOP + state_model=local + concurrency=actor_messages (= ほぼ同じだが state model だけ移行コストあり)、0.3 = paradigm=FunctionalOOP or BASIC (= ABI 変更で旧 sample の修正が必要)、0.0 = paradigm=C (= AIPL 抽象を捨てて C 直書きに退化、Round 1 全資産が無効)。半角数字の decimal で答えてください。";
      weight = 0.25;
    }
  }

  // ─── 実装順序 (依存関係) ─────────────────────────────────────
  implementation_order {

    // Direction D は memfs + abclc が動いている前提なので即着手可
    step D1_AiplRepl              { dep = "baseline"; }
    step D2_LineEditor            { dep = "baseline"; }
    step D3_HotReload             { dep = "D1";  note = "REPL の eval 経路を hot-reload に共有"; }
    step D4_BreakpointDebugger    { dep = "D3"; }
    step D5_ModuleSystem          { dep = "D2 + D1"; }

    // Direction C は Round 1 N1 partial を回避する経路 (UART1 RPC) で着手
    step C1_ClusterBootstrap      { dep = "baseline";  note = "UART1 RPC 経由で peer 探索、smc91c111 修復は kernel Round 1 N1f 待ち"; }
    step C2_RemoteSpawn           { dep = "C1 + D3"; }
    step C3_ActorMigration        { dep = "C2"; }
    step C4_ClusterLWW            { dep = "C1"; }

    // Direction O は kernel evo Round 1 の scheduler 変更を観測できる
    // 状態 (S1-S3 完了 or 同時並走) で意味が出る
    step O1_ActorLatencyHistogram { dep = "baseline"; }
    step O2_FramebufferDashboard  { dep = "O1";  note = "P4 既存 visualizer の上に 4 領域を載せる"; }
    step O3_DistributedTrace      { dep = "C1 + O1"; }
    step O4_MemoryProfiler        { dep = "baseline"; }
  }

  // ─── アーキテクチャ決定 ──────────────────────────────────────
  decisions {

    decision target_platform {
      primary    = "qemu-system-arm -M versatilepb -cpu arm1176 -m 256M";
      secondary  = "qemu-system-arm -M raspi3b (kernel evo A1 が動いていれば)";
      tertiary   = "実 Raspberry Pi 3 / 4 (C 軸 multi-Pi、A3 GPIO 連動時のみ)";
      forbidden  = "Round 2 では x86_64 / riscv は着手しない";
    }

    decision build_pipeline {
      compiler     = "src/aipl2c.ml --xinu  → /tmp/<sample>.c";
      install      = "cp /tmp/<sample>.c $XINU/apps/abcl_program.c";
      kernel_build = "make -C $XINU/compile PLATFORM=arm-qemu COMPILER_ROOT=/opt/homebrew/bin/arm-none-eabi-";
      runner_smoke = "qemu-system-arm -nographic + serial-stdio + UART1 tcp:127.0.0.1:5555";
      runner_gui   = "qemu-system-arm -display cocoa (D2 editor / O2 dashboard の視認時)";
    }

    decision smoke_strategy {
      method     = "QEMU -nographic + UART0 stdio + UART1 tcp socket + grep on stdout、cluster 系は 2 QEMU instance を 5555/5556 で並走";
      timeout    = "60-180 秒 (phase 別、cluster + migration は 240 秒まで)";
      markers    = "kernel が出す 'xsh$' プロンプト + AIPL 側の '[aipl] ...' 各 phase 固有 marker";
      regression_floor = "Round 1 の 17 smoke + RemoteRPC の 2 smoke + kernel evo の 5 smoke + memfs/make の 2 smoke + _smoke_backwardcompat.sh (Gate1 ≥ 85, Gate2 ≥ 74) を absolute 不変条件として保持";
    }

    decision external_repo {
      xinu_raz       = "/Users/kodamay/projects/xinu-raz/xinu  (= 別 git、新規 apps/system 変更は明示的に commit)";
      abclcp_project = "/Users/kodamay/ocaml-app/abclcp-project (= AIPL/aipl2c、in-kernel VM 拡張時のみ src/ 変更)";
      changes_record = "phase 完了時に両 repo の commit SHA を README.md に記録";
    }

    decision rollback_policy {
      strategy  = "phase ごとに kernel.elf を build → smoke 落ちたら revert";
      ckpt_freq = "phase 完了時に xinu-raz + abclcp-project の両方を tag 付き commit";
    }

    decision evolution_seed {
      // Round 1 の進化計算結果を参考に seed.
      //   OpenAI: paradigm=ParallelOOP top + conc_model=actor_messages
      //   RemoteRPC seed=6: paradigm=C + state=symbol_owned + conc=actor_messages
      //                     + type=low + effect=capability + own=gc @ 0.755
      // Round 2 は ParallelOOP / actor_messages を anchor にしつつ、
      // state_model と effect_handling を探索の幅にする.
      anchor_axes   = "paradigm=ParallelOOP, concurrency=actor_messages";
      explore_axes  = "state_model, effect_handling, type_strength, ownership";
      ga_seed       = 7;
      ga_gen        = 15;
      ga_pop        = 12;
    }
  }

  // ─── 検証 (期待 assertion 合計) ──────────────────────────────
  verification {
    direction_D   = "21 assertion (D1:5 + D2:4 + D3:5 + D4:4 + D5:4 - 1 連動 = 21)";
    direction_C   = "17 assertion (C1:5 + C2:4 + C3:4 + C4:4)";
    direction_O   = "15 assertion (O1:4 + O2:4 + O3:4 + O4:3)";
    cross_cut     = "Round 1 17 smoke + RemoteRPC 2 + kernel evo 5 + memfs/make 2 + Gate1/Gate2 を不変に保つ";
    grand_total   = "53 assertion for Round 2";
  }

  // ─── ファイル更新範囲 ─────────────────────────────────────────
  file_impact {
    primary_abclcp = [
      "src/c_translator.ml::gen_program_xinu  (~200-400 LOC: hot-reload epoch field, latency hist hook, trace fields)",
      "src/aipl2c.ml                          (~30-60 LOC: import token, REPL line-mode flag)",
      "src/python-aipl/aipl_interp.py         (~100-200 LOC: cluster RPC builtin 拡張、host 側 trace 集約)",
      "abclc/*Round2*.abcl                    (~600-1200 LOC: D1-D5 / C1-C4 / O1-O4 用 demo)"
    ];
    primary_xinu_raz = [
      "apps/abcl_xinu_rpc.c                   (~150-300 LOC: SPAWN_REMOTE, MIGRATE, TRACE 命令)",
      "apps/abcl_repl.c (new)                 (~250 LOC: D1 REPL loop)",
      "apps/ed.c (new)                        (~200 LOC: D2 line editor)",
      "apps/abcl_dbg.c (new)                  (~200 LOC: D4 debugger)",
      "apps/abcl_xinu_gui.c                   (~150 LOC: O2 dashboard 4 panel)",
      "system/abcl_latency.c (new)            (~100 LOC: O1 histogram)",
      "system/abcl_trace.c (new)              (~150 LOC: O3 trace ring buffer)",
      "system/abcl_memprof.c (new)            (~100 LOC: O4 profiler)"
    ];
    new_files = [
      "aice-pi-evolution/experiments/2026-05-21_xinu_aipl_round2/_smoke_<phase>.sh",
      "aice-pi-evolution/experiments/2026-05-21_xinu_aipl_round2/README.md",
      "aice-pi-evolution/experiments/2026-05-21_xinu_aipl_round2/report/<phase>.md"
    ];
    untouched = [
      "browser-abcl / spreadsheet / drone-sim — 完全に独立",
      "Python-AIPL の自己ホスト経路 (samples/nextgen/_logs/) — Round 2 では触らない"
    ];
  }

  // ─── 実行例 (進化計算の起動コマンド) ─────────────────────────
  sample_session {

    parse_only {
      cmd = "cd aice-evolution-v2 && python3 -m src.cli --no-run -o ../aice-pi-evolution/experiments/2026-05-21_xinu_aipl_round2/ ../aice-pi-evolution/experiments/2026-05-21_xinu_aipl_round2/AIPL_XinuRazPi_Round2.aice";
      output = "AIPL_XinuRazPi_Round2.ga.json (parse 確認)";
    }

    generate_aipl {
      cmd = "cd aice-evolution-v2 && python3 -m src.cli --no-run --abcl -o ../aice-pi-evolution/experiments/2026-05-21_xinu_aipl_round2/ ../aice-pi-evolution/experiments/2026-05-21_xinu_aipl_round2/AIPL_XinuRazPi_Round2.aice";
      output = "AIPL_XinuRazPi_Round2.aipl (= MAP-Elites orchestrator)";
      post   = "use_ai 0 -> 1 を patch (RemoteRPC / Kernel Round 1 と同様の手順)";
    }

    run_evolution {
      requires = "GEMINI_API_KEY が export 済、google-genai SDK が import 可";
      cmd      = "AIPL_AI_PROVIDER=gemini python3 -u src/python-aipl/aipl_main.py aice-pi-evolution/experiments/2026-05-21_xinu_aipl_round2/AIPL_XinuRazPi_Round2.aipl --timeout 1800 --idle-ms 600000";
      output   = "out/AIPL_XinuRazPi_Round2.abcl_lineage.json";
      duration = "25-50 分 (seed=7 + gen=15 + pop=12 + 4 reviewers x 13 tasks ~= 1200 LLM calls)";
    }
  }

  // ─── 最終目標 ─────────────────────────────────────────────────
  goal = "Round 2 全 13 phase (D1-D5 + C1-C4 + O1-O4) 完了後、AIPL on Xinu が (a) Xinu の中で AIPL を書く・走らせる・hot-reload する・debugger で覗く・module を読み込む の 5 機能の dev cycle、(b) multi-Pi cluster で remote spawn + actor migration + CRDT LWW、(c) per-actor latency histogram + framebuffer 4-panel dashboard + distributed trace + memory profiler の観測層 — を獲得する.Round 1 + kernel evo Round 1 の累積 smoke (24+ 個) は absolute 不変条件として保持.進化計算の出力は MAP-Elites の cell ごと champion 設計案 (e.g. cell=state_model=symbol_owned) + 推奨 implementation_order.";
}
