        if (b14 == "arm_rpi4") { in_set = 1; }
        if (b14 == "arm_rpi5") { in_set = 1; }
        if (b14 == "x86_64") { in_set = 1; }
        if (b14 == "multi_arch") { in_set = 1; }
        if (in_set == 0) { ok = 0; }
      }
    }
    // rule 15: if smp_model="full_smp" ⇒ …
    var a15_k = "smp_model=";
    var a15_i = str_index(genome, a15_k);
    var a15 = "";
    if (a15_i >= 0) {
      var a15_r = str_sub(genome, a15_i + str_len(a15_k));
      var a15_b = str_index(a15_r, "|");
      if (a15_b < 0) { a15 = a15_r; }
      else { a15 = str_sub(a15_r, 0, a15_b); }
    }

    if (a15 == "full_smp") {
      var b15_k = "arch_target=";
      var b15_i = str_index(genome, b15_k);
      var b15 = "";
      if (b15_i >= 0) {
        var b15_r = str_sub(genome, b15_i + str_len(b15_k));
        var b15_b = str_index(b15_r, "|");
        if (b15_b < 0) { b15 = b15_r; }
        else { b15 = str_sub(b15_r, 0, b15_b); }
      }

      if (b15 != "") {
        var in_set = 0;
        if (b15 == "arm_rpi3") { in_set = 1; }
        if (b15 == "arm_rpi4") { in_set = 1; }
        if (b15 == "arm_rpi5") { in_set = 1; }
        if (b15 == "x86_64") { in_set = 1; }
        if (b15 == "multi_arch") { in_set = 1; }
        if (in_set == 0) { ok = 0; }
      }
    }
    // rule 16: if smp_model="full_smp" ⇒ …
    var a16_k = "smp_model=";
    var a16_i = str_index(genome, a16_k);
    var a16 = "";
    if (a16_i >= 0) {
      var a16_r = str_sub(genome, a16_i + str_len(a16_k));
      var a16_b = str_index(a16_r, "|");
      if (a16_b < 0) { a16 = a16_r; }
      else { a16 = str_sub(a16_r, 0, a16_b); }
    }

    if (a16 == "full_smp") {
      var b16_k = "concurrency_safety=";
      var b16_i = str_index(genome, b16_k);
      var b16 = "";
      if (b16_i >= 0) {
        var b16_r = str_sub(genome, b16_i + str_len(b16_k));
        var b16_b = str_index(b16_r, "|");
        if (b16_b < 0) { b16 = b16_r; }
        else { b16 = str_sub(b16_r, 0, b16_b); }
      }

      if (b16 != "") {
        var in_set = 0;
        if (b16 == "spinlock") { in_set = 1; }
        if (b16 == "lock_free") { in_set = 1; }
        if (b16 == "rcu") { in_set = 1; }
        if (b16 == "stm") { in_set = 1; }
        if (in_set == 0) { ok = 0; }
      }
    }
    reply(ok);
  }
}

// --------------------------------------------------------------------
// DigitOps — peer actor for parse_score so Util can avoid self-call.
// --------------------------------------------------------------------

class DigitOps {
  method val(c) {
    if (c == "0") { reply(0); }
    else if (c == "1") { reply(1); }
    else if (c == "2") { reply(2); }
    else if (c == "3") { reply(3); }
    else if (c == "4") { reply(4); }
    else if (c == "5") { reply(5); }
    else if (c == "6") { reply(6); }
    else if (c == "7") { reply(7); }
    else if (c == "8") { reply(8); }
    else if (c == "9") { reply(9); }
    else { reply(-1); }
  }
}

// --------------------------------------------------------------------
// Worker — compound operations that orchestrate Util/Evaluator/Profiles.
// Lives in its own actor so its callers (e.g. Coordinator) can use `now`
// without re-entering themselves.
// --------------------------------------------------------------------

class Worker {
  var util = 0;
  var evaluator = 0;
  var profiles = 0;

  method init(u, e, p) {
    util = u;
    evaluator = e;
    profiles = p;
  }

  method compute_cell(genome, cell_axes_csv) {
    var n = now util.count_csv(cell_axes_csv);
    var i = 0;
    var out = "";
    while (i < n) do {
      var axis = now util.nth_csv(cell_axes_csv, i);
      var v = now util.get_axis(genome, axis);
      if (i == 0) { out = axis + "=" + v; }
      else { out = out + "|" + axis + "=" + v; }
      i = i + 1;
    }
    reply(out);
  }

  method compute_score(genome, task_csv) {
    var n = now util.count_csv(task_csv);
    var i = 0;
    var sum = 0.0;
    while (i < n) do {
      var task = now util.nth_csv(task_csv, i);
      var prof = now profiles.get(task);
      var s = now evaluator.score_for_task(genome, prof);
      sum = sum + s;
      i = i + 1;
    }
    var avg = sum;
    if (n > 0) { avg = sum / (n + 0.0); }
    reply(avg);
  }
}

// --------------------------------------------------------------------
// Generator — seed / mutate / crossover
// --------------------------------------------------------------------

class Generator {
  var util = 0;
  var axes_csv = "";
  var values_table = "";

  method init(u, axes, values) {
    util = u;
    axes_csv = axes;
    values_table = values;
  }

  // v4 (2026-05-17): seed / mutate / cross now rejection-sample on the
  // schema's coherence rules (via Util.is_coherent).  Up to 50 attempts;
  // on every retry exhausted, the last candidate is returned even if
  // incoherent, so the evolution never deadlocks on infeasible schemas.

  method seed() {
    var tries = 0;
    var g = "";
    var ok = 0;
    while (ok == 0) do {
      var n_axes = now util.count_csv(axes_csv);
      var i = 0;
      var cand = "";
      while (i < n_axes) do {
        var axis = now util.nth_csv(axes_csv, i);
        var vals = now util.axis_values(values_table, axis);
        var n_vals = now util.count_csv(vals);
        var v = now util.nth_csv(vals, random(n_vals));
        if (i == 0) { cand = axis + "=" + v; }
        else { cand = cand + "|" + axis + "=" + v; }
        i = i + 1;
      }
      g = cand;
      ok = now util.is_coherent(g);
      tries = tries + 1;
      if (tries >= 50) { ok = 1; }
    }
    reply(g);
  }

  method mutate(parent) {
    var tries = 0;
    var child = parent;
    var ok = 0;
    while (ok == 0) do {
      var n_axes = now util.count_csv(axes_csv);
      var idx = random(n_axes);
      var axis = now util.nth_csv(axes_csv, idx);
      var vals = now util.axis_values(values_table, axis);
      var n_vals = now util.count_csv(vals);
      var v = now util.nth_csv(vals, random(n_vals));
      var cand = now util.set_axis(parent, axis, v);
      child = cand;
      ok = now util.is_coherent(child);
      tries = tries + 1;
      if (tries >= 50) { ok = 1; }
    }
    reply(child);
  }

  method cross(a, b) {
    var tries = 0;
    var child = a;
    var ok = 0;
    while (ok == 0) do {
      var n_axes = now util.count_csv(axes_csv);
      var i = 0;
      var cand = "";
      while (i < n_axes) do {
        var axis = now util.nth_csv(axes_csv, i);
        var src = a;
        if (random(2) == 1) { src = b; }
        var v = now util.get_axis(src, axis);
        if (i == 0) { cand = axis + "=" + v; }
        else { cand = cand + "|" + axis + "=" + v; }
        i = i + 1;
      }
      child = cand;
      ok = now util.is_coherent(child);
      tries = tries + 1;
      if (tries >= 50) { ok = 1; }
    }
    reply(child);
  }
}

// --------------------------------------------------------------------
// Reviewer — one ai_call_with_system per score request (Phase 6),
//            deterministic scoring (Phase 5).
// --------------------------------------------------------------------

class Reviewer {
  var name = "";
  var persona = "";
  var use_ai = 0;
  var weight = 0.0;
  var util = 0;
  var digits = 0;

  method init(n, p, u, w, util_actor, digits_actor) {
    name = n;
    persona = p;
    use_ai = u;
    weight = w;
    util = util_actor;
    digits = digits_actor;
  }

  method score(genome, task_profile) {
    if (use_ai == 1) {
      var prompt = "評価対象の遺伝子: " + genome +
                   "\n理想プロファイル: " + task_profile +
                   "\n\nこのプロファイルに対する適合度を 0.0 から 1.0 の単一の decimal number で返してください。説明禁止。数値1つだけ。";
      var ai_text = ai_call_with_system(persona, prompt);
      var ai_score = now util.parse_score(ai_text, digits);
      reply(ai_score);
    } else {
    // Deterministic: fraction of profile axes the genome matches.
    var matches = 0;
    var total = 0;
    var rest = task_profile;
    while (str_len(rest) > 0) do {
      var bar = str_index(rest, "|");
      var pair = "";
      if (bar < 0) {
        pair = rest;
        rest = "";
      } else {
        pair = str_sub(rest, 0, bar);
        rest = str_sub(rest, bar + 1);
      }
      var eq = str_index(pair, "=");
      if (eq >= 0) {
        var axis = str_sub(pair, 0, eq);
        var want = str_sub(pair, eq + 1);
        var key = axis + "=";
        var gidx = str_index(genome, key);
        if (gidx >= 0) {
          var gstart = gidx + str_len(key);
          var grest = str_sub(genome, gstart);
          var gbar = str_index(grest, "|");
          var got = "";
          if (gbar < 0) { got = grest; }
          else { got = str_sub(grest, 0, gbar); }
          if (got == want) { matches = matches + 1; }
        }
        total = total + 1;
      }
    }
    var s = 0.0;
    if (total > 0) { s = (matches + 0.0) / (total + 0.0); }
    reply(s);
    }
  }

  method get_weight() { reply(weight); }
}

// --------------------------------------------------------------------
// Evaluator — fans out reviewer scoring with `future`, awaits, aggregates.
// The class is codegen'd with exactly n_reviewers slots (see
// aipl_codegen.py) so init() arity matches the bootstrap call for any N.
// --------------------------------------------------------------------

class Evaluator {
  var r1 = 0;
  var r2 = 0;
  var r3 = 0;
  var r4 = 0;

  method init(rev1, rev2, rev3, rev4) {
    r1 = rev1;
    r2 = rev2;
    r3 = rev3;
    r4 = rev4;
  }

  method score_for_task(genome, profile) {
    var f1 = future r1.score(genome, profile);
    var f2 = future r2.score(genome, profile);
    var f3 = future r3.score(genome, profile);
    var f4 = future r4.score(genome, profile);
    var s1 = await(f1);
    var w1 = now r1.get_weight();
    var s2 = await(f2);
    var w2 = now r2.get_weight();
    var s3 = await(f3);
    var w3 = now r3.get_weight();
    var s4 = await(f4);
    var w4 = now r4.get_weight();
    var combined = s1 * w1 + s2 * w2 + s3 * w3 + s4 * w4;
    reply(combined);
  }
}

// --------------------------------------------------------------------
// EliteMap — cell -> champion id mapping with parallel arrays
// --------------------------------------------------------------------

class EliteMap {
  var cells = [];
  var ids = [];
  var scores = [];
  var genomes = [];

  method propose(cell, ind_id, genome, score) {
    var n = array_len(cells);
    var i = 0;
    var idx = -1;
    while (i < n) do {
      if (array_get(cells, i) == cell) {
        idx = i;
        i = n;
      } else {
        i = i + 1;
      }
    }
    if (idx < 0) {
      array_push(cells, cell);
      array_push(ids, ind_id);
      array_push(scores, score);
      array_push(genomes, genome);
      reply(1);
    } else {
      var existing = array_get(scores, idx);
      if (score > existing) {
        array_set(ids, idx, ind_id);
        array_set(scores, idx, score);
        array_set(genomes, idx, genome);
        reply(1);
      } else {
        reply(0);
      }
    }
  }

  method size() { reply(array_len(cells)); }

  method sample_random_genome() {
    var n = array_len(cells);
    if (n == 0) { reply(""); }
    else { reply(array_get(genomes, random(n))); }
  }

  method best_summary(top_k) {
    var n = array_len(cells);
    var i = 0;
    var out = "";
    while (i < n) do {
      var line = "  cell=" + array_get(cells, i) +
                 "  score=" + array_get(scores, i) +
                 "  id=" + array_get(ids, i);
      if (i == 0) { out = line; }
      else { out = out + "\n" + line; }
      i = i + 1;
    }
    reply(out);
  }
}

// --------------------------------------------------------------------
// Lineage — append-only individual record
// --------------------------------------------------------------------

class Lineage {
  var ids = [];
  var genomes = [];
  var parents = [];
  var scores = [];
  var generations = [];
  var operators = [];
  var cells = [];

  method add(id, genome, parent, score, gen, op, cell) {
    array_push(ids, id);
    array_push(genomes, genome);
    array_push(parents, parent);
    array_push(scores, score);
    array_push(generations, gen);
    array_push(operators, op);
    array_push(cells, cell);
    reply(array_len(ids));
  }

  method dump(path) {
    var n = array_len(ids);
    var i = 0;
    var out = "[\n";
    while (i < n) do {
      // score gets a trailing "0" so 0.0 stringifies to "0.00"
      // (Python runtime emits "0." which would be invalid JSON).
      var entry = "  {\"id\":\"" + array_get(ids, i) + "\"," +
                  "\"genome\":\"" + array_get(genomes, i) + "\"," +
                  "\"parent\":\"" + array_get(parents, i) + "\"," +
                  "\"score\":" + array_get(scores, i) + "0," +
                  "\"generation\":" + array_get(generations, i) + "," +
                  "\"operator\":\"" + array_get(operators, i) + "\"," +
                  "\"cell\":\"" + array_get(cells, i) + "\"}";
      if (i < n - 1) { out = out + entry + ",\n"; }
      else { out = out + entry + "\n"; }
      i = i + 1;
    }
    out = out + "]\n";
    write_file(path, out);
    reply(n);
  }
}

// --------------------------------------------------------------------
// TaskProfiles — embedded per-task ideal genome fragments
// --------------------------------------------------------------------

class TaskProfiles {
  // task profiles inlined into get(); no separate methods.

  method get(task_name) {
    if (task_name == "P0_WorkerPoolBaseline") { reply(""); }
    else if (task_name == "P1_LoadBalanceStrideFix") { reply(""); }
    else if (task_name == "P2_WorkStealing") { reply(""); }
    else if (task_name == "P3_ParSafeActorDispatch") { reply(""); }
    else if (task_name == "K1_DCacheForCompute") { reply(""); }
    else if (task_name == "K2_DCacheMemoryScaling") { reply(""); }
    else if (task_name == "K3_USBDMACoherency") { reply(""); }
    else if (task_name == "S1_PriorityAging") { reply(""); }
    else if (task_name == "S2_MlfqOrEdf") { reply(""); }
    else if (task_name == "C1_RcuReadMostly") { reply(""); }
    else if (task_name == "C2_TicketSpinlockDCacheGated") { reply(""); }
    else if (task_name == "M1_BuddySlab") { reply(""); }
    else if (task_name == "W1_HaltIdleOrDvfs") { reply(""); }
    else if (task_name == "R_LiveCapabilitiesUnchanged") { reply(""); }
    else if (task_name == "ImplCost") { reply(""); }
    else { reply(""); }
  }
}

// --------------------------------------------------------------------
// Coordinator — main loop
// --------------------------------------------------------------------

class Coordinator {
  var util = 0;
  var generator = 0;
  var evaluator = 0;
  var elite = 0;
  var lineage = 0;
  var profiles = 0;
  var worker = 0;

  var seed_count = 4;
  var generations = 10;
  var cell_axes_csv = "smp_model";
  var task_csv = "P0_WorkerPoolBaseline,P1_LoadBalanceStrideFix,P2_WorkStealing,P3_ParSafeActorDispatch,K1_DCacheForCompute,K2_DCacheMemoryScaling,K3_USBDMACoherency,S1_PriorityAging,S2_MlfqOrEdf,C1_RcuReadMostly,C2_TicketSpinlockDCacheGated,M1_BuddySlab,W1_HaltIdleOrDvfs,R_LiveCapabilitiesUnchanged,ImplCost";
  var next_id = 0;

  method init(u, g, e, em, lg, tp, w) {
    util = u;
    generator = g;
    evaluator = e;
    elite = em;
    lineage = lg;
    profiles = tp;
    worker = w;
  }

  method run() {
    print("=== Xinu_RPi3_InternalEvolution (AIPL — Actor-based Intelligent Parallel Language — orchestrator) ===");
    print("seed_count=" + seed_count + "  generations=" + generations);

    // Phase 1: seed
    var i = 0;
    while (i < seed_count) do {
      var g = now generator.seed();
      next_id = next_id + 1;
      var id = "I" + next_id;
      var cell = now worker.compute_cell(g, cell_axes_csv);
      var score = now worker.compute_score(g, task_csv);
      send lineage.add(id, g, "", score, 0, "seed", cell);
      send elite.propose(cell, id, g, score);
      i = i + 1;
    }
    print("[seed] elite cells filled: " + (now elite.size()));

    // Phase 2: evolution
    var gen = 1;
    while (gen <= generations) do {
      var parent = now elite.sample_random_genome();
      var size = now elite.size();
      var do_cross = 0;
      if (random(10) < 3) {
        if (size >= 2) { do_cross = 1; }
      }
      var child = "";
      var op = "";
      if (do_cross == 1) {
        var partner = now elite.sample_random_genome();
        child = now generator.cross(parent, partner);
        op = "uniform_crossover";
      } else {
        child = now generator.mutate(parent);
        op = "axis_resample";
      }
      next_id = next_id + 1;
      var cid = "I" + next_id;
      var ccell = now worker.compute_cell(child, cell_axes_csv);
      var cscore = now worker.compute_score(child, task_csv);
      send lineage.add(cid, child, "", cscore, gen, op, ccell);
      send elite.propose(ccell, cid, child, cscore);
      // crash-recovery: flush lineage every generation so silent SDK
      // hangs (cf. Pi_Phase1_OpenSearch v3 attempt 2026-05-16) do not
      // lose the partial result.  Cost: one fs write per generation.
      var ckpt_n = now lineage.dump("out/Xinu_RPi3_InternalEvolution.abcl_lineage.json");
      print("[ckpt gen=" + gen + "] flushed " + ckpt_n + " individuals");
      gen = gen + 1;
    }

    print("[done] cells filled: " + (now elite.size()));
    print(now elite.best_summary(5));

    var n = now lineage.dump("out/Xinu_RPi3_InternalEvolution.abcl_lineage.json");
    print("[lineage] wrote " + n + " individuals to out/Xinu_RPi3_InternalEvolution.abcl_lineage.json");
  }
}

// --------------------------------------------------------------------
// Bootstrap (top-level)
// --------------------------------------------------------------------

var util = new Util();
var digits = new DigitOps();
var generator = new Generator(util, "scheduler,memory_alloc,ipc_primitive,isolation,arch_target,power_mgmt,concurrency_safety,smp_model", "scheduler:round_robin,priority_static,priority_aging,mlfq,edf_soft,cfs_like|memory_alloc:bump,freelist,buddy,slab,demand_paged,cow|ipc_primitive:sem_mailbox,channel_typed,capability,tuple_space,actor_lockfree|isolation:none,user_kernel_split,mmu_per_process,capability_token,container_like|arch_target:arm_versatilepb,arm_rpi3,arm_rpi4,arm_rpi5,x86_64,riscv32,multi_arch|power_mgmt:always_on,halt_idle,dvfs,deep_sleep|concurrency_safety:critical_section,spinlock,lock_free,rcu,stm|smp_model:single_core,worker_pool,full_smp");
var elite = new EliteMap();
var lineage = new Lineage();
var profiles = new TaskProfiles();

var rev1 = new Reviewer("R_MeasuredSmpReality", "あなたは R_MeasuredSmpReality を判定するレビュアーです。Raspberry Pi 3 (Cortex-A53 x4、AArch32 32bit) の SMP 設計を、このプロジェクトで得た *実機実測* に照らして採点します。実測事実: worker-pool は計算律速で dining ×3.99・nqueens ×3.66 を出し実証済み。full_smp は AArch32 A53 で core0 専有の WM/WiFi(EMMC共有)/AODV を壊すリスクが高く、しかも LDREX/STREX が Pi3 実機で fault した前例があり cross-core 同期が D-cache OFF では不安定。よって worker_pool が実測に最も裏付けられた選択。スコア基準: 1.0 = smp_model=worker_pool + concurrency_safety=lock_free or rcu + scheduler=priority_aging or mlfq (= 実証済み worker-pool ×3.99 を磨く、最も現実的)、0.6 = smp_model=full_smp + concurrency_safety=lock_free (= 全コア化の野心だが AArch32 A53 で core0 専有機能を壊すリスク + LDREX 不安定)、0.3 = smp_model=full_smp + concurrency_safety=spinlock (= 粗いロックで頭打ち + 実装困難)、0.1 = smp_model=single_core (= 4 コアを捨てる退化)、0.0 = smp_model=full_smp + concurrency_safety=critical_section (= IRQ マスクで全コア同期は原理的に不可)。半角数字の decimal で答えてください。", 1, 0.28, util, digits);
var rev2 = new Reviewer("R_DCacheDominance", "あなたは R_DCacheDominance を判定するレビュアーです。このセッション最大の発見は「支配変数は SMP 方式ではなく *キャッシュ構成* (D-cache)」でした。実測: D-cache OFF ではメモリ律速が一切スケールしない (×0.95-1.35)。D-cache ON にすると単一コア計算が 8.8 倍高速化し、メモリ律速も作業セット≤キャッシュなら ×4.01 スケール。ゆえに memory_alloc + power_mgmt + concurrency_safety が D-cache を活かす設計かを判定する。ただし D-cache ON は USB DMA (DWC がヒープ/スタックを DMA) が本番化の壁で、バウンス方式でも全 USB が停止した実測がある。スコア基準: 1.0 = memory_alloc=buddy or slab + power_mgmt=halt_idle or dvfs + concurrency_safety=lock_free or rcu (= D-cache と相性が良く、キャッシュ効果を最大化しつつ実装済み基盤に乗る)、0.7 = memory_alloc=buddy + power_mgmt=always_on (= 堅実だが省電力/キャッシュ活用は控えめ)、0.4 = memory_alloc=demand_paged or cow (= MMU 重依存、D-cache と組むと USB DMA 問題が深刻化)、0.1 = memory_alloc=bump (= 原始的、キャッシュ効果を活かせない)、0.0 = concurrency_safety=stm (= ベアメタル Xinu に過大、キャッシュ以前に非現実的)。半角数字の decimal で答えてください。", 1, 0.24, util, digits);
var rev3 = new Reviewer("R_A53Aarch32Impl", "あなたは R_A53Aarch32Impl を判定するレビュアーです。候補の scheduler + concurrency_safety + ipc_primitive + smp_model を、AArch32 (32bit) Cortex-A53 の実機 Xinu で実装する困難度・現実性を判定する。rpi3 の実機事実: コア解放は armstub7 mailbox 3 (0x4000008C) + SEV (★PSCI ではない)、MPIDR Aff0 でコア識別、D-cache OFF、I-cache ON、タイマ割り込みが不安定 (clkticks が 0、clkcount 直読で回避)、LDREX/STREX が fault した前例。低コストで確実に動くほど高得点。基準: 1.0 = smp_model=worker_pool + concurrency_safety=lock_free or rcu + scheduler=priority_aging + ipc_primitive=sem_mailbox (= 既存 worker-pool + volatile lock-free + RCU をそのまま延長、実証済み)、0.6 = smp_model=full_smp + concurrency_safety=spinlock (= LDREX/STREX ticket lock だが Pi3 で fault 前例、D-cache ON が前提で難度高)、0.3 = concurrency_safety=rcu + full_smp (= SMP RCU の grace period 設計が要、難)、0.1 = concurrency_safety=stm or ipc_primitive=tuple_space (= ベアメタルに過大)、0.0 = smp_model=full_smp + concurrency_safety=critical_section (= IRQ マスクで cross-core 排他は不可)。半角数字の decimal で答えてください。", 1, 0.24, util, digits);
var rev4 = new Reviewer("R_LiveCapabilityCompat", "あなたは R_LiveCapabilityCompat を判定するレビュアーです。候補設計が、実機で動いているライブ機能 — ad-hoc(IBSS) MANET + AODV メッシュ (10.0.0.1)、gwm WM デスクトップ (シェル窓 + BASIC 窓)、AIPL アクター + cc オンデバイス JIT、kexec、RCU、buddy、demand-paging — を壊さずに共存できる確率を判定する。★rpi3 固有のリスク: WiFi は EMMC を SD と共有 (WiFi ON 時のみ SD 動作) しており SDIO 割り込みは core0 専有、gwm 描画も core0 専有。full_smp 化はこれらを危険に晒す。重視: (a) ipc_primitive を sem_mailbox (AIPL mailbox) から動かさない、(b) isolation を none/user_kernel_split に留め flat identity map を壊さない、(c) full_smp でも core0 の WM/SDIO/AODV 専有処理が機能継続。スコア基準: 1.0 = ipc=sem_mailbox + isolation=none or user_kernel_split + smp_model=worker_pool (= 純粋追加、ライブ機能ノーリスク)、0.6 = 上記 + smp_model=full_smp (= core0 専有処理の移行コスト大だが理屈上共存可)、0.4 = isolation=capability_token or memory を大きく変更、0.1 = isolation=mmu_per_process or container_like (= MMU 再設計でメッシュ/WM/EMMC の MMIO マップ破壊リスク大)、0.0 = ipc_primitive=tuple_space or capability (= AIPL mailbox 全替えで JIT/メッシュ/アクター全滅)。半角数字の decimal で答えてください。", 1, 0.24, util, digits);
var eval_actor = new Evaluator(rev1, rev2, rev3, rev4);
var worker = new Worker(util, eval_actor, profiles);
var coord = new Coordinator(util, generator, eval_actor, elite, lineage, profiles, worker);
send coord.run();
