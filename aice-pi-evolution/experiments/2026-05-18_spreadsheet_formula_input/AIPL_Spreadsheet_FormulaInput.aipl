// Generated by aice-evolution-v2/src/aipl_codegen.py from AIPL_Spreadsheet_FormulaInput
// Pipeline: seed (random genome per axis) -> evolve via mutate/cross
// -> per-task scoring across reviewers -> elite map per cell
// -> dump lineage as JSON for the Python report pipeline.
//
// Run:
//   AIPL_AI_PROVIDER=mock /usr/bin/python3 src/python-aipl/aipl_main.py AIPL_Spreadsheet_FormulaInput.aipl
//
// Reviewers compute deterministic scores in Phase 5. Setting use_ai=1
// (Phase 6) makes them call ai_call_with_system per scoring request.

// --------------------------------------------------------------------
// Util — shared string + genome helpers
// --------------------------------------------------------------------

class Util {
  method count_csv(csv) {
    if (str_len(csv) == 0) { reply(0); }
    else {
      var n = 1;
      var s = csv;
      var done = 0;
      while (done == 0) do {
        var c = str_index(s, ",");
        if (c < 0) {
          done = 1;
        } else {
          n = n + 1;
          s = str_sub(s, c + 1);
        }
      }
      reply(n);
    }
  }

  method nth_csv(csv, n) {
    var i = 0;
    var s = csv;
    while (i < n) do {
      var c = str_index(s, ",");
      if (c < 0) {
        s = "";
        i = n;
      } else {
        s = str_sub(s, c + 1);
        i = i + 1;
      }
    }
    var c2 = str_index(s, ",");
    if (c2 < 0) { reply(s); }
    else { reply(str_sub(s, 0, c2)); }
  }

  method axis_values(table, axis) {
    // table is "axis:v1,v2|axis:v1,v2|..."
    var key = axis + ":";
    var idx = str_index(table, key);
    if (idx < 0) { reply(""); }
    else {
      var start = idx + str_len(key);
      var rest = str_sub(table, start);
      var bar = str_index(rest, "|");
      if (bar < 0) { reply(rest); }
      else { reply(str_sub(rest, 0, bar)); }
    }
  }

  method get_axis(genome, axis) {
    var key = axis + "=";
    var idx = str_index(genome, key);
    if (idx < 0) { reply(""); }
    else {
      var start = idx + str_len(key);
      var rest = str_sub(genome, start);
      var bar = str_index(rest, "|");
      if (bar < 0) { reply(rest); }
      else { reply(str_sub(rest, 0, bar)); }
    }
  }

  method set_axis(genome, axis, value) {
    var key = axis + "=";
    var idx = str_index(genome, key);
    if (idx < 0) {
      if (str_len(genome) == 0) { reply(key + value); }
      else { reply(genome + "|" + key + value); }
    } else {
      var prefix = str_sub(genome, 0, idx);
      var after = idx + str_len(key);
      var rest = str_sub(genome, after);
      var bar = str_index(rest, "|");
      if (bar < 0) { reply(prefix + key + value); }
      else {
        var suffix = str_sub(rest, bar);
        reply(prefix + key + value + suffix);
      }
    }
  }

  // parse_score(s): scan s for the first decimal number 0.0..1.0 and
  // return it as a float. "75" / "0.75" / "score: 0.7 (good)" all work.
  // Calls digits.val(c) on a peer actor (no self-call).
  method parse_score(s, digits) {
    var n = str_len(s);
    var i = 0;
    var found = 0;
    var first_digit = -1;
    while (found == 0) do {
      if (i >= n) { found = 2; }
      else {
        var c = str_sub(s, i, i + 1);
        var d = now digits.val(c);
        if (d >= 0) {
          first_digit = d;
          found = 1;
        } else {
          i = i + 1;
        }
      }
    }
    if (found == 2) { reply(0.5); }
    else {
      var int_part = first_digit;
      i = i + 1;
      var done_int = 0;
      while (done_int == 0) do {
        if (i >= n) { done_int = 1; }
        else {
          var c2 = str_sub(s, i, i + 1);
          var d2 = now digits.val(c2);
          if (d2 >= 0) {
            int_part = int_part * 10 + d2;
            i = i + 1;
          } else { done_int = 1; }
        }
      }
      var frac = 0.0;
      var div = 1.0;
      if (i < n) {
        var dotc = str_sub(s, i, i + 1);
        if (dotc == ".") {
          i = i + 1;
          var done_frac = 0;
          while (done_frac == 0) do {
            if (i >= n) { done_frac = 1; }
            else {
              var c3 = str_sub(s, i, i + 1);
              var d3 = now digits.val(c3);
              if (d3 >= 0) {
                div = div * 10.0;
                frac = frac + (d3 + 0.0) / div;
                i = i + 1;
              } else { done_frac = 1; }
            }
          }
        }
      }
      var v = (int_part + 0.0) + frac;
      // Tolerate "75" meaning 75% (no decimal).
      if (v > 1.0) { v = v / 100.0; }
      if (v < 0.0) { v = 0.0; }
      if (v > 1.0) { v = 1.0; }
      reply(v);
    }
  }

  method is_coherent(genome) {
    var ok = 1;
    // rule 0: if paradigm="Functional" ⇒ …
    var a0_k = "paradigm=";
    var a0_i = str_index(genome, a0_k);
    var a0 = "";
    if (a0_i >= 0) {
      var a0_r = str_sub(genome, a0_i + str_len(a0_k));
      var a0_b = str_index(a0_r, "|");
      if (a0_b < 0) { a0 = a0_r; }
      else { a0 = str_sub(a0_r, 0, a0_b); }
    }

    if (a0 == "Functional") {
      var b0_k = "state_representation=";
      var b0_i = str_index(genome, b0_k);
      var b0 = "";
      if (b0_i >= 0) {
        var b0_r = str_sub(genome, b0_i + str_len(b0_k));
        var b0_b = str_index(b0_r, "|");
        if (b0_b < 0) { b0 = b0_r; }
        else { b0 = str_sub(b0_r, 0, b0_b); }
      }

      if (b0 != "") {
        var in_set = 0;
        if (b0 == "ADT") { in_set = 1; }
        if (b0 == "symbol_owned") { in_set = 1; }
        if (in_set == 0) { ok = 0; }
      }
    }
    // rule 1: if paradigm="FunctionalOOP" ⇒ …
    var a1_k = "paradigm=";
    var a1_i = str_index(genome, a1_k);
    var a1 = "";
    if (a1_i >= 0) {
      var a1_r = str_sub(genome, a1_i + str_len(a1_k));
      var a1_b = str_index(a1_r, "|");
      if (a1_b < 0) { a1 = a1_r; }
      else { a1 = str_sub(a1_r, 0, a1_b); }
    }

    if (a1 == "FunctionalOOP") {
      var b1_k = "state_representation=";
      var b1_i = str_index(genome, b1_k);
      var b1 = "";
      if (b1_i >= 0) {
        var b1_r = str_sub(genome, b1_i + str_len(b1_k));
        var b1_b = str_index(b1_r, "|");
        if (b1_b < 0) { b1 = b1_r; }
        else { b1 = str_sub(b1_r, 0, b1_b); }
      }

      if (b1 != "") {
        var in_set = 0;
        if (b1 == "ADT") { in_set = 1; }
        if (b1 == "symbol_owned") { in_set = 1; }
        if (in_set == 0) { ok = 0; }
      }
    }
    // rule 3: if paradigm="assembler" ⇒ …
    var a3_k = "paradigm=";
    var a3_i = str_index(genome, a3_k);
    var a3 = "";
    if (a3_i >= 0) {
      var a3_r = str_sub(genome, a3_i + str_len(a3_k));
      var a3_b = str_index(a3_r, "|");
      if (a3_b < 0) { a3 = a3_r; }
      else { a3 = str_sub(a3_r, 0, a3_b); }
    }

    if (a3 == "assembler") {
      var b3_k = "type_safety=";
      var b3_i = str_index(genome, b3_k);
      var b3 = "";
      if (b3_i >= 0) {
        var b3_r = str_sub(genome, b3_i + str_len(b3_k));
        var b3_b = str_index(b3_r, "|");
        if (b3_b < 0) { b3 = b3_r; }
        else { b3 = str_sub(b3_r, 0, b3_b); }
      }

      if (b3 != "") {
        if (b3 != "none") { ok = 0; }
      }
    }
    reply(ok);
  }
}

// --------------------------------------------------------------------
// DigitOps — peer actor for parse_score so Util can avoid self-call.
// --------------------------------------------------------------------

class DigitOps {
  method val(c) {
    if (c == "0") { reply(0); }
    else if (c == "1") { reply(1); }
    else if (c == "2") { reply(2); }
    else if (c == "3") { reply(3); }
    else if (c == "4") { reply(4); }
    else if (c == "5") { reply(5); }
    else if (c == "6") { reply(6); }
    else if (c == "7") { reply(7); }
    else if (c == "8") { reply(8); }
    else if (c == "9") { reply(9); }
    else { reply(-1); }
  }
}

// --------------------------------------------------------------------
// Worker — compound operations that orchestrate Util/Evaluator/Profiles.
// Lives in its own actor so its callers (e.g. Coordinator) can use `now`
// without re-entering themselves.
// --------------------------------------------------------------------

class Worker {
  var util = 0;
  var evaluator = 0;
  var profiles = 0;

  method init(u, e, p) {
    util = u;
    evaluator = e;
    profiles = p;
  }

  method compute_cell(genome, cell_axes_csv) {
    var n = now util.count_csv(cell_axes_csv);
    var i = 0;
    var out = "";
    while (i < n) do {
      var axis = now util.nth_csv(cell_axes_csv, i);
      var v = now util.get_axis(genome, axis);
      if (i == 0) { out = axis + "=" + v; }
      else { out = out + "|" + axis + "=" + v; }
      i = i + 1;
    }
    reply(out);
  }

  method compute_score(genome, task_csv) {
    var n = now util.count_csv(task_csv);
    var i = 0;
    var sum = 0.0;
    while (i < n) do {
      var task = now util.nth_csv(task_csv, i);
      var prof = now profiles.get(task);
      var s = now evaluator.score_for_task(genome, prof);
      sum = sum + s;
      i = i + 1;
    }
    var avg = sum;
    if (n > 0) { avg = sum / (n + 0.0); }
    reply(avg);
  }
}

// --------------------------------------------------------------------
// Generator — seed / mutate / crossover
// --------------------------------------------------------------------

class Generator {
  var util = 0;
  var axes_csv = "";
  var values_table = "";

  method init(u, axes, values) {
    util = u;
    axes_csv = axes;
    values_table = values;
  }

  // v4 (2026-05-17): seed / mutate / cross now rejection-sample on the
  // schema's coherence rules (via Util.is_coherent).  Up to 50 attempts;
  // on every retry exhausted, the last candidate is returned even if
  // incoherent, so the evolution never deadlocks on infeasible schemas.

  method seed() {
    var tries = 0;
    var g = "";
    var ok = 0;
    while (ok == 0) do {
      var n_axes = now util.count_csv(axes_csv);
      var i = 0;
      var cand = "";
      while (i < n_axes) do {
        var axis = now util.nth_csv(axes_csv, i);
        var vals = now util.axis_values(values_table, axis);
        var n_vals = now util.count_csv(vals);
        var v = now util.nth_csv(vals, random(n_vals));
        if (i == 0) { cand = axis + "=" + v; }
        else { cand = cand + "|" + axis + "=" + v; }
        i = i + 1;
      }
      g = cand;
      ok = now util.is_coherent(g);
      tries = tries + 1;
      if (tries >= 50) { ok = 1; }
    }
    reply(g);
  }

  method mutate(parent) {
    var tries = 0;
    var child = parent;
    var ok = 0;
    while (ok == 0) do {
      var n_axes = now util.count_csv(axes_csv);
      var idx = random(n_axes);
      var axis = now util.nth_csv(axes_csv, idx);
      var vals = now util.axis_values(values_table, axis);
      var n_vals = now util.count_csv(vals);
      var v = now util.nth_csv(vals, random(n_vals));
      var cand = now util.set_axis(parent, axis, v);
      child = cand;
      ok = now util.is_coherent(child);
      tries = tries + 1;
      if (tries >= 50) { ok = 1; }
    }
    reply(child);
  }

  method cross(a, b) {
    var tries = 0;
    var child = a;
    var ok = 0;
    while (ok == 0) do {
      var n_axes = now util.count_csv(axes_csv);
      var i = 0;
      var cand = "";
      while (i < n_axes) do {
        var axis = now util.nth_csv(axes_csv, i);
        var src = a;
        if (random(2) == 1) { src = b; }
        var v = now util.get_axis(src, axis);
        if (i == 0) { cand = axis + "=" + v; }
        else { cand = cand + "|" + axis + "=" + v; }
        i = i + 1;
      }
      child = cand;
      ok = now util.is_coherent(child);
      tries = tries + 1;
      if (tries >= 50) { ok = 1; }
    }
    reply(child);
  }
}

// --------------------------------------------------------------------
// Reviewer — one ai_call_with_system per score request (Phase 6),
//            deterministic scoring (Phase 5).
// --------------------------------------------------------------------

class Reviewer {
  var name = "";
  var persona = "";
  var use_ai = 0;
  var weight = 0.0;
  var util = 0;
  var digits = 0;

  method init(n, p, u, w, util_actor, digits_actor) {
    name = n;
    persona = p;
    use_ai = u;
    weight = w;
    util = util_actor;
    digits = digits_actor;
  }

  method score(genome, task_profile) {
    if (use_ai == 1) {
      var prompt = "評価対象の遺伝子: " + genome +
                   "\n理想プロファイル: " + task_profile +
                   "\n\nこのプロファイルに対する適合度を 0.0 から 1.0 の単一の decimal number で返してください。説明禁止。数値1つだけ。";
      var ai_text = ai_call_with_system(persona, prompt);
      var ai_score = now util.parse_score(ai_text, digits);
      reply(ai_score);
    } else {
    // Deterministic: fraction of profile axes the genome matches.
    var matches = 0;
    var total = 0;
    var rest = task_profile;
    while (str_len(rest) > 0) do {
      var bar = str_index(rest, "|");
      var pair = "";
      if (bar < 0) {
        pair = rest;
        rest = "";
      } else {
        pair = str_sub(rest, 0, bar);
        rest = str_sub(rest, bar + 1);
      }
      var eq = str_index(pair, "=");
      if (eq >= 0) {
        var axis = str_sub(pair, 0, eq);
        var want = str_sub(pair, eq + 1);
        var key = axis + "=";
        var gidx = str_index(genome, key);
        if (gidx >= 0) {
          var gstart = gidx + str_len(key);
          var grest = str_sub(genome, gstart);
          var gbar = str_index(grest, "|");
          var got = "";
          if (gbar < 0) { got = grest; }
          else { got = str_sub(grest, 0, gbar); }
          if (got == want) { matches = matches + 1; }
        }
        total = total + 1;
      }
    }
    var s = 0.0;
    if (total > 0) { s = (matches + 0.0) / (total + 0.0); }
    reply(s);
    }
  }

  method get_weight() { reply(weight); }
}

// --------------------------------------------------------------------
// Evaluator — fans out reviewer scoring with `future`, awaits, aggregates.
// The class is codegen'd with exactly n_reviewers slots (see
// aipl_codegen.py) so init() arity matches the bootstrap call for any N.
// --------------------------------------------------------------------

class Evaluator {
  var r1 = 0;
  var r2 = 0;
  var r3 = 0;
  var r4 = 0;
  var r5 = 0;
  var r6 = 0;
  var r7 = 0;

  method init(rev1, rev2, rev3, rev4, rev5, rev6, rev7) {
    r1 = rev1;
    r2 = rev2;
    r3 = rev3;
    r4 = rev4;
    r5 = rev5;
    r6 = rev6;
    r7 = rev7;
  }

  method score_for_task(genome, profile) {
    var f1 = future r1.score(genome, profile);
    var f2 = future r2.score(genome, profile);
    var f3 = future r3.score(genome, profile);
    var f4 = future r4.score(genome, profile);
    var f5 = future r5.score(genome, profile);
    var f6 = future r6.score(genome, profile);
    var f7 = future r7.score(genome, profile);
    var s1 = await(f1);
    var w1 = now r1.get_weight();
    var s2 = await(f2);
    var w2 = now r2.get_weight();
    var s3 = await(f3);
    var w3 = now r3.get_weight();
    var s4 = await(f4);
    var w4 = now r4.get_weight();
    var s5 = await(f5);
    var w5 = now r5.get_weight();
    var s6 = await(f6);
    var w6 = now r6.get_weight();
    var s7 = await(f7);
    var w7 = now r7.get_weight();
    var combined = s1 * w1 + s2 * w2 + s3 * w3 + s4 * w4 + s5 * w5 + s6 * w6 + s7 * w7;
    reply(combined);
  }
}

// --------------------------------------------------------------------
// EliteMap — cell -> champion id mapping with parallel arrays
// --------------------------------------------------------------------

class EliteMap {
  var cells = [];
  var ids = [];
  var scores = [];
  var genomes = [];

  method propose(cell, ind_id, genome, score) {
    var n = array_len(cells);
    var i = 0;
    var idx = -1;
    while (i < n) do {
      if (array_get(cells, i) == cell) {
        idx = i;
        i = n;
      } else {
        i = i + 1;
      }
    }
    if (idx < 0) {
      array_push(cells, cell);
      array_push(ids, ind_id);
      array_push(scores, score);
      array_push(genomes, genome);
      reply(1);
    } else {
      var existing = array_get(scores, idx);
      if (score > existing) {
        array_set(ids, idx, ind_id);
        array_set(scores, idx, score);
        array_set(genomes, idx, genome);
        reply(1);
      } else {
        reply(0);
      }
    }
  }

  method size() { reply(array_len(cells)); }

  method sample_random_genome() {
    var n = array_len(cells);
    if (n == 0) { reply(""); }
    else { reply(array_get(genomes, random(n))); }
  }

  method best_summary(top_k) {
    var n = array_len(cells);
    var i = 0;
    var out = "";
    while (i < n) do {
      var line = "  cell=" + array_get(cells, i) +
                 "  score=" + array_get(scores, i) +
                 "  id=" + array_get(ids, i);
      if (i == 0) { out = line; }
      else { out = out + "\n" + line; }
      i = i + 1;
    }
    reply(out);
  }
}

// --------------------------------------------------------------------
// Lineage — append-only individual record
// --------------------------------------------------------------------

class Lineage {
  var ids = [];
  var genomes = [];
  var parents = [];
  var scores = [];
  var generations = [];
  var operators = [];
  var cells = [];

  method add(id, genome, parent, score, gen, op, cell) {
    array_push(ids, id);
    array_push(genomes, genome);
    array_push(parents, parent);
    array_push(scores, score);
    array_push(generations, gen);
    array_push(operators, op);
    array_push(cells, cell);
    reply(array_len(ids));
  }

  method dump(path) {
    var n = array_len(ids);
    var i = 0;
    var out = "[\n";
    while (i < n) do {
      // score gets a trailing "0" so 0.0 stringifies to "0.00"
      // (Python runtime emits "0." which would be invalid JSON).
      var entry = "  {\"id\":\"" + array_get(ids, i) + "\"," +
                  "\"genome\":\"" + array_get(genomes, i) + "\"," +
                  "\"parent\":\"" + array_get(parents, i) + "\"," +
                  "\"score\":" + array_get(scores, i) + "0," +
                  "\"generation\":" + array_get(generations, i) + "," +
                  "\"operator\":\"" + array_get(operators, i) + "\"," +
                  "\"cell\":\"" + array_get(cells, i) + "\"}";
      if (i < n - 1) { out = out + entry + ",\n"; }
      else { out = out + entry + "\n"; }
      i = i + 1;
    }
    out = out + "]\n";
    write_file(path, out);
    reply(n);
  }
}

// --------------------------------------------------------------------
// TaskProfiles — embedded per-task ideal genome fragments
// --------------------------------------------------------------------

class TaskProfiles {
  // task profiles inlined into get(); no separate methods.

  method get(task_name) {
    if (task_name == "I1_FormulaBarSingle") { reply(""); }
    else if (task_name == "I2_InCellInput") { reply(""); }
    else if (task_name == "I3_KeyboardShortcut") { reply(""); }
    else if (task_name == "I4_DOMTableOverlay") { reply(""); }
    else if (task_name == "P1_BrowserParser") { reply(""); }
    else if (task_name == "P2_ServerParseEval") { reply(""); }
    else if (task_name == "P3_HybridLexClientParseServer") { reply(""); }
    else if (task_name == "P4_PreParseOnSubmit") { reply(""); }
    else if (task_name == "T1_OnKeystroke") { reply(""); }
    else if (task_name == "T2_OnCommit") { reply(""); }
    else if (task_name == "T3_ExplicitButton") { reply(""); }
    else if (task_name == "T4_DirtyFlagIdleCb") { reply(""); }
    else if (task_name == "C1_DepthLimit") { reply(""); }
    else if (task_name == "C2_TopologicalUpfront") { reply(""); }
    else if (task_name == "C3_MarkSweep") { reply(""); }
    else if (task_name == "C4_TarjanSCC") { reply(""); }
    else if (task_name == "E1_RedText") { reply(""); }
    else if (task_name == "E2_TooltipHover") { reply(""); }
    else if (task_name == "E3_LogPanel") { reply(""); }
    else if (task_name == "E4_BorderHighlight") { reply(""); }
    else if (task_name == "RoundCompat") { reply(""); }
    else if (task_name == "BackwardCompat") { reply(""); }
    else if (task_name == "TotalImplCost") { reply(""); }
    else if (task_name == "ExcelLikeUX") { reply(""); }
    else if (task_name == "ImplementabilityInOneSession") { reply(""); }
    else { reply(""); }
  }
}

// --------------------------------------------------------------------
// Coordinator — main loop
// --------------------------------------------------------------------

class Coordinator {
  var util = 0;
  var generator = 0;
  var evaluator = 0;
  var elite = 0;
  var lineage = 0;
  var profiles = 0;
  var worker = 0;

  var seed_count = 6;
  var generations = 8;
  var cell_axes_csv = "paradigm,effect_handling";
  var task_csv = "I1_FormulaBarSingle,I2_InCellInput,I3_KeyboardShortcut,I4_DOMTableOverlay,P1_BrowserParser,P2_ServerParseEval,P3_HybridLexClientParseServer,P4_PreParseOnSubmit,T1_OnKeystroke,T2_OnCommit,T3_ExplicitButton,T4_DirtyFlagIdleCb,C1_DepthLimit,C2_TopologicalUpfront,C3_MarkSweep,C4_TarjanSCC,E1_RedText,E2_TooltipHover,E3_LogPanel,E4_BorderHighlight,RoundCompat,BackwardCompat,TotalImplCost,ExcelLikeUX,ImplementabilityInOneSession";
  var next_id = 0;

  method init(u, g, e, em, lg, tp, w) {
    util = u;
    generator = g;
    evaluator = e;
    elite = em;
    lineage = lg;
    profiles = tp;
    worker = w;
  }

  method run() {
    print("=== AIPL_Spreadsheet_FormulaInput (AIPL — Actor-based Intelligent Parallel Language — orchestrator) ===");
    print("seed_count=" + seed_count + "  generations=" + generations);

    // Phase 1: seed
    var i = 0;
    while (i < seed_count) do {
      var g = now generator.seed();
      next_id = next_id + 1;
      var id = "I" + next_id;
      var cell = now worker.compute_cell(g, cell_axes_csv);
      var score = now worker.compute_score(g, task_csv);
      send lineage.add(id, g, "", score, 0, "seed", cell);
      send elite.propose(cell, id, g, score);
      i = i + 1;
    }
    print("[seed] elite cells filled: " + (now elite.size()));

    // Phase 2: evolution
    var gen = 1;
    while (gen <= generations) do {
      var parent = now elite.sample_random_genome();
      var size = now elite.size();
      var do_cross = 0;
      if (random(10) < 3) {
        if (size >= 2) { do_cross = 1; }
      }
      var child = "";
      var op = "";
      if (do_cross == 1) {
        var partner = now elite.sample_random_genome();
        child = now generator.cross(parent, partner);
        op = "uniform_crossover";
      } else {
        child = now generator.mutate(parent);
        op = "axis_resample";
      }
      next_id = next_id + 1;
      var cid = "I" + next_id;
      var ccell = now worker.compute_cell(child, cell_axes_csv);
      var cscore = now worker.compute_score(child, task_csv);
      send lineage.add(cid, child, "", cscore, gen, op, ccell);
      send elite.propose(ccell, cid, child, cscore);
      // crash-recovery: flush lineage every generation so silent SDK
      // hangs (cf. Pi_Phase1_OpenSearch v3 attempt 2026-05-16) do not
      // lose the partial result.  Cost: one fs write per generation.
      var ckpt_n = now lineage.dump("out/AIPL_Spreadsheet_FormulaInput.aipl_lineage.json");
      print("[ckpt gen=" + gen + "] flushed " + ckpt_n + " individuals");
      gen = gen + 1;
    }

    print("[done] cells filled: " + (now elite.size()));
    print(now elite.best_summary(5));

    var n = now lineage.dump("out/AIPL_Spreadsheet_FormulaInput.aipl_lineage.json");
    print("[lineage] wrote " + n + " individuals to out/AIPL_Spreadsheet_FormulaInput.aipl_lineage.json");
  }
}

// --------------------------------------------------------------------
// Bootstrap (top-level)
// --------------------------------------------------------------------

var util = new Util();
var digits = new DigitOps();
var generator = new Generator(util, "paradigm,state_representation,concurrency_model,type_safety,effect_handling,ownership_model", "paradigm:assembler,BASIC,C,Java_OOP,Functional,FunctionalOOP,ParallelOOP|state_representation:register_int,global_num,enum_state,ADT,symbol_owned|concurrency_model:none,threads_locks,actor_messages,csp_channels,structured|type_safety:none,low,medium,high,dependent|effect_handling:implicit,monadic,algebraic_effects,capability|ownership_model:none,gc,rc,borrow_check,linear");
var elite = new EliteMap();
var lineage = new Lineage();
var profiles = new TaskProfiles();

var rev1 = new Reviewer("PinnedRound3Reviewer", "あなたは round 1-3 pinning レビュアーです.既決定 10 軸 (T4/C1/S1/U2 + CA4/FE4/P3/R3/PA4/IT2) に矛盾しない 5-tuple を高評価.特に I4 DOMTableOverlay は U2 Canvas を投げ捨てるので penalty -0.3.1.0 = 完全整合、0.0 = 矛盾.1 行で返答.", 0, 0.14285714285714285, util, digits);
var rev2 = new Reviewer("InputUXReviewer", "あなたは入力 UX レビュアーです.I1 formula bar / I2 in-cell input / I3 F2 shortcut / I4 DOM table のうち、Excel/Sheets ユーザの mental model に最も合うものを高評価.MVP では simplicity > completeness.1.0 = 直感的、0.7 = ok、0.3 = 違和感、0.0 = 不適.1 行で返答.", 0, 0.14285714285714285, util, digits);
var rev3 = new Reviewer("ParserLocationReviewer", "あなたは parse 場所レビュアーです.既存 self-host Level-C parser + Py-I StringFormulaSheet の PA4 parser がそのまま使えるか.P1 browser inline / P2 server / P3 hybrid / P4 pre-parse-on-submit のうち、既存資産の再利用が最大の variant を高評価.1.0 = 既存 parser 完全再利用、0.7 = 多少修正、0.3 = 部分新規、0.0 = 完全新規.1 行で返答.", 0, 0.14285714285714285, util, digits);
var rev4 = new Reviewer("RecomputeUXReviewer", "あなたは再計算 UX レビュアーです.T1 onKeystroke / T2 onCommit / T3 button / T4 dirty-flag のうち、Excel-like UX と performance のバランスが最良.1.0 = ベスト UX、0.7 = ok、0.3 = いまいち、0.0 = 不適.1 行で返答.", 0, 0.14285714285714285, util, digits);
var rev5 = new Reviewer("CycleDetectionReviewer", "あなたは cycle 検出設計レビュアーです.C1 depth-limit / C2 topological / C3 mark-sweep / C4 Tarjan-SCC のうち、AIPL actor model での実装容易性 + ユーザへの情報量のバランスが良い variant.1.0 = ベスト、0.7 = 良、0.3 = 妥協、0.0 = 不適.1 行で返答.", 0, 0.14285714285714285, util, digits);
var rev6 = new Reviewer("ImplCostEstimator", "あなたは実装コスト見積もりレビュアーです.選ばれた 5-tuple 合計 LOC 増分.先行 round-3 が +900 LOC で 5 phase 完了したことを踏まえる.1.0 = ≤300、0.7 = ≤500、0.3 = ≤800、0.0 = >800.1 行で返答.", 0, 0.14285714285714285, util, digits);
var rev7 = new Reviewer("BackwardCompatReviewer", "あなたは後方互換レビュアーです.既存 27 spreadsheet smoke + 30 Py-I nextgen + 47 self-host + 14 JS nextgen + 71 abclc が無修正で動作するか.全て opt-in (新 dir / 新 endpoint / 新 URL query) で発火.1.0 = 完全 opt-in、0.7 = 1-2 軽微、0.3 = 多数影響、0.0 = 致命的.1 行で返答.", 0, 0.14285714285714285, util, digits);
var eval_actor = new Evaluator(rev1, rev2, rev3, rev4, rev5, rev6, rev7);
var worker = new Worker(util, eval_actor, profiles);
var coord = new Coordinator(util, generator, eval_actor, elite, lineage, profiles, worker);
send coord.run();
