// AIPL_DroneMANET_Round1.aice  (2026-06-04)
//
// 種: ~/projects/drone-hil の HIL 共シミュレーション (M-006 災害避難 UAV ×
//   実機 Xinu WiFi MANET) で、現在のルーティング層は
//   「リアクティブ AODV (RREQ 再探索 + 経路キャッシュ + リンク切断修復) +
//    レンジ枝刈り (R=0.30) + partition 時はメッセージを drop (buffering ログのみ)」。
//
//   実機側: Pi4 (10.0.0.1) ↔ Pi3 (10.0.0.2) ad-hoc、Pi5 は 3 台目で電源待ち。
//   sim 側: UAV1/UAV2 + リレー R1/R2/R3 + 地上局 GS、レンジ円で動的リンク。
//
//   この Round 1 では「実装の取捨選択」ではなく、MANET/DTN ルーティング設計の
//   設計空間を MAP-Elites で探索し、現行 AODV からどの方向に進化させると
//   山間部・高モビリティ・分断多発・組込み実機制約という固有条件で報われるかを
//   reviewer (MANET 研究者 / Xinu 実機エンジニア / 災害対応オペレータ) の
//   スコアで明らかにする (= design topology check)。
//
//   gene schema は MANET 専用 (manet_routing.schema.json):
//     routing_protocol / buffering_strategy / link_metric /
//     topology_control / mobility_handling / neighbor_discovery / qos_priority

aice AIPL_DroneMANET_Round1 {
  dialect = "aice_evolution_v2";

  task = "drone-hil の現行 MANET 層 (reactive_AODV + range_pruning + hop_count + link_break_detect + on_demand 近傍探索 + sos_priority + partition 時 drop) を seed に、山間部災害避難 UAV スウォーム (M-006) を実機 Xinu+Raspberry-Pi WiFi メッシュ上で運用するという固有条件 — 頻繁なネットワーク分断・UAV の高モビリティ・限られた RAM/CPU/WiFi・SOS フレームの低遅延要求・バッテリ制約 — の下で報われるルーティング設計を MAP-Elites で探索する。各個体は 7 軸の遺伝子 (routing_protocol/buffering_strategy/link_metric/topology_control/mobility_handling/neighbor_discovery/qos_priority) で、reviewer が各評価シナリオへの suitability を 0..1 で採点する。cell_axes=routing_protocol でプロトコル族ごとのベスト設計を archive する。";

  gene_schema = "../../../aice-evolution-v2/schemas/manet_routing.schema.json";

  seed_from {
    base       = "~/projects/drone-hil/index.html (MANET communication layer block)";
    current    = "routing_protocol=reactive_AODV, buffering_strategy=drop_on_partition, link_metric=hop_count, topology_control=range_pruning, mobility_handling=link_break_detect, neighbor_discovery=on_demand, qos_priority=sos_priority";
    hardware   = "Pi4 10.0.0.1 + Pi3 10.0.0.2 ad-hoc (BCM43455), Xinu kernel, Pi5 3 台目は電源待ち";
    references = ["[1] Katayama 2019 (Multi-UAV evacuation)",
                  "[2] Perkins/Royer 2003 (AODV RFC3561)",
                  "[3] Clausen/Jacquet 2003 (OLSR RFC3626)",
                  "[4] Fall 2003 (DTN architecture)",
                  "[5] Spyropoulos 2005 (Spray and Wait)",
                  "[6] Karp/Kung 2000 (GPSR geographic routing)"];
    constants  = "range R=0.30 (正規化座標), relays R1/R2/R3, GS=避難所A";
  }

  // ─── 評価シナリオ (= reviewer が genome を採点する固有条件) ──────
  // 注: AI evaluator は task 名 + persona で genome の suitability を採点する。
  //     spec/acceptance は人間向けドキュメント。
  evaluation_tasks {

    task PartitionTolerance {
      spec = "山間部で UAV が稜線の影に入ると地上局・他機とのリンクが頻繁に分断される。分断をまたいでメッセージ (探索結果・救助指示・SOS) を確実に配送できるか。partition が常態である環境での配送率。";
      weight = 0.20;
      acceptance = "分断後の再接続でバッファ済みメッセージが配送される。drop_on_partition は低評価、store-carry-forward / custody / replicate は高評価。";
    }

    task HighMobilityResilience {
      spec = "UAV は高速移動しリンクの生成・切断が秒単位で起きる。リンク切断を素早く検知し経路を再構成、あるいはモビリティ予測で先回りできるか。経路の安定性と再収束時間。";
      weight = 0.18;
      acceptance = "link_break_detect 以上が必要。predictive_mobility / trajectory_aware は高評価。proactive な定期 hello は陳腐化が速い環境では割り引く。";
    }

    task SwarmScalability {
      spec = "UAV を 2 機から N 機 + リレー + 地上局へ増やしたときの制御トラフィックと経路探索オーバーヘッドのスケール性。フラッディングの爆発、proactive テーブルの肥大を避けられるか。";
      weight = 0.15;
      acceptance = "gossip_flood / 無制御 proactive は N で劣化。clustering / backbone_cds / adaptive_rate_hello はスケール性に寄与。";
    }

    task EmbeddedFeasibility {
      spec = "Xinu カーネル + Raspberry Pi3/Pi4 の限られた RAM/CPU/WiFi (BCM43455) で実装・常駐できるか。複雑な状態保持・大きなバッファ・重い計算は実機で破綻する。実装の現実性。";
      weight = 0.17;
      acceptance = "reactive_AODV / 単純な hop_count / range_pruning は実装が軽い。replicate_n_copies の大量バッファ・etx 計測・backbone_cds 維持は実機では重く割り引く。";
    }

    task SOSLatency {
      spec = "被災者からの SOS / 高優先度フレームを最小遅延で地上局へ届ける。QoS による優先制御と、低遅延を優先するリンク選択ができるか。";
      weight = 0.13;
      acceptance = "qos_priority=sos_priority 以上 + rtt_latency / hop_count 指標が低遅延に寄与。custody_transfer は遅延が増えるので SOS には不利。";
    }

    task EnergyEfficiency {
      spec = "UAV はバッテリ駆動。制御トラフィック・送信電力・常時 beacon が電池を食う。省電力なルーティングと近傍探索ができるか。";
      weight = 0.10;
      acceptance = "energy_aware 指標 / power_control / beaconless / on_demand は省電力。periodic_hello の高頻度・replicate の冗長送信は電力を食う。";
    }

    task AODVCompatibility {
      spec = "現行 sim の RREQ/RREP 可視化・経路キャッシュ・リンク切断修復という挙動と互換に進化できるか (回帰の床)。完全に別パラダイムへ飛ぶと既存可視化・実機ブリッジを作り直す必要がある。";
      weight = 0.07;
      acceptance = "reactive_AODV / hybrid_ZRP (reactive 成分あり) は互換性が高い。純 proactive / 純 DTN / geographic は既存 RREQ 可視化と乖離。";
    }
  }

  // ─── reviewer (LLM persona) ──────────────────────────────────
  reviewers {
    reviewer manet_researcher {
      persona = "あなたは MANET/DTN ルーティングプロトコルの研究者です。AODV/OLSR/ZRP/GPSR/epidemic/spray-and-wait の理論的性質と既知の性能特性 (収束時間・オーバーヘッド・配送率・遅延) を踏まえ、与えられた遺伝子 (プロトコル設計の組合せ) が指定タスクにどれだけ適合するかを 0.0〜1.0 で厳密に採点します。説明は不要、数値1つだけ返します。";
      weight = 0.34;
    }
    reviewer embedded_engineer {
      persona = "あなたは Xinu カーネルと Raspberry Pi (BCM43455 WiFi) で MANET を実装してきた組込みシステムエンジニアです。限られた RAM/CPU/フラッシュ・WiFi ドライバの制約・実装と保守のコストという現実の視点で、与えられた遺伝子が実機で動かせるか・実装が軽いかを重視して 0.0〜1.0 で採点します。数値1つだけ返します。";
      weight = 0.33;
    }
    reviewer rescue_operator {
      persona = "あなたは山間部災害の避難支援を指揮する現場オペレータです。被災者の救助率・SOS の到達遅延・分断/高モビリティ下での運用堅牢性という実運用の視点で、与えられた遺伝子が現場で頼れるかを 0.0〜1.0 で採点します。数値1つだけ返します。";
      weight = 0.33;
    }
  }

  // ─── 探索設定 (MAP-Elites) ───────────────────────────────────
  search {
    algorithm   = "map_elites";
    cell_axes   = "routing_protocol";   // プロトコル族ごとにベスト設計を保持 → 多様な frontier
    seed_count  = 5;
    generations = 15;
    open_axes   = false;                // 専用 7 軸が設計空間を十分に張る。新軸 LLM 提案はしない (Round 1)
    rng_seed    = 42;
  }

  evaluator = "ai_v1";

  // ─── 最終目標 ─────────────────────────────────────────────────
  goal = "Round 1 完了で、(a) routing_protocol 8 族それぞれのベスト設計 (archive) と composite、(b) conservative/innovative/general_purpose 3 シナリオでの #1 設計、(c) 軸ごとの trend vector (現行 AODV からどちらへ進化すると報われるか)、(d) 現 drone-hil 実装との突合せと「次に実装すべき MANET 進化方向」を得る。特に partition tolerance (DTN buffering) と embedded feasibility のトレードオフ frontier を可視化する。";
}
