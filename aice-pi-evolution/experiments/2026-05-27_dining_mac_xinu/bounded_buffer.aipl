// bounded_buffer.aipl — the classic bounded-buffer (producer / consumer)
// problem, self-contained in Py-I actors for the browser dashboard.
//
// One Buffer actor owns a fixed-capacity ring of slots.  Because an actor
// processes its mailbox one message at a time, the Buffer needs no extra
// lock — message order *is* the mutual exclusion.  Producers that find the
// buffer full are refused and back off (back-pressure); consumers that find
// it empty are told to wait.  Once every producer has finished and the
// buffer drains, the remaining consumers are told it is closed and stop.
//
// Pi-free: every actor is a local Py-I actor, so it runs straight from the
// dashboard with no Raspberry Pi.  Producers run a little faster than the
// consumers, so the buffer fills up and the "full" back-pressure is visible.

class Buffer {
  var cap            = 20;
  var count          = 0;
  var head           = 0;     // next slot to read
  var tail           = 0;     // next slot to write
  var producers_left = 2;     // decremented as producers finish
  var slots[20];              // ring storage (0 marks an empty slot)

  method put(pid, item) {
    if (count < cap) {
      slots[tail] = item;
      tail = tail + 1;
      if (tail >= cap) { tail = 0; }
      count = count + 1;
      print("Buffer  <- " ++ item ++ "   (from P" ++ pid ++ ", now " ++ count ++ "/" ++ cap ++ ")");
      send sender.stored(item);
    } else {
      send sender.refused(item);
    }
  }

  method get(cid) {
    if (count > 0) {
      var v = slots[head];
      slots[head] = 0;
      head = head + 1;
      if (head >= cap) { head = 0; }
      count = count - 1;
      print("Buffer  -> " ++ v ++ "   (to C" ++ cid ++ ", now " ++ count ++ "/" ++ cap ++ ")");
      send sender.received(v);
    } else {
      if (producers_left <= 0) {
        send sender.closed();
      } else {
        send sender.empty();
      }
    }
  }

  method producer_done() {
    producers_left = producers_left - 1;
    print("Buffer  a producer finished (" ++ producers_left ++ " still producing)");
  }
}

class Producer {
  var id     = 0;
  var made   = 0;
  var target = 80;       // items this producer makes before it stops
  var buf    = 0;
  var delay  = 0.3;      // seconds between items — set live from the dashboard slider
  var status = "idle";

  method init(i, b, t) {
    id = i; buf = b; target = t; made = 0; status = "producing";
    send self.step();
  }
  method step() {
    if (made >= target) {
      status = "done";
      print("P" ++ id ++ " produced all " ++ made ++ " items (terminating)");
      send buf.producer_done();
      suicide();
    } else {
      status = "producing";
      var item = id * 100 + made + 1;
      send buf.put(id, item);
    }
  }
  method stored(item) {
    made = made + 1;
    status = "producing";
    print("P" ++ id ++ " produced " ++ item ++ "   (" ++ made ++ "/" ++ target ++ ")");
    sleep(delay);
    send self.step();
  }
  method refused(item) {
    status = "blocked (full)";
    print("P" ++ id ++ " blocked: buffer full, will retry " ++ item);
    sleep(0.25);
    send self.step();
  }
}

class Consumer {
  var id      = 0;
  var got     = 0;
  var buf     = 0;
  var delay   = 0.5;     // seconds to consume each item — set live from the slider
  var status  = "idle";

  method init(i, b) {
    id = i; buf = b; got = 0; status = "consuming";
    send self.step();
  }
  method step() {
    status = "consuming";
    send buf.get(id);
  }
  method received(v) {
    got = got + 1;
    status = "consuming";
    print("C" ++ id ++ " consumed " ++ v ++ "   (total " ++ got ++ ")");
    sleep(delay);
    send self.step();
  }
  method empty() {
    status = "waiting (empty)";
    print("C" ++ id ++ " waiting: buffer empty");
    sleep(0.25);
    send self.step();
  }
  method closed() {
    status = "done";
    print("C" ++ id ++ " done after " ++ got ++ " items (buffer closed, terminating)");
    suicide();
  }
}

var buf = new Buffer();

// two producers (80 items each) and two consumers sharing one bounded buffer.
var p1 = new Producer(1, buf, 80);
var p2 = new Producer(2, buf, 80);
var c1 = new Consumer(1, buf);
var c2 = new Consumer(2, buf);
