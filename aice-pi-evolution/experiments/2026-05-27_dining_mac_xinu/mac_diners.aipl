// mac_diners.aipl
// Distributed 5-philosopher dining — STATIC remote variant.
//
//   Mac  (this file, Py-I)      : P1 / P2 / P3   — 3 AIPL actors
//   Xinu (apps/abcl_program.c)  : F0..F4 (Forks) + P4 / P5
//
// "Static" = it uses the Fork/Philosopher classes already linked into the
// Xinu kernel image; unlike dine_dynamic.aipl it does NOT ship + compile the
// source first.  It still RESETs + SPAWNs the actors so it runs on a freshly
// (empty) booted Xinu and can be re-run without rebooting.
//
// All five Forks live on Xinu (ids 0..4), so the local Xinu philosophers
// (P4/P5) and the remote Mac philosophers (P1/P2/P3, via uart1:// RPC)
// contend for the same Fork actors — mutual exclusion holds across the
// Mac/Xinu boundary because each Fork serialises its own mailbox.
//
// Ring (each fork shared by two philosophers); deadlock-free by taking the
// lower-numbered fork first:
//   P1: F0,F4   P2: F0,F1   P3: F1,F2   P4: F2,F3 (Xinu)   P5: F3,F4 (Xinu)

var hub = "uart1://192.168.3.50:5555";

print("=== static distributed diners: 3 Mac + 2 Xinu (pre-linked, no dynamic compile) ===");
// Reset the Xinu actor table so forks deterministically get ids 0..4 and the
// program can be re-run without rebooting the Pi.
print("Xinu RESET -> " + remote_now(hub, "_", "reset"));
print("spawning forks F0..F4 -> ids "
      + remote_now(hub, "_", "spawn", "Fork") + " "
      + remote_now(hub, "_", "spawn", "Fork") + " "
      + remote_now(hub, "_", "spawn", "Fork") + " "
      + remote_now(hub, "_", "spawn", "Fork") + " "
      + remote_now(hub, "_", "spawn", "Fork"));
print("spawning Xinu P4 -> id " + remote_now(hub, "_", "spawn", "Philosopher", 4, "ref:2", "ref:3"));
print("spawning Xinu P5 -> id " + remote_now(hub, "_", "spawn", "Philosopher", 5, "ref:3", "ref:4"));
print("Xinu actors -> " + remote_now(hub, "_", "list"));

class Philosopher {
  var my_id        = 0;
  var lo_fork      = "0";   // string Xinu actor id "0".."4"
  var hi_fork      = "0";
  var meals_target = 50;
  var meals_done   = 0;
  var attempts     = 0;
  var hub          = "uart1://192.168.3.50:5555";

  method init(pid, lo, hi, target) {
    my_id = pid; lo_fork = lo; hi_fork = hi; meals_target = target;
    meals_done = 0; attempts = 0;
    print("  [P" + my_id + "] thinking (low=F" + lo_fork + " high=F" + hi_fork + ")");
    send self.try_eat();
  }

  method try_eat() {
    if (meals_done >= meals_target) {
      print("  [P" + my_id + "] DONE after " + attempts + " attempts (terminating)");
      suicide();
    } else {
      attempts = attempts + 1;
      remote_call(hub, lo_fork, "acquire", my_id);
      sleep(0.025);
      var hlo = remote_now(hub, lo_fork, "field", 0);
      if (hlo != my_id) {
        sleep(0.030);
        send self.try_eat();
      } else {
        remote_call(hub, hi_fork, "acquire", my_id);
        sleep(0.025);
        var hhi = remote_now(hub, hi_fork, "field", 0);
        if (hhi != my_id) {
          remote_call(hub, lo_fork, "release", my_id);
          sleep(0.030);
          send self.try_eat();
        } else {
          sleep(0.150);
          meals_done = meals_done + 1;
          print("  [P" + my_id + " ATE meal=" + meals_done + "] (attempts=" + attempts + ")");
          sleep(0.040);
          remote_call(hub, hi_fork, "release", my_id);
          remote_call(hub, lo_fork, "release", my_id);
          sleep(0.010);
          send self.try_eat();
        }
      }
    }
  }
}

print("--- launching 3 Mac philosophers (50 meals each) ---");
var p1 = new Philosopher(1, "0", "4", 50);
var p2 = new Philosopher(2, "0", "1", 50);
var p3 = new Philosopher(3, "1", "2", 50);
