// ring_demo.aipl — a self-contained token-ring of 4 local actors (Py-I).
// Each node passes a token to the next, incrementing a hop counter, and
// narrates via print().  A second Pi-free program so the dashboard's
// program switcher has more than one local option to flip between.

class Node {
  var id    = 0;
  var next  = 0;
  var hops  = 0;
  var holds = 0;       // 1 while this node holds the token

  method init(i) { id = i; hops = 0; holds = 0; }
  method link(n) { next = n; }
  method token(count) {
    holds = 1;
    hops = count;
    print("Node " ++ id ++ " holds the token (hop " ++ count ++ ")");
    sleep(0.4);
    holds = 0;
    send next.token(count + 1);
  }
}

var n0 = new Node(0);
var n1 = new Node(1);
var n2 = new Node(2);
var n3 = new Node(3);
send n0.link(n1);
send n1.link(n2);
send n2.link(n3);
send n3.link(n0);
// inject the token
send n0.token(1);
