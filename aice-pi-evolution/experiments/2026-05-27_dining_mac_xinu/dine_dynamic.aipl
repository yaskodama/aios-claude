// dine_dynamic.aipl
// Distributed 5-philosopher dining with DYNAMIC code delivery + compilation.
//
//   Xinu (real Pi3) boots with ZERO dining source/actors.
//   This Mac program, at run time:
//     1. ships the Fork+Philosopher AIPL *source* to Xinu (LOAD) and has
//        Xinu DYNAMICALLY COMPILE it with its in-kernel toolchain
//        (abclc AIPL->C, then cc C->a.out) and RUN it — proving the source
//        was sent and compiled on the bare Xinu node.
//     2. SPAWNs the live actors over the same RPC link: 5 Forks (ids 0..4)
//        and the 2 Xinu Philosophers P4 (id5) / P5 (id6).
//     3. runs the 3 Mac philosophers (P1/P2/P3), which contend for the very
//        same Xinu Fork actors -> the full 5-philosopher problem, correctly
//        synchronised across the Mac/Xinu boundary.
//
// Transport: uart1://192.168.3.50:5555 -> Xinu ethernet AIPL-RPC server
// (apps/abcl_xinu_rpc.c).  remote_call/remote_now map to the line protocol:
//   load    -> "LOAD <name> <len>\n<body>"   (ship source to /home/<name>.aipl)
//   compile -> "COMPILE <name>"              (abclcTranslate + ccCompile)
//   run     -> "RUN <name>"                  (aoutRun)
//   spawn   -> "SPAWN <Class> [args]"        (instantiate a linked class)

var hub = "uart1://192.168.3.50:5555";

// The dining SOURCE we ship to the empty Xinu.  One line (abclc tokenises on
// whitespace) and free of print/string literals so the in-kernel cc accepts
// it.  Fork = the shared resource; Philosopher = the diner skeleton.
var dine_src = "class Fork { var holder; method acquire(pid) { if (holder == 0) { holder = pid; } } method release(pid) { if (holder == pid) { holder = 0; } } } class Philosopher { var id; var lo; var hi; var state; method seat(a, b, c) { id = a; lo = b; hi = c; state = 0; } method eat() { state = 1; } method done() { state = 2; } } main { new Fork f; new Philosopher p; send f.acquire(1); send p.eat(); }";

print("=== dynamic distributed diners: ship source -> compile on Xinu -> spawn -> dine ===");
// Reset the Xinu actor table first so this run starts from a clean slate
// (forks deterministically get ids 0..4), allowing repeated runs without
// rebooting the Pi.
print("Xinu RESET -> " ++ remote_now(hub, "_", "reset"));
print("Xinu actors BEFORE (expect 0): " ++ remote_now(hub, "_", "list"));

// --- 1. dynamic code delivery + compilation on the bare Xinu node ---
print("shipping " ++ str_len(dine_src) ++ " bytes of Fork/Philosopher source to Xinu...");
remote_call(hub, "_", "load", "dine", str_len(dine_src), dine_src);
print("Xinu COMPILE  -> " ++ remote_now(hub, "_", "compile", "dine"));
print("Xinu RUN      -> " ++ remote_now(hub, "_", "run", "dine"));

// --- 2. spawn the live actors over RPC (ids are deterministic from empty) ---
print("spawning forks F0..F4 -> ids "
      ++ remote_now(hub, "_", "spawn", "Fork") ++ " "
      ++ remote_now(hub, "_", "spawn", "Fork") ++ " "
      ++ remote_now(hub, "_", "spawn", "Fork") ++ " "
      ++ remote_now(hub, "_", "spawn", "Fork") ++ " "
      ++ remote_now(hub, "_", "spawn", "Fork"));
print("spawning Xinu P4 -> id " ++ remote_now(hub, "_", "spawn", "Philosopher", 4, "ref:2", "ref:3"));
print("spawning Xinu P5 -> id " ++ remote_now(hub, "_", "spawn", "Philosopher", 5, "ref:3", "ref:4"));
print("Xinu actors AFTER spawn: " ++ remote_now(hub, "_", "list"));

// --- 3. the 3 Mac philosophers join the now-live table ---
class Philosopher {
  var my_id        = 0;
  var lo_fork      = "0";
  var hi_fork      = "0";
  var meals_target = 50;
  var meals_done   = 0;
  var attempts     = 0;
  var hub          = "uart1://192.168.3.50:5555";

  method init(pid, lo, hi, target) {
    my_id = pid; lo_fork = lo; hi_fork = hi; meals_target = target;
    meals_done = 0; attempts = 0;
    print("  [P" ++ my_id ++ "] thinking (low=F" ++ lo_fork ++ " high=F" ++ hi_fork ++ ")");
    send self.try_eat();
  }

  method try_eat() {
    if (meals_done >= meals_target) {
      print("  [P" ++ my_id ++ "] DONE after " ++ attempts ++ " attempts (terminating)");
      suicide();
    } else {
      attempts = attempts + 1;
      remote_call(hub, lo_fork, "acquire", my_id);
      sleep(0.025);
      var hlo = remote_now(hub, lo_fork, "field", 0);
      if (hlo != my_id) {
        sleep(0.030);
        send self.try_eat();
      } else {
        remote_call(hub, hi_fork, "acquire", my_id);
        sleep(0.025);
        var hhi = remote_now(hub, hi_fork, "field", 0);
        if (hhi != my_id) {
          remote_call(hub, lo_fork, "release", my_id);
          sleep(0.030);
          send self.try_eat();
        } else {
          sleep(0.150);
          meals_done = meals_done + 1;
          print("  [P" ++ my_id ++ " ATE meal=" ++ meals_done ++ "] (attempts=" ++ attempts ++ ")");
          sleep(0.040);
          remote_call(hub, hi_fork, "release", my_id);
          remote_call(hub, lo_fork, "release", my_id);
          sleep(0.010);
          send self.try_eat();
        }
      }
    }
  }
}

print("--- launching 3 Mac philosophers ---");
var p1 = new Philosopher(1, "0", "4", 50);
var p2 = new Philosopher(2, "0", "1", 50);
var p3 = new Philosopher(3, "1", "2", 50);
