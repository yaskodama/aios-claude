// Generated by aice-evolution-v2/src/aipl_codegen.py from LangDesign_Expressive
// Pipeline: seed (random genome per axis) -> evolve via mutate/cross
// -> per-task scoring across reviewers -> elite map per cell
// -> dump lineage as JSON for the Python report pipeline.
//
// Run:
//   AIPL_AI_PROVIDER=mock /usr/bin/python3 src/python-aipl/aipl_main.py LangDesign_Expressive.aipl
//
// Reviewers compute deterministic scores in Phase 5. Setting use_ai=1
// (Phase 6) makes them call ai_call_with_system per scoring request.

// --------------------------------------------------------------------
// Util — shared string + genome helpers
// --------------------------------------------------------------------

class Util {
  method count_csv(csv) {
    if (str_len(csv) == 0) { reply(0); }
    else {
      var n = 1;
      var s = csv;
      var done = 0;
      while (done == 0) do {
        var c = str_index(s, ",");
        if (c < 0) {
          done = 1;
        } else {
          n = n + 1;
          s = str_sub(s, c + 1);
        }
      }
      reply(n);
    }
  }

  method nth_csv(csv, n) {
    var i = 0;
    var s = csv;
    while (i < n) do {
      var c = str_index(s, ",");
      if (c < 0) {
        s = "";
        i = n;
      } else {
        s = str_sub(s, c + 1);
        i = i + 1;
      }
    }
    var c2 = str_index(s, ",");
    if (c2 < 0) { reply(s); }
    else { reply(str_sub(s, 0, c2)); }
  }

  method axis_values(table, axis) {
    // table is "axis:v1,v2|axis:v1,v2|..."
    var key = axis ++ ":";
    var idx = str_index(table, key);
    if (idx < 0) { reply(""); }
    else {
      var start = idx + str_len(key);
      var rest = str_sub(table, start);
      var bar = str_index(rest, "|");
      if (bar < 0) { reply(rest); }
      else { reply(str_sub(rest, 0, bar)); }
    }
  }

  method get_axis(genome, axis) {
    var key = axis ++ "=";
    var idx = str_index(genome, key);
    if (idx < 0) { reply(""); }
    else {
      var start = idx + str_len(key);
      var rest = str_sub(genome, start);
      var bar = str_index(rest, "|");
      if (bar < 0) { reply(rest); }
      else { reply(str_sub(rest, 0, bar)); }
    }
  }

  method set_axis(genome, axis, value) {
    var key = axis ++ "=";
    var idx = str_index(genome, key);
    if (idx < 0) {
      if (str_len(genome) == 0) { reply(key + value); }
      else { reply(genome ++ "|" ++ key ++ value); }
    } else {
      var prefix = str_sub(genome, 0, idx);
      var after = idx + str_len(key);
      var rest = str_sub(genome, after);
      var bar = str_index(rest, "|");
      if (bar < 0) { reply(prefix + key + value); }
      else {
        var suffix = str_sub(rest, bar);
        reply(prefix + key + value + suffix);
      }
    }
  }

  // parse_score(s): scan s for the first decimal number 0.0..1.0 and
  // return it as a float. "75" / "0.75" / "score: 0.7 (good)" all work.
  // Calls digits.val(c) on a peer actor (no self-call).
  method parse_score(s, digits) {
    var n = str_len(s);
    var i = 0;
    var found = 0;
    var first_digit = -1;
    while (found == 0) do {
      if (i >= n) { found = 2; }
      else {
        var c = str_sub(s, i, i + 1);
        var d = now digits.val(c) timeout 5000 else 0;
        if (d >= 0) {
          first_digit = d;
          found = 1;
        } else {
          i = i + 1;
        }
      }
    }
    if (found == 2) { reply(0.5); }
    else {
      var int_part = first_digit;
      i = i + 1;
      var done_int = 0;
      while (done_int == 0) do {
        if (i >= n) { done_int = 1; }
        else {
          var c2 = str_sub(s, i, i + 1);
          var d2 = now digits.val(c2) timeout 5000 else 0;
          if (d2 >= 0) {
            int_part = int_part * 10 + d2;
            i = i + 1;
          } else { done_int = 1; }
        }
      }
      var frac = 0.0;
      var div = 1.0;
      if (i < n) {
        var dotc = str_sub(s, i, i + 1);
        if (dotc == ".") {
          i = i + 1;
          var done_frac = 0;
          while (done_frac == 0) do {
            if (i >= n) { done_frac = 1; }
            else {
              var c3 = str_sub(s, i, i + 1);
              var d3 = now digits.val(c3) timeout 5000 else 0;
              if (d3 >= 0) {
                div = div * 10.0;
                frac = frac + (d3 + 0.0) / div;
                i = i + 1;
              } else { done_frac = 1; }
            }
          }
        }
      }
      var v = (int_part + 0.0) + frac;
      // Tolerate "75" meaning 75% (no decimal).
      if (v > 1.0) { v = v / 100.0; }
      if (v < 0.0) { v = 0.0; }
      if (v > 1.0) { v = 1.0; }
      reply(v);
    }
  }
}

// --------------------------------------------------------------------
// DigitOps — peer actor for parse_score so Util can avoid self-call.
// --------------------------------------------------------------------

class DigitOps {
  method val(c) {
    if (c == "0") { reply(0); }
    else if (c == "1") { reply(1); }
    else if (c == "2") { reply(2); }
    else if (c == "3") { reply(3); }
    else if (c == "4") { reply(4); }
    else if (c == "5") { reply(5); }
    else if (c == "6") { reply(6); }
    else if (c == "7") { reply(7); }
    else if (c == "8") { reply(8); }
    else if (c == "9") { reply(9); }
    else { reply(-1); }
  }
}

// --------------------------------------------------------------------
// Worker — compound operations that orchestrate Util/Evaluator/Profiles.
// Lives in its own actor so its callers (e.g. Coordinator) can use `now`
// without re-entering themselves.
// --------------------------------------------------------------------

class Worker {
  var util = 0;
  var evaluator = 0;
  var profiles = 0;

  method init(u, e, p) {
    util = u;
    evaluator = e;
    profiles = p;
  }

  method compute_cell(genome, cell_axes_csv) {
    var n = now util.count_csv(cell_axes_csv) timeout 5000 else 0;
    var i = 0;
    var out = "";
    while (i < n) do {
      var axis = now util.nth_csv(cell_axes_csv, i) timeout 5000 else 0;
      var v = now util.get_axis(genome, axis) timeout 5000 else "";
      if (i == 0) { out = axis ++ "=" ++ v; }
      else { out = out ++ "|" ++ axis ++ "=" ++ v; }
      i = i + 1;
    }
    reply(out);
  }

  method compute_score(genome, task_csv) {
    var n = now util.count_csv(task_csv) timeout 5000 else 0;
    var i = 0;
    var sum = 0.0;
    while (i < n) do {
      var task = now util.nth_csv(task_csv, i) timeout 5000 else 0;
      var prof = now profiles.get(task) timeout 5000 else "";
      var s = now evaluator.score_for_task(genome, prof) timeout 5000 else 0;
      sum = sum + s;
      i = i + 1;
    }
    var avg = sum;
    if (n > 0) { avg = sum / (n + 0.0); }
    reply(avg);
  }
}

// --------------------------------------------------------------------
// Generator — seed / mutate / crossover
// --------------------------------------------------------------------

class Generator {
  var util = 0;
  var axes_csv = "";
  var values_table = "";

  method init(u, axes, values) {
    util = u;
    axes_csv = axes;
    values_table = values;
  }

  method seed() {
    var n_axes = now util.count_csv(axes_csv) timeout 5000 else 0;
    var i = 0;
    var g = "";
    while (i < n_axes) do {
      var axis = now util.nth_csv(axes_csv, i) timeout 5000 else 0;
      var vals = now util.axis_values(values_table, axis) timeout 5000 else "";
      var n_vals = now util.count_csv(vals) timeout 5000 else 0;
      var v = now util.nth_csv(vals, random(n_vals)) timeout 5000 else 0;
      if (i == 0) { g = axis ++ "=" ++ v; }
      else { g = g ++ "|" ++ axis ++ "=" ++ v; }
      i = i + 1;
    }
    reply(g);
  }

  method mutate(parent) {
    var n_axes = now util.count_csv(axes_csv) timeout 5000 else 0;
    var idx = random(n_axes);
    var axis = now util.nth_csv(axes_csv, idx) timeout 5000 else 0;
    var vals = now util.axis_values(values_table, axis) timeout 5000 else "";
    var n_vals = now util.count_csv(vals) timeout 5000 else 0;
    var v = now util.nth_csv(vals, random(n_vals)) timeout 5000 else 0;
    var child = now util.set_axis(parent, axis, v) timeout 5000 else 0;
    reply(child);
  }

  method cross(a, b) {
    var n_axes = now util.count_csv(axes_csv) timeout 5000 else 0;
    var i = 0;
    var child = "";
    while (i < n_axes) do {
      var axis = now util.nth_csv(axes_csv, i) timeout 5000 else 0;
      var src = a;
      if (random(2) == 1) { src = b; }
      var v = now util.get_axis(src, axis) timeout 5000 else "";
      if (i == 0) { child = axis ++ "=" ++ v; }
      else { child = child ++ "|" ++ axis ++ "=" ++ v; }
      i = i + 1;
    }
    reply(child);
  }
}

// --------------------------------------------------------------------
// Reviewer — one ai_call_with_system per score request (Phase 6),
//            deterministic scoring (Phase 5).
// --------------------------------------------------------------------

class Reviewer {
  var name = "";
  var persona = "";
  var use_ai = 0;
  var weight = 0.0;
  var util = 0;
  var digits = 0;

  method init(n, p, u, w, util_actor, digits_actor) {
    name = n;
    persona = p;
    use_ai = u;
    weight = w;
    util = util_actor;
    digits = digits_actor;
  }

  method score(genome, task_profile) {
    if (use_ai == 1) {
      var prompt = "評価対象の遺伝子: " ++ genome ++
                   "\n理想プロファイル: " ++ task_profile ++
                   "\n\nこのプロファイルに対する適合度を 0.0 から 1.0 の単一の decimal number で返してください。説明禁止。数値1つだけ。";
      var ai_text = ai_call_with_system(persona, prompt);
      var ai_score = now util.parse_score(ai_text, digits) timeout 5000 else 0;
      reply(ai_score);
    } else {
    // Deterministic: fraction of profile axes the genome matches.
    var matches = 0;
    var total = 0;
    var rest = task_profile;
    while (str_len(rest) > 0) do {
      var bar = str_index(rest, "|");
      var pair = "";
      if (bar < 0) {
        pair = rest;
        rest = "";
      } else {
        pair = str_sub(rest, 0, bar);
        rest = str_sub(rest, bar + 1);
      }
      var eq = str_index(pair, "=");
      if (eq >= 0) {
        var axis = str_sub(pair, 0, eq);
        var want = str_sub(pair, eq + 1);
        var key = axis ++ "=";
        var gidx = str_index(genome, key);
        if (gidx >= 0) {
          var gstart = gidx + str_len(key);
          var grest = str_sub(genome, gstart);
          var gbar = str_index(grest, "|");
          var got = "";
          if (gbar < 0) { got = grest; }
          else { got = str_sub(grest, 0, gbar); }
          if (got == want) { matches = matches + 1; }
        }
        total = total + 1;
      }
    }
    var s = 0.0;
    if (total > 0) { s = (matches + 0.0) / (total + 0.0); }
    reply(s);
    }
  }

  method get_weight() { reply(weight); }
}

// --------------------------------------------------------------------
// Evaluator — fans out reviewer scoring with `future`, awaits, aggregates.
// The class is codegen'd with exactly n_reviewers slots (see
// aipl_codegen.py) so init() arity matches the bootstrap call for any N.
// --------------------------------------------------------------------

class Evaluator {
  var r1 = 0;
  var r2 = 0;
  var r3 = 0;
  var r4 = 0;
  var r5 = 0;

  method init(rev1, rev2, rev3, rev4, rev5) {
    r1 = rev1;
    r2 = rev2;
    r3 = rev3;
    r4 = rev4;
    r5 = rev5;
  }

  method score_for_task(genome, profile) {
    var f1 = future r1.score(genome, profile);
    var f2 = future r2.score(genome, profile);
    var f3 = future r3.score(genome, profile);
    var f4 = future r4.score(genome, profile);
    var f5 = future r5.score(genome, profile);
    var s1 = await(f1) timeout 5000 else 0;
    var w1 = now r1.get_weight() timeout 5000 else 0;
    var s2 = await(f2) timeout 5000 else 0;
    var w2 = now r2.get_weight() timeout 5000 else 0;
    var s3 = await(f3) timeout 5000 else 0;
    var w3 = now r3.get_weight() timeout 5000 else 0;
    var s4 = await(f4) timeout 5000 else 0;
    var w4 = now r4.get_weight() timeout 5000 else 0;
    var s5 = await(f5) timeout 5000 else 0;
    var w5 = now r5.get_weight() timeout 5000 else 0;
    var combined = s1 * w1 + s2 * w2 + s3 * w3 + s4 * w4 + s5 * w5;
    reply(combined);
  }
}

// --------------------------------------------------------------------
// EliteMap — cell -> champion id mapping with parallel arrays
// --------------------------------------------------------------------

class EliteMap {
  var cells = [];
  var ids = [];
  var scores = [];
  var genomes = [];

  method propose(cell, ind_id, genome, score) {
    var n = array_len(cells);
    var i = 0;
    var idx = -1;
    while (i < n) do {
      if (array_get(cells, i) == cell) {
        idx = i;
        i = n;
      } else {
        i = i + 1;
      }
    }
    if (idx < 0) {
      array_push(cells, cell);
      array_push(ids, ind_id);
      array_push(scores, score);
      array_push(genomes, genome);
      reply(1);
    } else {
      var existing = array_get(scores, idx);
      if (score > existing) {
        array_set(ids, idx, ind_id);
        array_set(scores, idx, score);
        array_set(genomes, idx, genome);
        reply(1);
      } else {
        reply(0);
      }
    }
  }

  method size() { reply(array_len(cells)); }

  method sample_random_genome() {
    var n = array_len(cells);
    if (n == 0) { reply(""); }
    else { reply(array_get(genomes, random(n))); }
  }

  method best_summary(top_k) {
    var n = array_len(cells);
    var i = 0;
    var out = "";
    while (i < n) do {
      var line = "  cell=" ++ array_get(cells, i) ++
                 "  score=" ++ array_get(scores, i) ++
                 "  id=" ++ array_get(ids, i);
      if (i == 0) { out = line; }
      else { out = out ++ "\n" ++ line; }
      i = i + 1;
    }
    reply(out);
  }
}

// --------------------------------------------------------------------
// Lineage — append-only individual record
// --------------------------------------------------------------------

class Lineage {
  var ids = [];
  var genomes = [];
  var parents = [];
  var scores = [];
  var generations = [];
  var operators = [];
  var cells = [];

  method add(id, genome, parent, score, gen, op, cell) {
    array_push(ids, id);
    array_push(genomes, genome);
    array_push(parents, parent);
    array_push(scores, score);
    array_push(generations, gen);
    array_push(operators, op);
    array_push(cells, cell);
    reply(array_len(ids));
  }

  method dump(path) {
    var n = array_len(ids);
    var i = 0;
    var out = "[\n";
    while (i < n) do {
      // score gets a trailing "0" so 0.0 stringifies to "0.00"
      // (Python runtime emits "0." which would be invalid JSON).
      var entry = "  {\"id\":\"" ++ array_get(ids, i) ++ "\"," ++
                  "\"genome\":\"" ++ array_get(genomes, i) ++ "\"," ++
                  "\"parent\":\"" ++ array_get(parents, i) ++ "\"," ++
                  "\"score\":" ++ array_get(scores, i) ++ "0," ++
                  "\"generation\":" ++ array_get(generations, i) ++ "," ++
                  "\"operator\":\"" ++ array_get(operators, i) ++ "\"," ++
                  "\"cell\":\"" ++ array_get(cells, i) ++ "\"}";
      if (i < n - 1) { out = out ++ entry ++ ",\n"; }
      else { out = out ++ entry ++ "\n"; }
      i = i + 1;
    }
    out = out ++ "]\n";
    write_file(path, out);
    reply(n);
  }
}

// --------------------------------------------------------------------
// TaskProfiles — embedded per-task ideal genome fragments
// --------------------------------------------------------------------

class TaskProfiles {
  // task profiles inlined into get(); no separate methods.

  method get(task_name) {
    if (task_name == "PiChudnovskyBsplit") { reply(""); }
    else if (task_name == "FactorialN") { reply(""); }
    else if (task_name == "QuicksortInPlace") { reply(""); }
    else if (task_name == "FFTMultiply") { reply(""); }
    else if (task_name == "MatmulNCubed") { reply(""); }
    else if (task_name == "FibonacciClosedForm") { reply(""); }
    else { reply(""); }
  }
}

// --------------------------------------------------------------------
// Coordinator — main loop
// --------------------------------------------------------------------

class Coordinator {
  var util = 0;
  var generator = 0;
  var evaluator = 0;
  var elite = 0;
  var lineage = 0;
  var profiles = 0;
  var worker = 0;

  var seed_count = 8;
  var generations = 30;
  var cell_axes_csv = "paradigm,type_system,arithmetic_primitives,control_flow,syntax_family";
  var task_csv = "PiChudnovskyBsplit,FactorialN,QuicksortInPlace,FFTMultiply,MatmulNCubed,FibonacciClosedForm";
  var next_id = 0;

  method init(u, g, e, em, lg, tp, w) {
    util = u;
    generator = g;
    evaluator = e;
    elite = em;
    lineage = lg;
    profiles = tp;
    worker = w;
  }

  method run() {
    print("=== LangDesign_Expressive (AIPL — Actor-based Intelligent Parallel Language — orchestrator) ===");
    print("seed_count=" ++ seed_count ++ "  generations=" ++ generations);

    // Phase 1: seed
    var i = 0;
    while (i < seed_count) do {
      var g = now generator.seed() timeout 5000 else 0;
      next_id = next_id + 1;
      var id = "I" ++ next_id;
      var cell = now worker.compute_cell(g, cell_axes_csv) timeout 5000 else 0;
      var score = now worker.compute_score(g, task_csv) timeout 5000 else 0;
      send lineage.add(id, g, "", score, 0, "seed", cell);
      send elite.propose(cell, id, g, score);
      i = i + 1;
    }
    print("[seed] elite cells filled: " ++ (now elite.size() timeout 5000 else 0));

    // Phase 2: evolution
    var gen = 1;
    while (gen <= generations) do {
      var parent = now elite.sample_random_genome() timeout 5000 else "";
      var size = now elite.size() timeout 5000 else 0;
      var do_cross = 0;
      if (random(10) < 3) {
        if (size >= 2) { do_cross = 1; }
      }
      var child = "";
      var op = "";
      if (do_cross == 1) {
        var partner = now elite.sample_random_genome() timeout 5000 else "";
        child = now generator.cross(parent, partner) timeout 5000 else 0;
        op = "uniform_crossover";
      } else {
        child = now generator.mutate(parent) timeout 5000 else 0;
        op = "axis_resample";
      }
      next_id = next_id + 1;
      var cid = "I" ++ next_id;
      var ccell = now worker.compute_cell(child, cell_axes_csv) timeout 5000 else 0;
      var cscore = now worker.compute_score(child, task_csv) timeout 5000 else 0;
      send lineage.add(cid, child, "", cscore, gen, op, ccell);
      send elite.propose(ccell, cid, child, cscore);
      gen = gen + 1;
    }

    print("[done] cells filled: " ++ (now elite.size() timeout 5000 else 0));
    print(now elite.best_summary(5) timeout 5000 else 0);

    var n = now lineage.dump("out/LangDesign_Expressive.aipl_lineage.json") timeout 5000 else 0;
    print("[lineage] wrote " ++ n ++ " individuals to out/LangDesign_Expressive.aipl_lineage.json");
  }
}

// --------------------------------------------------------------------
// Bootstrap (top-level)
// --------------------------------------------------------------------

var util = new Util();
var digits = new DigitOps();
var generator = new Generator(util, "paradigm,evaluation_strategy,type_system,arithmetic_primitives,precision_control,control_flow,termination_check,memory_management,io_model,syntax_family,abstraction,compilation_target", "paradigm:imperative,functional,dataflow,term_rewriting,declarative_equation,oo,hybrid_imperative_functional|evaluation_strategy:strict,lazy,call_by_need,call_by_name|type_system:dynamic,static_simple,hindley_milner,refinement,dependent|arithmetic_primitives:arbitrary_int,arbitrary_int_plus_rational,decimal_with_precision,real_with_precision_annotation,interval_arithmetic,dependent_precision|precision_control:implicit,global_const,per_value_annotation,automatic_inference,proof_obligation|control_flow:structured_loops,general_recursion,tail_call_only,pattern_match_fold,list_comprehension,monadic_bind|termination_check:none,structural_recursion,well_founded,totality|memory_management:manual,gc,region_typed,rc,linear,borrow_check|io_model:print_only,stream_emit,file_io_imperative,region_owned_output,monadic_io|syntax_family:c_like,ml_like,lisp_like,apl_like,haskell_like,python_like,prolog_like,custom_minimal|abstraction:bare_metal,libc,vm_minimal,stdlib_rich|compilation_target:tree_walker_interpreter,bytecode_vm");
var elite = new EliteMap();
var lineage = new Lineage();
var profiles = new TaskProfiles();

var rev1 = new Reviewer("R1_AlgorithmExpressivity", "あなたは R1 (アルゴリズム表現力) を判定するレビュアーです。候補言語の遺伝子 (paradigm, control_flow, arithmetic_primitives, precision_control, type_system, syntax_family の 6 軸) を見て、Chudnovsky binary-splitting アルゴリズム (二分木再帰 + 巨大整数の積 + 有理数の和) を 当該言語の構文だけで 実装可能かを判定する。重要: dispatch shell (例: compute=chudnovsky 1 行で済む) は『書けない』とみなす。スコア基準: 1.0 = 50 行以内で書ける (例: arbitrary_int_plus_rational + general_recursion + ml_like)、0.7 = 100 行以内で書ける、0.3 = 書けるが 200 行以上、0.0 = primitive 不足で書けない (例: fixed_int 系、または fold のみ)。半角数字の decimal で答えてください。", 1, 0.3, util, digits);
var rev2 = new Reviewer("R2_ArbitraryPrecisionSafety", "あなたは R2 (任意精度安全性) を判定するレビュアーです。候補言語の arithmetic_primitives と precision_control を見て、Chudnovsky bsplit に必要な『N=10000 桁の正確な計算』が言語の型システムで保証されるかを判定する。スコア基準: 1.0 = arbitrary_int_plus_rational または上位 + per_value_annotation 以上の精度制御で型レベルで桁数を持てる、0.7 = arbitrary 系はあるが精度は実行時の責任 (implicit / global_const)、0.3 = decimal_with_precision のみ、0.0 = 上記いずれにも該当しない。半角数字の decimal で答えてください。", 1, 0.2, util, digits);
var rev3 = new Reviewer("R3_RecursionAndIteration", "あなたは R3 (制御フロー充実度) を判定するレビュアーです。candidate の control_flow と termination_check の組合せが、二分木再帰 (binary splitting) と loop (FFT, matmul) の両方を表現できるかを判定する。スコア基準: 1.0 = general_recursion または structured_loops + 等価な再帰が表現可能 (paradigm が functional ならパターンマッチ + 再帰で OK)、0.7 = tail_call_only など制約はあるが両方できる、0.3 = pattern_match_fold のみ (binary tree は書けるが loop は不自然)、0.0 = どちらも書けない (list_comprehension のみなど)。半角数字の decimal で答えてください。", 1, 0.2, util, digits);
var rev4 = new Reviewer("R4_ImplementabilityFeasibility", "あなたは R4 (ホスト実装の実現可能性) を判定するレビュアーです。compilation_target, syntax_family, type_system, paradigm の組合せが、Python ホストで 500〜3000 行の interpreter として書けるかを判定する。基準: 1.0 = tree_walker_interpreter + ml_like/c_like/python_like + dynamic/static_simple/hindley_milner (1500 行以内が現実的)、0.7 = bytecode_vm を選んだが型は単純 (3000 行以内)、0.3 = dependent 型 (4500 行程度) または lisp_like + 強い型システム、0.0 = bytecode_vm + dependent 型のような重複した複雑さ。半角数字の decimal で答えてください。", 1, 0.15, util, digits);
var rev5 = new Reviewer("R5_Generality", "あなたは R5 (汎用性) を判定するレビュアーです。当該言語が 6 タスク (PiChudnovskyBsplit, FactorialN, QuicksortInPlace, FFTMultiply, MatmulNCubed, FibonacciClosedForm) のうち何個を書けるかを推定する。各タスクの要求: PiChudnovskyBsplit と FactorialN は arbitrary 系算術 + 再帰/loop、Quicksort は可変配列 + 再帰、FFTMultiply は配列 + 複素数 (または mod prime)、MatmulNCubed は 2D 配列 + 3 重 loop、FibonacciClosedForm は代数的数 or 行列累乗。スコア基準: 1.0 = 5-6 個書ける、0.7 = 3-4 個、0.3 = 1-2 個、0.0 = 0 個 (PiChudnovskyBsplit すら書けない)。半角数字の decimal で答えてください。", 1, 0.15, util, digits);
var eval_actor = new Evaluator(rev1, rev2, rev3, rev4, rev5);
var worker = new Worker(util, eval_actor, profiles);
var coord = new Coordinator(util, generator, eval_actor, elite, lineage, profiles, worker);
send coord.run();
