# chudnovsky_linear.psi — Medium-speed π: Chudnovsky series, linear sum.
#
# Same series as chudnovsky.psi, but the partial sum is accumulated
# linearly (left-to-right) instead of with binary splitting.  The
# rational denominators grow more aggressively this way, but the
# series convergence (≈14.18 digits per term) is the same → much
# faster than Machin (slow) but slower than Chudnovsky bsplit (fast).
#
# 10000 digits → ≈715 terms.
#
# Demonstrates: PsiLang TCO + Rat accumulation + Real round-off.

fn term(k) =
  let sign = if k mod 2 == 0 then 1 else -1 in
  let num  = sign * int_fact(6 * k) * (545140134 * k + 13591409) in
  let den  = int_fact(3 * k) * int_pow(int_fact(k), 3) * int_pow(640320, 3 * k) in
  rat(num, den)

# Linear left-to-right accumulator: acc ← acc + term(k)
fn linear_sum_loop(k, n_terms, acc) =
  if k == n_terms then acc
  else linear_sum_loop(k + 1, n_terms, rat_add(acc, term(k)))

fn chudnovsky_linear(n_digits) =
  let n_terms = n_digits / 14 + 2 in
  let prec    = n_digits + 20 in
  let _bump   = set_precision(prec) in
  let s_rat   = linear_sum_loop(0, n_terms, rat(0, 1)) in
  let s_real  = real_from_rat(s_rat, prec) in
  let c       = real_mul(real_from_int(426880),
                          real_sqrt(real_from_int(10005), prec)) in
  real_div(c, s_real)

let pi  = chudnovsky_linear(10000) in
emit(real_to_string(pi, 10000))
