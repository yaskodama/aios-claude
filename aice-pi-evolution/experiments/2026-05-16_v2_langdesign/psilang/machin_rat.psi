# machin_rat.psi — Machin's formula evaluated as RATIONAL arithmetic.
#
# Same arithmetic identity as `machin.psi` but every partial sum is a
# Rat (=(num,den) with gcd-reduction) instead of a fixed-precision
# Real (Decimal).  The denominators grow as
#     LCM(1, 3, 5, … 2N+1) · m^(2N+1)
# which for N=7700, m=5 has ~14,000 digits — every rat_add is then a
# pair of ~14,000-digit bigint multiplies + a gcd.  Expected to be
# noticeably slower than the Real version.

fn arctan_term_rat(k, m) =
  let sign = if k mod 2 == 0 then 1 else -1 in
  rat(sign, (2 * k + 1) * int_pow(m, 2 * k + 1))

fn arctan_rat_loop(k, n_terms, m, acc) =
  if k == n_terms then acc
  else arctan_rat_loop(k + 1, n_terms, m,
                        rat_add(acc, arctan_term_rat(k, m)))

fn arctan_rat(m, n_terms) =
  arctan_rat_loop(0, n_terms, m, rat(0, 1))

fn machin_rat_pi(n_digits) =
  let n5    = n_digits * 10 / 13 + 30 in
  let n239  = n_digits * 100 / 470 + 30 in
  let prec  = n_digits + 50 in
  let _bump = set_precision(prec) in
  let a5    = arctan_rat(5,   n5) in
  let a239  = arctan_rat(239, n239) in
  let p_rat = rat_sub(rat_mul(rat(16, 1), a5),
                       rat_mul(rat(4, 1),  a239)) in
  real_from_rat(p_rat, prec)

let pi = machin_rat_pi(10000) in
emit(real_to_string(pi, 10000))
