# PsiLang smoke test: factorial via recursion + pattern matching, then rational arithmetic.

fn fact(n) =
  if n == 0 then 1
  else n * fact(n - 1)

fn sum_list(xs) =
  match xs with
  | [] -> 0
  | h :: t -> h + sum_list(t)
  end

# Rational: compute 1/1 + 1/2 + 1/3 + 1/4
let r = rat_add(rat_add(rat(1,1), rat(1,2)),
                rat_add(rat(1,3), rat(1,4))) in
emit("fact(20) = " + int_to_string(fact(20)));
emit("sum([1..5]) = " + int_to_string(sum_list([1, 2, 3, 4, 5])));
emit("1+1/2+1/3+1/4 = " + int_to_string(rat_num(r)) + "/" + int_to_string(rat_den(r)));
emit("int_fact(15) = " + int_to_string(int_fact(15)));
emit("int_pow(2, 10) = " + int_to_string(int_pow(2, 10)))
