// --------------------------------------------------------------------
// DigitOps — peer actor for parse_score so Util can avoid self-call.
// --------------------------------------------------------------------

class DigitOps {
  method val(c) {
    if (c == "0") { reply(0); }
    else if (c == "1") { reply(1); }
    else if (c == "2") { reply(2); }
    else if (c == "3") { reply(3); }
    else if (c == "4") { reply(4); }
    else if (c == "5") { reply(5); }
    else if (c == "6") { reply(6); }
    else if (c == "7") { reply(7); }
    else if (c == "8") { reply(8); }
    else if (c == "9") { reply(9); }
    else { reply(-1); }
  }
}

// --------------------------------------------------------------------
// Worker — compound operations that orchestrate Util/Evaluator/Profiles.
// Lives in its own actor so its callers (e.g. Coordinator) can use `now`
// without re-entering themselves.
// --------------------------------------------------------------------

class Worker {
  var util = 0;
  var evaluator = 0;
  var profiles = 0;

  method init(u, e, p) {
    util = u;
    evaluator = e;
    profiles = p;
  }

  method compute_cell(genome, cell_axes_csv) {
    var n = now util.count_csv(cell_axes_csv);
    var i = 0;
    var out = "";
    while (i < n) do {
      var axis = now util.nth_csv(cell_axes_csv, i);
      var v = now util.get_axis(genome, axis);
      if (i == 0) { out = axis + "=" + v; }
      else { out = out + "|" + axis + "=" + v; }
      i = i + 1;
    }
    reply(out);
  }

  method compute_score(genome, task_csv) {
    var n = now util.count_csv(task_csv);
    var i = 0;
    var sum = 0.0;
    while (i < n) do {
      var task = now util.nth_csv(task_csv, i);
      var prof = now profiles.get(task);
      var s = now evaluator.score_for_task(genome, prof);
      sum = sum + s;
      i = i + 1;
    }
    var avg = sum;
    if (n > 0) { avg = sum / (n + 0.0); }
    reply(avg);
  }
}

// --------------------------------------------------------------------
// Generator — seed / mutate / crossover
// --------------------------------------------------------------------

class Generator {
  var util = 0;
  var axes_csv = "";
  var values_table = "";

  method init(u, axes, values) {
    util = u;
    axes_csv = axes;
    values_table = values;
  }

  // v4 (2026-05-17): seed / mutate / cross now rejection-sample on the
  // schema's coherence rules (via Util.is_coherent).  Up to 50 attempts;
  // on every retry exhausted, the last candidate is returned even if
  // incoherent, so the evolution never deadlocks on infeasible schemas.

  method seed() {
    var tries = 0;
    var g = "";
    var ok = 0;
    while (ok == 0) do {
      var n_axes = now util.count_csv(axes_csv);
      var i = 0;
      var cand = "";
      while (i < n_axes) do {
        var axis = now util.nth_csv(axes_csv, i);
        var vals = now util.axis_values(values_table, axis);
        var n_vals = now util.count_csv(vals);
        var v = now util.nth_csv(vals, random(n_vals));
        if (i == 0) { cand = axis + "=" + v; }
        else { cand = cand + "|" + axis + "=" + v; }
        i = i + 1;
      }
      g = cand;
      ok = now util.is_coherent(g);
      tries = tries + 1;
      if (tries >= 50) { ok = 1; }
    }
    reply(g);
  }

  method mutate(parent) {
    var tries = 0;
    var child = parent;
    var ok = 0;
    while (ok == 0) do {
      var n_axes = now util.count_csv(axes_csv);
      var idx = random(n_axes);
      var axis = now util.nth_csv(axes_csv, idx);
      var vals = now util.axis_values(values_table, axis);
      var n_vals = now util.count_csv(vals);
      var v = now util.nth_csv(vals, random(n_vals));
      var cand = now util.set_axis(parent, axis, v);
      child = cand;
      ok = now util.is_coherent(child);
      tries = tries + 1;
      if (tries >= 50) { ok = 1; }
    }
    reply(child);
  }

  method cross(a, b) {
    var tries = 0;
    var child = a;
    var ok = 0;
    while (ok == 0) do {
      var n_axes = now util.count_csv(axes_csv);
      var i = 0;
      var cand = "";
      while (i < n_axes) do {
        var axis = now util.nth_csv(axes_csv, i);
        var src = a;
        if (random(2) == 1) { src = b; }
        var v = now util.get_axis(src, axis);
        if (i == 0) { cand = axis + "=" + v; }
        else { cand = cand + "|" + axis + "=" + v; }
        i = i + 1;
      }
      child = cand;
      ok = now util.is_coherent(child);
      tries = tries + 1;
      if (tries >= 50) { ok = 1; }
    }
    reply(child);
  }
}

// --------------------------------------------------------------------
// Reviewer — one ai_call_with_system per score request (Phase 6),
//            deterministic scoring (Phase 5).
// --------------------------------------------------------------------

class Reviewer {
  var name = "";
  var persona = "";
  var use_ai = 0;
  var weight = 0.0;
  var util = 0;
  var digits = 0;

  method init(n, p, u, w, util_actor, digits_actor) {
    name = n;
    persona = p;
    use_ai = u;
    weight = w;
    util = util_actor;
    digits = digits_actor;
  }

  method score(genome, task_profile) {
    if (use_ai == 1) {
      var prompt = "評価対象の遺伝子: " + genome +
                   "\n理想プロファイル: " + task_profile +
                   "\n\nこのプロファイルに対する適合度を 0.0 から 1.0 の単一の decimal number で返してください。説明禁止。数値1つだけ。";
      var ai_text = ai_call_with_system(persona, prompt);
      var ai_score = now util.parse_score(ai_text, digits);
      reply(ai_score);
    } else {
    // Deterministic: fraction of profile axes the genome matches.
    var matches = 0;
    var total = 0;
    var rest = task_profile;
    while (str_len(rest) > 0) do {
      var bar = str_index(rest, "|");
      var pair = "";
      if (bar < 0) {
        pair = rest;
        rest = "";
      } else {
        pair = str_sub(rest, 0, bar);
        rest = str_sub(rest, bar + 1);
      }
      var eq = str_index(pair, "=");
      if (eq >= 0) {
        var axis = str_sub(pair, 0, eq);
        var want = str_sub(pair, eq + 1);
        var key = axis + "=";
        var gidx = str_index(genome, key);
        if (gidx >= 0) {
          var gstart = gidx + str_len(key);
          var grest = str_sub(genome, gstart);
          var gbar = str_index(grest, "|");
          var got = "";
          if (gbar < 0) { got = grest; }
          else { got = str_sub(grest, 0, gbar); }
          if (got == want) { matches = matches + 1; }
        }
        total = total + 1;
      }
    }
    var s = 0.0;
    if (total > 0) { s = (matches + 0.0) / (total + 0.0); }
    reply(s);
    }
  }

  method get_weight() { reply(weight); }
}

// --------------------------------------------------------------------
// Evaluator — fans out reviewer scoring with `future`, awaits, aggregates.
// The class is codegen'd with exactly n_reviewers slots (see
// aipl_codegen.py) so init() arity matches the bootstrap call for any N.
// --------------------------------------------------------------------

class Evaluator {
  var r1 = 0;
  var r2 = 0;
  var r3 = 0;
  var r4 = 0;
  var r5 = 0;
  var r6 = 0;

  method init(rev1, rev2, rev3, rev4, rev5, rev6) {
    r1 = rev1;
    r2 = rev2;
    r3 = rev3;
    r4 = rev4;
    r5 = rev5;
    r6 = rev6;
  }

  method score_for_task(genome, profile) {
    var f1 = future r1.score(genome, profile);
    var f2 = future r2.score(genome, profile);
    var f3 = future r3.score(genome, profile);
    var f4 = future r4.score(genome, profile);
    var f5 = future r5.score(genome, profile);
    var f6 = future r6.score(genome, profile);
    var s1 = await(f1);
    var w1 = now r1.get_weight();
    var s2 = await(f2);
    var w2 = now r2.get_weight();
    var s3 = await(f3);
    var w3 = now r3.get_weight();
    var s4 = await(f4);
    var w4 = now r4.get_weight();
    var s5 = await(f5);
    var w5 = now r5.get_weight();
    var s6 = await(f6);
    var w6 = now r6.get_weight();
    // v4 hard-floor: if reviewer 6 ('R6_RealWorldPrecedent') returned 0.0, overall fitness = 0.0.
    if (s6 == 0.0) { reply(0.0); }
    else {
      var combined = s1 * w1 + s2 * w2 + s3 * w3 + s4 * w4 + s5 * w5 + s6 * w6;
      reply(combined);
    }
  }
}

// --------------------------------------------------------------------
// EliteMap — cell -> champion id mapping with parallel arrays
// --------------------------------------------------------------------

class EliteMap {
  var cells = [];
  var ids = [];
  var scores = [];
  var genomes = [];

  method propose(cell, ind_id, genome, score) {
    var n = array_len(cells);
    var i = 0;
    var idx = -1;
    while (i < n) do {
      if (array_get(cells, i) == cell) {
        idx = i;
        i = n;
      } else {
        i = i + 1;
      }
    }
    if (idx < 0) {
      array_push(cells, cell);
      array_push(ids, ind_id);
      array_push(scores, score);
      array_push(genomes, genome);
      reply(1);
    } else {
      var existing = array_get(scores, idx);
      if (score > existing) {
        array_set(ids, idx, ind_id);
        array_set(scores, idx, score);
        array_set(genomes, idx, genome);
        reply(1);
      } else {
        reply(0);
      }
    }
  }

  method size() { reply(array_len(cells)); }

  method sample_random_genome() {
    var n = array_len(cells);
    if (n == 0) { reply(""); }
    else { reply(array_get(genomes, random(n))); }
  }

  method best_summary(top_k) {
    var n = array_len(cells);
    var i = 0;
    var out = "";
    while (i < n) do {
      var line = "  cell=" + array_get(cells, i) +
                 "  score=" + array_get(scores, i) +
                 "  id=" + array_get(ids, i);
      if (i == 0) { out = line; }
      else { out = out + "\n" + line; }
      i = i + 1;
    }
    reply(out);
  }
}

// --------------------------------------------------------------------
// Lineage — append-only individual record
// --------------------------------------------------------------------

class Lineage {
  var ids = [];
  var genomes = [];
  var parents = [];
  var scores = [];
  var generations = [];
  var operators = [];
  var cells = [];

  method add(id, genome, parent, score, gen, op, cell) {
    array_push(ids, id);
    array_push(genomes, genome);
    array_push(parents, parent);
    array_push(scores, score);
    array_push(generations, gen);
    array_push(operators, op);
    array_push(cells, cell);
    reply(array_len(ids));
  }

  method dump(path) {
    var n = array_len(ids);
    var i = 0;
    var out = "[\n";
    while (i < n) do {
      // score gets a trailing "0" so 0.0 stringifies to "0.00"
      // (Python runtime emits "0." which would be invalid JSON).
      var entry = "  {\"id\":\"" + array_get(ids, i) + "\"," +
                  "\"genome\":\"" + array_get(genomes, i) + "\"," +
                  "\"parent\":\"" + array_get(parents, i) + "\"," +
                  "\"score\":" + array_get(scores, i) + "0," +
                  "\"generation\":" + array_get(generations, i) + "," +
                  "\"operator\":\"" + array_get(operators, i) + "\"," +
                  "\"cell\":\"" + array_get(cells, i) + "\"}";
      if (i < n - 1) { out = out + entry + ",\n"; }
      else { out = out + entry + "\n"; }
      i = i + 1;
    }
    out = out + "]\n";
    write_file(path, out);
    reply(n);
  }
}

// --------------------------------------------------------------------
// TaskProfiles — embedded per-task ideal genome fragments
// --------------------------------------------------------------------

class TaskProfiles {
  // task profiles inlined into get(); no separate methods.

  method get(task_name) {
    if (task_name == "RewritePiPhase1") { reply(""); }
    else if (task_name == "RewriteLangDesign") { reply(""); }
    else if (task_name == "RoundTripGaJson") { reply(""); }
    else if (task_name == "BackwardCompatPsiLang2") { reply(""); }
    else if (task_name == "CodegenImplCost") { reply(""); }
    else { reply(""); }
  }
}

// --------------------------------------------------------------------
// Coordinator — main loop
// --------------------------------------------------------------------

class Coordinator {
  var util = 0;
  var generator = 0;
  var evaluator = 0;
  var elite = 0;
  var lineage = 0;
  var profiles = 0;
  var worker = 0;

  var seed_count = 8;
  var generations = 30;
  var cell_axes_csv = "evolve_syntax_style,reviewer_declaration,genome_representation,backward_compat_strategy,aice_dialect_compat";
  var task_csv = "RewritePiPhase1,RewriteLangDesign,RoundTripGaJson,BackwardCompatPsiLang2,CodegenImplCost";
  var next_id = 0;

  method init(u, g, e, em, lg, tp, w) {
    util = u;
    generator = g;
    evaluator = e;
    elite = em;
    lineage = lg;
    profiles = tp;
    worker = w;
  }

  method run() {
    print("=== AIPL_v2_EvolveBlock (AIPL — Actor-based Intelligent Parallel Language — orchestrator) ===");
    print("seed_count=" + seed_count + "  generations=" + generations);

    // Phase 1: seed
    var i = 0;
    while (i < seed_count) do {
      var g = now generator.seed();
      next_id = next_id + 1;
      var id = "I" + next_id;
      var cell = now worker.compute_cell(g, cell_axes_csv);
      var score = now worker.compute_score(g, task_csv);
      send lineage.add(id, g, "", score, 0, "seed", cell);
      send elite.propose(cell, id, g, score);
      i = i + 1;
    }
    print("[seed] elite cells filled: " + (now elite.size()));

    // Phase 2: evolution
    var gen = 1;
    while (gen <= generations) do {
      var parent = now elite.sample_random_genome();
      var size = now elite.size();
      var do_cross = 0;
      if (random(10) < 3) {
        if (size >= 2) { do_cross = 1; }
      }
      var child = "";
      var op = "";
      if (do_cross == 1) {
        var partner = now elite.sample_random_genome();
        child = now generator.cross(parent, partner);
        op = "uniform_crossover";
      } else {
        child = now generator.mutate(parent);
        op = "axis_resample";
      }
      next_id = next_id + 1;
      var cid = "I" + next_id;
      var ccell = now worker.compute_cell(child, cell_axes_csv);
      var cscore = now worker.compute_score(child, task_csv);
      send lineage.add(cid, child, "", cscore, gen, op, ccell);
      send elite.propose(ccell, cid, child, cscore);
      // crash-recovery: flush lineage every generation so silent SDK
      // hangs (cf. Pi_Phase1_OpenSearch v3 attempt 2026-05-16) do not
      // lose the partial result.  Cost: one fs write per generation.
      var ckpt_n = now lineage.dump("out/AIPL_v2_EvolveBlock.aipl_lineage.json");
      print("[ckpt gen=" + gen + "] flushed " + ckpt_n + " individuals");
      gen = gen + 1;
    }

    print("[done] cells filled: " + (now elite.size()));
    print(now elite.best_summary(5));

    var n = now lineage.dump("out/AIPL_v2_EvolveBlock.aipl_lineage.json");
    print("[lineage] wrote " + n + " individuals to out/AIPL_v2_EvolveBlock.aipl_lineage.json");
  }
}

// --------------------------------------------------------------------
// Bootstrap (top-level)
// --------------------------------------------------------------------

var util = new Util();
var digits = new DigitOps();
var generator = new Generator(util, "evolve_syntax_style,reviewer_declaration,mutators_declaration,genome_representation,cell_axes_specification,ga_emission_mode,lineage_persistence,schema_source,backward_compat_strategy,aice_dialect_compat,reviewer_evaluator_style,parser_impact", "evolve_syntax_style:native_block_curly,native_block_indent,yaml_embed_in_code,json_literal_in_code,decorator_style,no_native_only_io|reviewer_declaration:inline_function,block_declaration_with_persona,separate_actor_class,external_yaml_ref,ai_call_inline|mutators_declaration:inline_lambdas,builtin_only,plugin_system,declarative_axes_only|genome_representation:csv_string,json_record,typed_record,plain_object_with_axes|cell_axes_specification:csv_in_block,list_literal,separate_var,attribute_annotations|ga_emission_mode:always_on_compile,opt_in,debug_flag,never|lineage_persistence:per_generation,per_evaluation,on_demand_block,none|schema_source:external_json_ref,inline_axes_with_coherence,ga_json_inline,hybrid|backward_compat_strategy:strict_no_change_to_existing,opt_in_new_syntax,deprecate_old_emit,breaking_change|aice_dialect_compat:yaml_v1_only,curly_brace_only,both_via_codegen,unified_grammar_with_yaml|reviewer_evaluator_style:future_fanout_current,async_block,message_passing,actor_per_reviewer,builtin_evaluate|parser_impact:no_parser_change,new_keywords_only,new_grammar_productions,full_dsl_subset");
var elite = new EliteMap();
var lineage = new Lineage();
var profiles = new TaskProfiles();

var rev1 = new Reviewer("R1_Expressivity", "あなたは R1 (表現力) を判定するレビュアーです。候補の evolve_syntax_style と reviewer_declaration と mutators_declaration を見て、v2 PsiLang を生んだ Pi_Phase1_OpenSearch.ga.json (12 axes, 5 reviewers, 2 mutators, 1 crossover) と同等の内容を新 evolve block で何行で書けるかを判定。1.0 = 30 行以下、0.7 = 60 行以下、0.3 = 100 行以下、0.0 = 書けないか 100 行超。0.0-1.0 の decimal を半角数字 1 つで答えてください。", 1, 0.2, util, digits);
var rev2 = new Reviewer("R2_RoundTripGaJson", "あなたは R2 (双方向変換) を判定するレビュアーです。候補の ga_emission_mode, genome_representation, schema_source を見て、AIPL evolve block と既存 .ga.json が情報落ちなく 1:1 で双方向変換できるかを判定。1.0 = lossless 双方向 (JSON-AIPL-JSON で同じ JSON が返る)、0.7 = 一方向 lossless、0.3 = 多くの情報が失われる、0.0 = round-trip 不能。半角数字 1 つで。", 1, 0.15, util, digits);
var rev3 = new Reviewer("R3_BackwardCompat", "あなたは R3 (後方互換) を判定するレビュアーです。候補の backward_compat_strategy, parser_impact, aice_dialect_compat を見て、PsiLang2 chudnovsky.psi 等の既存 AIPL プログラムが新 evolve syntax 導入後も動くかを判定。1.0 = 完全互換 (opt-in, no breaking)、0.7 = ほぼ互換 (1-2 deprecated)、0.3 = 互換性破壊あり、0.0 = 大破壊。半角数字 1 つで。", 1, 0.15, util, digits);
var rev4 = new Reviewer("R4_ImplementabilityCodegen", "あなたは R4 (実装可能性) を判定するレビュアーです。候補の parser_impact, evolve_syntax_style, reviewer_evaluator_style を見て、aipl_codegen.py (現在 1200 行) + aipl_parser.py + aipl_interp.py に追加実装が必要な行数を判定。1.0 = ≤ 200 行 (sugar layer のみ)、0.7 = ≤ 500 行 (template 追加)、0.3 = ≤ 1000 行、0.0 = 1000 行超 or 既存変更大。半角数字 1 つで。", 1, 0.2, util, digits);
var rev5 = new Reviewer("R5_DistributedHooks", "あなたは R5 (分散準備) を判定するレビュアーです。候補の reviewer_evaluator_style, lineage_persistence, genome_representation を見て、将来 AIPL v2 (2) で分散ランタイムを追加するときにこの設計が邪魔をしないかを判定。1.0 = actor 分散しやすい (message_passing/actor_per_reviewer)、0.7 = 普通、0.3 = 単一プロセス前提、0.0 = 分散と非互換。半角数字 1 つで。", 1, 0.15, util, digits);
var rev6 = new Reviewer("R6_RealWorldPrecedent", "あなたは R6 (現実先例) を判定するレビュアーです。候補が現実に存在する進化計算 DSL / ライブラリとどれだけ近いかを判定する。先例: (1) DEAP = Python toolbox + decorator (declarative), (2) nevergrad = functional API + optimizer registry, (3) pyribs = MAP-Elites lib + Archive/Emitter, (4) NEAT-Python = INI/XML config + Python plugins, (5) inspyred = OO-style + observers, (6) DREAM/EvoFlow = block-DSL embedded in host language. スコア: 5 軸以上一致 → 1.0、3-4 軸 → 0.5、2 軸以下 → 0.0 (これは hard floor として最終 fitness を 0 にクランプ)。半角数字 1 つで。", 1, 0.15, util, digits);
var eval_actor = new Evaluator(rev1, rev2, rev3, rev4, rev5, rev6);
var worker = new Worker(util, eval_actor, profiles);
var coord = new Coordinator(util, generator, eval_actor, elite, lineage, profiles, worker);
send coord.run();
