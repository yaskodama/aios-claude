      else { a2 = str_sub(a2_r, 0, a2_b); }
    }

    if (a2 == "breaking_change") {
      var b2_k = "parser_impact=";
      var b2_i = str_index(genome, b2_k);
      var b2 = "";
      if (b2_i >= 0) {
        var b2_r = str_sub(genome, b2_i + str_len(b2_k));
        var b2_b = str_index(b2_r, "|");
        if (b2_b < 0) { b2 = b2_r; }
