      else { a14 = str_sub(a14_r, 0, a14_b); }
    }

    if (a14 == "prolog_like") {
      var b14_k = "paradigm=";
      var b14_i = str_index(genome, b14_k);
      var b14 = "";
      if (b14_i >= 0) {
        var b14_r = str_sub(genome, b14_i + str_len(b14_k));
        var b14_b = str_index(b14_r, "|");
        if (b14_b < 0) { b14 = b14_r; }
        else { b14 = str_sub(b14_r, 0, b14_b); }
      }

      if (b14 != "") {
        var in_set = 0;
        if (b14 == "declarative_equation") { in_set = 1; }
        if (b14 == "term_rewriting") { in_set = 1; }
        if (in_set == 0) { ok = 0; }
      }
    }
    // rule 15: if syntax_family="apl_like" ⇒ …
    var a15_k = "syntax_family=";
    var a15_i = str_index(genome, a15_k);
    var a15 = "";
    if (a15_i >= 0) {
      var a15_r = str_sub(genome, a15_i + str_len(a15_k));
      var a15_b = str_index(a15_r, "|");
      if (a15_b < 0) { a15 = a15_r; }
      else { a15 = str_sub(a15_r, 0, a15_b); }
    }

    if (a15 == "apl_like") {
      var b15_k = "paradigm=";
      var b15_i = str_index(genome, b15_k);
      var b15 = "";
      if (b15_i >= 0) {
        var b15_r = str_sub(genome, b15_i + str_len(b15_k));
        var b15_b = str_index(b15_r, "|");
        if (b15_b < 0) { b15 = b15_r; }
        else { b15 = str_sub(b15_r, 0, b15_b); }
      }

      if (b15 != "") {
        var in_set = 0;
        if (b15 == "dataflow") { in_set = 1; }
        if (b15 == "functional") { in_set = 1; }
        if (in_set == 0) { ok = 0; }
      }
    }
    // rule 16: if syntax_family="python_like" ⇒ …
    var a16_k = "syntax_family=";
    var a16_i = str_index(genome, a16_k);
    var a16 = "";
    if (a16_i >= 0) {
      var a16_r = str_sub(genome, a16_i + str_len(a16_k));
      var a16_b = str_index(a16_r, "|");
      if (a16_b < 0) { a16 = a16_r; }
      else { a16 = str_sub(a16_r, 0, a16_b); }
    }

    if (a16 == "python_like") {
      var b16_k = "paradigm=";
      var b16_i = str_index(genome, b16_k);
      var b16 = "";
      if (b16_i >= 0) {
        var b16_r = str_sub(genome, b16_i + str_len(b16_k));
        var b16_b = str_index(b16_r, "|");
        if (b16_b < 0) { b16 = b16_r; }
        else { b16 = str_sub(b16_r, 0, b16_b); }
      }

      if (b16 != "") {
        var in_set = 0;
        if (b16 == "imperative") { in_set = 1; }
        if (b16 == "oo") { in_set = 1; }
        if (b16 == "hybrid_imperative_functional") { in_set = 1; }
        if (in_set == 0) { ok = 0; }
      }
    }
    // rule 17: if syntax_family="haskell_like" ⇒ …
    var a17_k = "syntax_family=";
    var a17_i = str_index(genome, a17_k);
    var a17 = "";
    if (a17_i >= 0) {
      var a17_r = str_sub(genome, a17_i + str_len(a17_k));
      var a17_b = str_index(a17_r, "|");
      if (a17_b < 0) { a17 = a17_r; }
      else { a17 = str_sub(a17_r, 0, a17_b); }
    }

    if (a17 == "haskell_like") {
      var b17_k = "paradigm=";
      var b17_i = str_index(genome, b17_k);
      var b17 = "";
      if (b17_i >= 0) {
        var b17_r = str_sub(genome, b17_i + str_len(b17_k));
        var b17_b = str_index(b17_r, "|");
        if (b17_b < 0) { b17 = b17_r; }
        else { b17 = str_sub(b17_r, 0, b17_b); }
      }

      if (b17 != "") {
        var in_set = 0;
        if (b17 == "functional") { in_set = 1; }
        if (in_set == 0) { ok = 0; }
      }
    }
    reply(ok);
  }
}

// --------------------------------------------------------------------
// DigitOps — peer actor for parse_score so Util can avoid self-call.
// --------------------------------------------------------------------

class DigitOps {
  method val(c) {
    if (c == "0") { reply(0); }
    else if (c == "1") { reply(1); }
    else if (c == "2") { reply(2); }
    else if (c == "3") { reply(3); }
    else if (c == "4") { reply(4); }
    else if (c == "5") { reply(5); }
    else if (c == "6") { reply(6); }
    else if (c == "7") { reply(7); }
    else if (c == "8") { reply(8); }
    else if (c == "9") { reply(9); }
    else { reply(-1); }
  }
}

// --------------------------------------------------------------------
// Worker — compound operations that orchestrate Util/Evaluator/Profiles.
// Lives in its own actor so its callers (e.g. Coordinator) can use `now`
// without re-entering themselves.
// --------------------------------------------------------------------

class Worker {
  var util = 0;
  var evaluator = 0;
  var profiles = 0;

  method init(u, e, p) {
    util = u;
    evaluator = e;
    profiles = p;
  }

  method compute_cell(genome, cell_axes_csv) {
    var n = now util.count_csv(cell_axes_csv) timeout 5000 else 0;
    var i = 0;
    var out = "";
    while (i < n) do {
      var axis = now util.nth_csv(cell_axes_csv, i) timeout 5000 else 0;
      var v = now util.get_axis(genome, axis) timeout 5000 else "";
      if (i == 0) { out = axis ++ "=" ++ v; }
      else { out = out ++ "|" ++ axis ++ "=" ++ v; }
      i = i + 1;
    }
    reply(out);
  }

  method compute_score(genome, task_csv) {
    var n = now util.count_csv(task_csv) timeout 5000 else 0;
    var i = 0;
    var sum = 0.0;
    while (i < n) do {
      var task = now util.nth_csv(task_csv, i) timeout 5000 else 0;
      var prof = now profiles.get(task) timeout 5000 else "";
      var s = now evaluator.score_for_task(genome, prof) timeout 5000 else 0;
      sum = sum + s;
      i = i + 1;
    }
    var avg = sum;
    if (n > 0) { avg = sum / (n + 0.0); }
    reply(avg);
  }
}

// --------------------------------------------------------------------
// Generator — seed / mutate / crossover
// --------------------------------------------------------------------

class Generator {
  var util = 0;
  var axes_csv = "";
  var values_table = "";

  method init(u, axes, values) {
    util = u;
    axes_csv = axes;
    values_table = values;
  }

  // v4 (2026-05-17): seed / mutate / cross now rejection-sample on the
  // schema's coherence rules (via Util.is_coherent).  Up to 50 attempts;
  // on every retry exhausted, the last candidate is returned even if
  // incoherent, so the evolution never deadlocks on infeasible schemas.

  method seed() {
    var tries = 0;
    var g = "";
    var ok = 0;
    while (ok == 0) do {
      var n_axes = now util.count_csv(axes_csv) timeout 5000 else 0;
      var i = 0;
      var cand = "";
      while (i < n_axes) do {
        var axis = now util.nth_csv(axes_csv, i) timeout 5000 else 0;
        var vals = now util.axis_values(values_table, axis) timeout 5000 else "";
        var n_vals = now util.count_csv(vals) timeout 5000 else 0;
        var v = now util.nth_csv(vals, random(n_vals)) timeout 5000 else 0;
        if (i == 0) { cand = axis ++ "=" ++ v; }
        else { cand = cand ++ "|" ++ axis ++ "=" ++ v; }
        i = i + 1;
      }
      g = cand;
      ok = now util.is_coherent(g) timeout 5000 else 0;
      tries = tries + 1;
      if (tries >= 50) { ok = 1; }
    }
    reply(g);
  }

  method mutate(parent) {
    var tries = 0;
    var child = parent;
    var ok = 0;
    while (ok == 0) do {
      var n_axes = now util.count_csv(axes_csv) timeout 5000 else 0;
      var idx = random(n_axes);
      var axis = now util.nth_csv(axes_csv, idx) timeout 5000 else 0;
      var vals = now util.axis_values(values_table, axis) timeout 5000 else "";
      var n_vals = now util.count_csv(vals) timeout 5000 else 0;
      var v = now util.nth_csv(vals, random(n_vals)) timeout 5000 else 0;
      var cand = now util.set_axis(parent, axis, v) timeout 5000 else 0;
      child = cand;
      ok = now util.is_coherent(child) timeout 5000 else 0;
      tries = tries + 1;
      if (tries >= 50) { ok = 1; }
    }
    reply(child);
  }

  method cross(a, b) {
    var tries = 0;
    var child = a;
    var ok = 0;
    while (ok == 0) do {
      var n_axes = now util.count_csv(axes_csv) timeout 5000 else 0;
      var i = 0;
      var cand = "";
      while (i < n_axes) do {
        var axis = now util.nth_csv(axes_csv, i) timeout 5000 else 0;
        var src = a;
        if (random(2) == 1) { src = b; }
        var v = now util.get_axis(src, axis) timeout 5000 else "";
        if (i == 0) { cand = axis ++ "=" ++ v; }
        else { cand = cand ++ "|" ++ axis ++ "=" ++ v; }
        i = i + 1;
      }
      child = cand;
      ok = now util.is_coherent(child) timeout 5000 else 0;
      tries = tries + 1;
      if (tries >= 50) { ok = 1; }
    }
    reply(child);
  }
}

// --------------------------------------------------------------------
// Reviewer — one ai_call_with_system per score request (Phase 6),
//            deterministic scoring (Phase 5).
// --------------------------------------------------------------------

class Reviewer {
  var name = "";
  var persona = "";
  var use_ai = 0;
  var weight = 0.0;
  var util = 0;
  var digits = 0;

  method init(n, p, u, w, util_actor, digits_actor) {
    name = n;
    persona = p;
    use_ai = u;
    weight = w;
    util = util_actor;
    digits = digits_actor;
  }

  method score(genome, task_profile) {
    if (use_ai == 1) {
      var prompt = "評価対象の遺伝子: " ++ genome ++
                   "\n理想プロファイル: " ++ task_profile ++
                   "\n\nこのプロファイルに対する適合度を 0.0 から 1.0 の単一の decimal number で返してください。説明禁止。数値1つだけ。";
      var ai_text = ai_call_with_system(persona, prompt);
      var ai_score = now util.parse_score(ai_text, digits) timeout 5000 else 0;
      reply(ai_score);
    } else {
    // Deterministic: fraction of profile axes the genome matches.
    var matches = 0;
    var total = 0;
    var rest = task_profile;
    while (str_len(rest) > 0) do {
      var bar = str_index(rest, "|");
      var pair = "";
      if (bar < 0) {
        pair = rest;
        rest = "";
      } else {
        pair = str_sub(rest, 0, bar);
        rest = str_sub(rest, bar + 1);
      }
      var eq = str_index(pair, "=");
      if (eq >= 0) {
        var axis = str_sub(pair, 0, eq);
        var want = str_sub(pair, eq + 1);
        var key = axis ++ "=";
        var gidx = str_index(genome, key);
        if (gidx >= 0) {
          var gstart = gidx + str_len(key);
          var grest = str_sub(genome, gstart);
          var gbar = str_index(grest, "|");
          var got = "";
          if (gbar < 0) { got = grest; }
          else { got = str_sub(grest, 0, gbar); }
          if (got == want) { matches = matches + 1; }
        }
        total = total + 1;
      }
    }
    var s = 0.0;
    if (total > 0) { s = (matches + 0.0) / (total + 0.0); }
    reply(s);
    }
  }

  method get_weight() { reply(weight); }
}

// --------------------------------------------------------------------
// Evaluator — fans out reviewer scoring with `future`, awaits, aggregates.
// The class is codegen'd with exactly n_reviewers slots (see
// aipl_codegen.py) so init() arity matches the bootstrap call for any N.
// --------------------------------------------------------------------

class Evaluator {
  var r1 = 0;
  var r2 = 0;
  var r3 = 0;
  var r4 = 0;
  var r5 = 0;
  var r6 = 0;

  method init(rev1, rev2, rev3, rev4, rev5, rev6) {
    r1 = rev1;
    r2 = rev2;
    r3 = rev3;
    r4 = rev4;
    r5 = rev5;
    r6 = rev6;
  }

  method score_for_task(genome, profile) {
    var f1 = future r1.score(genome, profile);
    var f2 = future r2.score(genome, profile);
    var f3 = future r3.score(genome, profile);
    var f4 = future r4.score(genome, profile);
    var f5 = future r5.score(genome, profile);
    var f6 = future r6.score(genome, profile);
    var s1 = await(f1) timeout 5000 else 0;
    var w1 = now r1.get_weight() timeout 5000 else 0;
    var s2 = await(f2) timeout 5000 else 0;
    var w2 = now r2.get_weight() timeout 5000 else 0;
    var s3 = await(f3) timeout 5000 else 0;
    var w3 = now r3.get_weight() timeout 5000 else 0;
    var s4 = await(f4) timeout 5000 else 0;
    var w4 = now r4.get_weight() timeout 5000 else 0;
    var s5 = await(f5) timeout 5000 else 0;
    var w5 = now r5.get_weight() timeout 5000 else 0;
    var s6 = await(f6) timeout 5000 else 0;
    var w6 = now r6.get_weight() timeout 5000 else 0;
    // v4 hard-floor: if reviewer 6 ('R6_RealWorldPrecedent') returned 0.0, overall fitness = 0.0.
    if (s6 == 0.0) { reply(0.0); }
    else {
      var combined = s1 * w1 + s2 * w2 + s3 * w3 + s4 * w4 + s5 * w5 + s6 * w6;
      reply(combined);
    }
  }
}

// --------------------------------------------------------------------
// EliteMap — cell -> champion id mapping with parallel arrays
// --------------------------------------------------------------------

class EliteMap {
  var cells = [];
  var ids = [];
  var scores = [];
  var genomes = [];

  method propose(cell, ind_id, genome, score) {
    var n = array_len(cells);
    var i = 0;
    var idx = -1;
    while (i < n) do {
      if (array_get(cells, i) == cell) {
        idx = i;
        i = n;
      } else {
        i = i + 1;
      }
    }
    if (idx < 0) {
      array_push(cells, cell);
      array_push(ids, ind_id);
      array_push(scores, score);
      array_push(genomes, genome);
      reply(1);
    } else {
      var existing = array_get(scores, idx);
      if (score > existing) {
        array_set(ids, idx, ind_id);
        array_set(scores, idx, score);
        array_set(genomes, idx, genome);
        reply(1);
      } else {
        reply(0);
      }
    }
  }

  method size() { reply(array_len(cells)); }

  method sample_random_genome() {
    var n = array_len(cells);
    if (n == 0) { reply(""); }
    else { reply(array_get(genomes, random(n))); }
  }

  method best_summary(top_k) {
    var n = array_len(cells);
    var i = 0;
    var out = "";
    while (i < n) do {
      var line = "  cell=" ++ array_get(cells, i) ++
                 "  score=" ++ array_get(scores, i) ++
                 "  id=" ++ array_get(ids, i);
      if (i == 0) { out = line; }
      else { out = out ++ "\n" ++ line; }
      i = i + 1;
    }
    reply(out);
  }
}

// --------------------------------------------------------------------
// Lineage — append-only individual record
// --------------------------------------------------------------------

class Lineage {
  var ids = [];
  var genomes = [];
  var parents = [];
  var scores = [];
  var generations = [];
  var operators = [];
  var cells = [];

  method add(id, genome, parent, score, gen, op, cell) {
    array_push(ids, id);
    array_push(genomes, genome);
    array_push(parents, parent);
    array_push(scores, score);
    array_push(generations, gen);
    array_push(operators, op);
    array_push(cells, cell);
    reply(array_len(ids));
  }

  method dump(path) {
    var n = array_len(ids);
    var i = 0;
    var out = "[\n";
    while (i < n) do {
      // score gets a trailing "0" so 0.0 stringifies to "0.00"
      // (Python runtime emits "0." which would be invalid JSON).
      var entry = "  {\"id\":\"" ++ array_get(ids, i) ++ "\"," ++
                  "\"genome\":\"" ++ array_get(genomes, i) ++ "\"," ++
                  "\"parent\":\"" ++ array_get(parents, i) ++ "\"," ++
                  "\"score\":" ++ array_get(scores, i) ++ "0," ++
                  "\"generation\":" ++ array_get(generations, i) ++ "," ++
                  "\"operator\":\"" ++ array_get(operators, i) ++ "\"," ++
                  "\"cell\":\"" ++ array_get(cells, i) ++ "\"}";
      if (i < n - 1) { out = out ++ entry ++ ",\n"; }
      else { out = out ++ entry ++ "\n"; }
      i = i + 1;
    }
    out = out ++ "]\n";
    write_file(path, out);
    reply(n);
  }
}

// --------------------------------------------------------------------
// TaskProfiles — embedded per-task ideal genome fragments
// --------------------------------------------------------------------

class TaskProfiles {
  // task profiles inlined into get(); no separate methods.

  method get(task_name) {
    if (task_name == "PiChudnovskyBsplit") { reply(""); }
    else if (task_name == "FactorialN") { reply(""); }
    else if (task_name == "QuicksortInPlace") { reply(""); }
    else if (task_name == "FFTMultiply") { reply(""); }
    else if (task_name == "MatmulNCubed") { reply(""); }
    else if (task_name == "FibonacciClosedForm") { reply(""); }
    else { reply(""); }
  }
}

// --------------------------------------------------------------------
// Coordinator — main loop
// --------------------------------------------------------------------

class Coordinator {
  var util = 0;
  var generator = 0;
  var evaluator = 0;
  var elite = 0;
  var lineage = 0;
  var profiles = 0;
  var worker = 0;

  var seed_count = 8;
  var generations = 30;
  var cell_axes_csv = "paradigm,type_system,arithmetic_primitives,control_flow,syntax_family";
  var task_csv = "PiChudnovskyBsplit,FactorialN,QuicksortInPlace,FFTMultiply,MatmulNCubed,FibonacciClosedForm";
  var next_id = 0;

  method init(u, g, e, em, lg, tp, w) {
    util = u;
    generator = g;
    evaluator = e;
    elite = em;
    lineage = lg;
    profiles = tp;
    worker = w;
  }

  method run() {
    print("=== LangDesign_Expressive_v4 (AIPL — Actor-based Intelligent Parallel Language — orchestrator) ===");
    print("seed_count=" ++ seed_count ++ "  generations=" ++ generations);

    // Phase 1: seed
    var i = 0;
    while (i < seed_count) do {
      var g = now generator.seed() timeout 5000 else 0;
      next_id = next_id + 1;
      var id = "I" ++ next_id;
      var cell = now worker.compute_cell(g, cell_axes_csv) timeout 5000 else 0;
      var score = now worker.compute_score(g, task_csv) timeout 5000 else 0;
      send lineage.add(id, g, "", score, 0, "seed", cell);
      send elite.propose(cell, id, g, score);
      i = i + 1;
    }
    print("[seed] elite cells filled: " ++ (now elite.size() timeout 5000 else 0));

    // Phase 2: evolution
    var gen = 1;
    while (gen <= generations) do {
      var parent = now elite.sample_random_genome() timeout 5000 else "";
      var size = now elite.size() timeout 5000 else 0;
      var do_cross = 0;
      if (random(10) < 3) {
        if (size >= 2) { do_cross = 1; }
      }
      var child = "";
      var op = "";
      if (do_cross == 1) {
        var partner = now elite.sample_random_genome() timeout 5000 else "";
        child = now generator.cross(parent, partner) timeout 5000 else 0;
        op = "uniform_crossover";
      } else {
        child = now generator.mutate(parent) timeout 5000 else 0;
        op = "axis_resample";
      }
      next_id = next_id + 1;
      var cid = "I" ++ next_id;
      var ccell = now worker.compute_cell(child, cell_axes_csv) timeout 5000 else 0;
      var cscore = now worker.compute_score(child, task_csv) timeout 5000 else 0;
      send lineage.add(cid, child, "", cscore, gen, op, ccell);
      send elite.propose(ccell, cid, child, cscore);
      // crash-recovery: flush lineage every generation so silent SDK
      // hangs (cf. Pi_Phase1_OpenSearch v3 attempt 2026-05-16) do not
      // lose the partial result.  Cost: one fs write per generation.
      var ckpt_n = now lineage.dump("out/LangDesign_Expressive_v4.aipl_lineage.json") timeout 5000 else 0;
      print("[ckpt gen=" ++ gen ++ "] flushed " ++ ckpt_n ++ " individuals");
      gen = gen + 1;
    }

    print("[done] cells filled: " ++ (now elite.size() timeout 5000 else 0));
    print(now elite.best_summary(5) timeout 5000 else 0);

    var n = now lineage.dump("out/LangDesign_Expressive_v4.aipl_lineage.json") timeout 5000 else 0;
    print("[lineage] wrote " ++ n ++ " individuals to out/LangDesign_Expressive_v4.aipl_lineage.json");
  }
}

// --------------------------------------------------------------------
// Bootstrap (top-level)
// --------------------------------------------------------------------

var util = new Util();
var digits = new DigitOps();
var generator = new Generator(util, "paradigm,evaluation_strategy,type_system,arithmetic_primitives,precision_control,control_flow,termination_check,memory_management,io_model,syntax_family,abstraction,compilation_target", "paradigm:imperative,functional,dataflow,term_rewriting,declarative_equation,oo,hybrid_imperative_functional|evaluation_strategy:strict,lazy,call_by_need,call_by_name|type_system:dynamic,static_simple,hindley_milner,refinement,dependent|arithmetic_primitives:arbitrary_int,arbitrary_int_plus_rational,decimal_with_precision,real_with_precision_annotation,interval_arithmetic,dependent_precision|precision_control:implicit,global_const,per_value_annotation,automatic_inference,proof_obligation|control_flow:structured_loops,general_recursion,tail_call_only,pattern_match_fold,list_comprehension,monadic_bind|termination_check:none,structural_recursion,well_founded,totality|memory_management:manual,gc,region_typed,rc,linear,borrow_check|io_model:print_only,stream_emit,file_io_imperative,region_owned_output,monadic_io|syntax_family:c_like,ml_like,lisp_like,apl_like,haskell_like,python_like,prolog_like,custom_minimal|abstraction:bare_metal,libc,vm_minimal,stdlib_rich|compilation_target:tree_walker_interpreter,bytecode_vm");
var elite = new EliteMap();
var lineage = new Lineage();
var profiles = new TaskProfiles();

var rev1 = new Reviewer("R1_AlgorithmExpressivity", "あなたは R1 (アルゴリズム表現力) を判定するレビュアーです。候補の 12 軸を見て、Chudnovsky binary-splitting が当該言語の構文だけで書けるか判定。基準: 50 行以内 → 1.0、100 行以内 → 0.7、200 行以内 → 0.3、書けない → 0.0。0.0-1.0 の decimal で半角数字 1 つだけ返してください。", 1, 0.25, util, digits);
var rev2 = new Reviewer("R2_ArbitraryPrecisionSafety", "あなたは R2 (任意精度安全性) を判定するレビュアーです。arithmetic_primitives と precision_control を見て、N=10000 桁の正確計算が型で保証されるかを判定。1.0 = arbitrary_int_plus_rational 以上 + per_value_annotation 以上、0.7 = arbitrary 系 + implicit/global_const、0.3 = decimal_with_precision のみ、0.0 = それ以下。0.0-1.0 で半角数字 1 つだけ。", 1, 0.2, util, digits);
var rev3 = new Reviewer("R3_RecursionAndIteration", "あなたは R3 (制御フロー) を判定するレビュアーです。control_flow と termination_check の組合せが、binary tree 再帰と loop の両方を表現できるか判定。1.0 = general_recursion か structured_loops 両方が表現可能、0.7 = tail_call_only 制約付き、0.3 = pattern_match_fold のみ、0.0 = list_comprehension のみ。0.0-1.0 の decimal を半角数字 1 つだけ。", 1, 0.15, util, digits);
var rev4 = new Reviewer("R4_ImplementabilityFeasibility", "あなたは R4 (ホスト実装可能性) を判定するレビュアーです。compilation_target, syntax_family, type_system, paradigm が Python ホストで 500-3000 行の interpreter として書けるか判定。1.0 = tree_walker + ml_like/c_like/python_like + dynamic/static_simple/hindley_milner、0.7 = bytecode_vm + 単純型、0.3 = dependent 型、0.0 = 重複した複雑さ。0.0-1.0 の decimal を半角数字 1 つだけ。", 1, 0.15, util, digits);
var rev5 = new Reviewer("R5_Generality", "あなたは R5 (汎用性) を判定するレビュアーです。各タスクが要求する primitive と候補の軸を照合: (1) PiChudnovskyBsplit: arbitrary_int_plus_rational + 再帰 + Real sqrt 必須。(2) FactorialN: arbitrary_int + 再帰 OR loop。(3) QuicksortInPlace: 可変配列または ref + 再帰 (gc/rc/manual 可、linear/borrow_check は困難)。(4) FFTMultiply: 配列 + 複素数 (refinement/dependent/interval_arithmetic 型で表現可) + 再帰。(5) MatmulNCubed: 2D 配列 + structured_loops 必須。(6) FibonacciClosedForm: 代数的数 (refinement/dependent) OR 行列累乗 (structured_loops + 配列)。満たすタスク数 / 6 を 0.0-1.0 の decimal で返してください。", 1, 0.15, util, digits);
var rev6 = new Reviewer("R6_RealWorldPrecedent", "あなたは R6 (現実世界の先例) を判定するレビュアーです。候補の 12 軸が現実に存在する言語のうちどれに近いかを判定する。先例表: (1) OCaml = functional + hindley_milner + arbitrary_int_plus_rational + general_recursion + ml_like; (2) Haskell = functional + hindley_milner + arbitrary_int_plus_rational + lazy + haskell_like; (3) Python = hybrid/imperative + dynamic + arbitrary_int + structured_loops + python_like; (4) Common Lisp = functional/hybrid + dynamic + arbitrary_int_plus_rational + general_recursion + lisp_like; (5) Scheme = functional + dynamic + arbitrary_int_plus_rational + tail_call_only + lisp_like; (6) SML = functional + hindley_milner + arbitrary_int + general_recursion + ml_like; (7) Idris/Agda/Coq = functional + dependent + arbitrary_int + structural_recursion or totality + ml_like/haskell_like; (8) Prolog = declarative_equation + dynamic + arbitrary_int + pattern_match_fold + prolog_like; (9) APL/J/K = dataflow + dynamic + arbitrary_int + list_comprehension + apl_like; (10) Mathematica = term_rewriting + dynamic + arbitrary_int_plus_rational + pattern_match_fold + lisp_like/custom_minimal。スコア: 5 軸以上一致 → 1.0、3-4 軸一致 → 0.5、2 軸以下 → 0.0 (これが返ったら hard floor で最終 fitness = 0)。0.0-1.0 の decimal を半角数字 1 つだけ。", 1, 0.1, util, digits);
var eval_actor = new Evaluator(rev1, rev2, rev3, rev4, rev5, rev6);
var worker = new Worker(util, eval_actor, profiles);
var coord = new Coordinator(util, generator, eval_actor, elite, lineage, profiles, worker);
send coord.run();
