// --------------------------------------------------------------------
// DigitOps — peer actor for parse_score so Util can avoid self-call.
// --------------------------------------------------------------------

class DigitOps {
  method val(c) {
    if (c == "0") { reply(0); }
    else if (c == "1") { reply(1); }
    else if (c == "2") { reply(2); }
    else if (c == "3") { reply(3); }
    else if (c == "4") { reply(4); }
    else if (c == "5") { reply(5); }
    else if (c == "6") { reply(6); }
    else if (c == "7") { reply(7); }
    else if (c == "8") { reply(8); }
    else if (c == "9") { reply(9); }
    else { reply(-1); }
  }
}

// --------------------------------------------------------------------
// Worker — compound operations that orchestrate Util/Evaluator/Profiles.
// Lives in its own actor so its callers (e.g. Coordinator) can use `now`
// without re-entering themselves.
// --------------------------------------------------------------------

class Worker {
  var util = 0;
  var evaluator = 0;
  var profiles = 0;

  method init(u, e, p) {
    util = u;
    evaluator = e;
    profiles = p;
  }

  method compute_cell(genome, cell_axes_csv) {
    var n = now util.count_csv(cell_axes_csv) timeout 5000 else 0;
    var i = 0;
    var out = "";
    while (i < n) do {
      var axis = now util.nth_csv(cell_axes_csv, i) timeout 5000 else 0;
      var v = now util.get_axis(genome, axis) timeout 5000 else "";
      if (i == 0) { out = axis ++ "=" ++ v; }
      else { out = out ++ "|" ++ axis ++ "=" ++ v; }
      i = i + 1;
    }
    reply(out);
  }

  method compute_score(genome, task_csv) {
    var n = now util.count_csv(task_csv) timeout 5000 else 0;
    var i = 0;
    var sum = 0.0;
    while (i < n) do {
      var task = now util.nth_csv(task_csv, i) timeout 5000 else 0;
      var prof = now profiles.get(task) timeout 5000 else "";
      var s = now evaluator.score_for_task(genome, prof) timeout 5000 else 0;
      sum = sum + s;
      i = i + 1;
    }
    var avg = sum;
    if (n > 0) { avg = sum / (n + 0.0); }
    reply(avg);
  }
}

// --------------------------------------------------------------------
// Generator — seed / mutate / crossover
// --------------------------------------------------------------------

class Generator {
  var util = 0;
  var axes_csv = "";
  var values_table = "";

  method init(u, axes, values) {
    util = u;
    axes_csv = axes;
    values_table = values;
  }

  // v4 (2026-05-17): seed / mutate / cross now rejection-sample on the
  // schema's coherence rules (via Util.is_coherent).  Up to 50 attempts;
  // on every retry exhausted, the last candidate is returned even if
  // incoherent, so the evolution never deadlocks on infeasible schemas.

  method seed() {
    var tries = 0;
    var g = "";
    var ok = 0;
    while (ok == 0) do {
      var n_axes = now util.count_csv(axes_csv) timeout 5000 else 0;
      var i = 0;
      var cand = "";
      while (i < n_axes) do {
        var axis = now util.nth_csv(axes_csv, i) timeout 5000 else 0;
        var vals = now util.axis_values(values_table, axis) timeout 5000 else "";
        var n_vals = now util.count_csv(vals) timeout 5000 else 0;
        var v = now util.nth_csv(vals, random(n_vals)) timeout 5000 else 0;
        if (i == 0) { cand = axis ++ "=" ++ v; }
        else { cand = cand ++ "|" ++ axis ++ "=" ++ v; }
        i = i + 1;
      }
      g = cand;
      ok = now util.is_coherent(g) timeout 5000 else 0;
      tries = tries + 1;
      if (tries >= 50) { ok = 1; }
    }
    reply(g);
  }

  method mutate(parent) {
    var tries = 0;
    var child = parent;
    var ok = 0;
    while (ok == 0) do {
      var n_axes = now util.count_csv(axes_csv) timeout 5000 else 0;
      var idx = random(n_axes);
      var axis = now util.nth_csv(axes_csv, idx) timeout 5000 else 0;
      var vals = now util.axis_values(values_table, axis) timeout 5000 else "";
      var n_vals = now util.count_csv(vals) timeout 5000 else 0;
      var v = now util.nth_csv(vals, random(n_vals)) timeout 5000 else 0;
      var cand = now util.set_axis(parent, axis, v) timeout 5000 else 0;
      child = cand;
      ok = now util.is_coherent(child) timeout 5000 else 0;
      tries = tries + 1;
      if (tries >= 50) { ok = 1; }
    }
    reply(child);
  }

  method cross(a, b) {
    var tries = 0;
    var child = a;
    var ok = 0;
    while (ok == 0) do {
      var n_axes = now util.count_csv(axes_csv) timeout 5000 else 0;
      var i = 0;
      var cand = "";
      while (i < n_axes) do {
        var axis = now util.nth_csv(axes_csv, i) timeout 5000 else 0;
        var src = a;
        if (random(2) == 1) { src = b; }
        var v = now util.get_axis(src, axis) timeout 5000 else "";
        if (i == 0) { cand = axis ++ "=" ++ v; }
        else { cand = cand ++ "|" ++ axis ++ "=" ++ v; }
        i = i + 1;
      }
      child = cand;
      ok = now util.is_coherent(child) timeout 5000 else 0;
      tries = tries + 1;
      if (tries >= 50) { ok = 1; }
    }
    reply(child);
  }
}

// --------------------------------------------------------------------
// Reviewer — one ai_call_with_system per score request (Phase 6),
//            deterministic scoring (Phase 5).
// --------------------------------------------------------------------

class Reviewer {
  var name = "";
  var persona = "";
  var use_ai = 0;
  var weight = 0.0;
  var util = 0;
  var digits = 0;

  method init(n, p, u, w, util_actor, digits_actor) {
    name = n;
    persona = p;
    use_ai = u;
    weight = w;
    util = util_actor;
    digits = digits_actor;
  }

  method score(genome, task_profile) {
    if (use_ai == 1) {
      var prompt = "評価対象の遺伝子: " ++ genome ++
                   "\n理想プロファイル: " ++ task_profile ++
                   "\n\nこのプロファイルに対する適合度を 0.0 から 1.0 の単一の decimal number で返してください。説明禁止。数値1つだけ。";
      var ai_text = ai_call_with_system(persona, prompt);
      var ai_score = now util.parse_score(ai_text, digits) timeout 5000 else 0;
      reply(ai_score);
    } else {
    // Deterministic: fraction of profile axes the genome matches.
    var matches = 0;
    var total = 0;
    var rest = task_profile;
    while (str_len(rest) > 0) do {
      var bar = str_index(rest, "|");
      var pair = "";
      if (bar < 0) {
        pair = rest;
        rest = "";
      } else {
        pair = str_sub(rest, 0, bar);
        rest = str_sub(rest, bar + 1);
      }
      var eq = str_index(pair, "=");
      if (eq >= 0) {
        var axis = str_sub(pair, 0, eq);
        var want = str_sub(pair, eq + 1);
        var key = axis ++ "=";
        var gidx = str_index(genome, key);
        if (gidx >= 0) {
          var gstart = gidx + str_len(key);
          var grest = str_sub(genome, gstart);
          var gbar = str_index(grest, "|");
          var got = "";
          if (gbar < 0) { got = grest; }
          else { got = str_sub(grest, 0, gbar); }
          if (got == want) { matches = matches + 1; }
        }
        total = total + 1;
      }
    }
    var s = 0.0;
    if (total > 0) { s = (matches + 0.0) / (total + 0.0); }
    reply(s);
    }
  }

  method get_weight() { reply(weight); }
}

// --------------------------------------------------------------------
// Evaluator — fans out reviewer scoring with `future`, awaits, aggregates.
// The class is codegen'd with exactly n_reviewers slots (see
// aipl_codegen.py) so init() arity matches the bootstrap call for any N.
// --------------------------------------------------------------------

class Evaluator {
  var r1 = 0;
  var r2 = 0;
  var r3 = 0;
  var r4 = 0;

  method init(rev1, rev2, rev3, rev4) {
    r1 = rev1;
    r2 = rev2;
    r3 = rev3;
    r4 = rev4;
  }

  method score_for_task(genome, profile) {
    var f1 = future r1.score(genome, profile);
    var f2 = future r2.score(genome, profile);
    var f3 = future r3.score(genome, profile);
    var f4 = future r4.score(genome, profile);
    var s1 = await(f1) timeout 5000 else 0;
    var w1 = now r1.get_weight() timeout 5000 else 0;
    var s2 = await(f2) timeout 5000 else 0;
    var w2 = now r2.get_weight() timeout 5000 else 0;
    var s3 = await(f3) timeout 5000 else 0;
    var w3 = now r3.get_weight() timeout 5000 else 0;
    var s4 = await(f4) timeout 5000 else 0;
    var w4 = now r4.get_weight() timeout 5000 else 0;
    var combined = s1 * w1 + s2 * w2 + s3 * w3 + s4 * w4;
    reply(combined);
  }
}

// --------------------------------------------------------------------
// EliteMap — cell -> champion id mapping with parallel arrays
// --------------------------------------------------------------------

class EliteMap {
  var cells = [];
  var ids = [];
  var scores = [];
  var genomes = [];

  method propose(cell, ind_id, genome, score) {
    var n = array_len(cells);
    var i = 0;
    var idx = -1;
    while (i < n) do {
      if (array_get(cells, i) == cell) {
        idx = i;
        i = n;
      } else {
        i = i + 1;
      }
    }
    if (idx < 0) {
      array_push(cells, cell);
      array_push(ids, ind_id);
      array_push(scores, score);
      array_push(genomes, genome);
      reply(1);
    } else {
      var existing = array_get(scores, idx);
      if (score > existing) {
        array_set(ids, idx, ind_id);
        array_set(scores, idx, score);
        array_set(genomes, idx, genome);
        reply(1);
      } else {
        reply(0);
      }
    }
  }

  method size() { reply(array_len(cells)); }

  method sample_random_genome() {
    var n = array_len(cells);
    if (n == 0) { reply(""); }
    else { reply(array_get(genomes, random(n))); }
  }

  method best_summary(top_k) {
    var n = array_len(cells);
    var i = 0;
    var out = "";
    while (i < n) do {
      var line = "  cell=" ++ array_get(cells, i) ++
                 "  score=" ++ array_get(scores, i) ++
                 "  id=" ++ array_get(ids, i);
      if (i == 0) { out = line; }
      else { out = out ++ "\n" ++ line; }
      i = i + 1;
    }
    reply(out);
  }
}

// --------------------------------------------------------------------
// Lineage — append-only individual record
// --------------------------------------------------------------------

class Lineage {
  var ids = [];
  var genomes = [];
  var parents = [];
  var scores = [];
  var generations = [];
  var operators = [];
  var cells = [];

  method add(id, genome, parent, score, gen, op, cell) {
    array_push(ids, id);
    array_push(genomes, genome);
    array_push(parents, parent);
    array_push(scores, score);
    array_push(generations, gen);
    array_push(operators, op);
    array_push(cells, cell);
    reply(array_len(ids));
  }

  method dump(path) {
    var n = array_len(ids);
    var i = 0;
    var out = "[\n";
    while (i < n) do {
      // score gets a trailing "0" so 0.0 stringifies to "0.00"
      // (Python runtime emits "0." which would be invalid JSON).
      var entry = "  {\"id\":\"" ++ array_get(ids, i) ++ "\"," ++
                  "\"genome\":\"" ++ array_get(genomes, i) ++ "\"," ++
                  "\"parent\":\"" ++ array_get(parents, i) ++ "\"," ++
                  "\"score\":" ++ array_get(scores, i) ++ "0," ++
                  "\"generation\":" ++ array_get(generations, i) ++ "," ++
                  "\"operator\":\"" ++ array_get(operators, i) ++ "\"," ++
                  "\"cell\":\"" ++ array_get(cells, i) ++ "\"}";
      if (i < n - 1) { out = out ++ entry ++ ",\n"; }
      else { out = out ++ entry ++ "\n"; }
      i = i + 1;
    }
    out = out ++ "]\n";
    write_file(path, out);
    reply(n);
  }
}

// --------------------------------------------------------------------
// TaskProfiles — embedded per-task ideal genome fragments
// --------------------------------------------------------------------

class TaskProfiles {
  // task profiles inlined into get(); no separate methods.

  method get(task_name) {
    if (task_name == "S1_PriorityAging") { reply(""); }
    else if (task_name == "S2_MLFQ") { reply(""); }
    else if (task_name == "S3_DeadlineHints") { reply(""); }
    else if (task_name == "S4_IdlePower") { reply(""); }
    else if (task_name == "M1_BuddyAllocator") { reply(""); }
    else if (task_name == "M2_SlabCache") { reply(""); }
    else if (task_name == "M3_DemandPaging") { reply(""); }
    else if (task_name == "N1f_FixSmc91c111") { reply(""); }
    else if (task_name == "N2_ZeroCopyBuffers") { reply(""); }
    else if (task_name == "N3_SocketSyscalls") { reply(""); }
    else if (task_name == "A1_ArmRpi3Port") { reply(""); }
    else if (task_name == "A2_MmuBringup") { reply(""); }
    else if (task_name == "A3_RealRpiGPIO") { reply(""); }
    else if (task_name == "Sec1_StackCanaries") { reply(""); }
    else if (task_name == "Sec2_CapTokens") { reply(""); }
    else if (task_name == "Sec3_MeasuredBoot") { reply(""); }
    else if (task_name == "R_AiplBackwardCompat") { reply(""); }
    else if (task_name == "ImplCost") { reply(""); }
    else { reply(""); }
  }
}

// --------------------------------------------------------------------
// Coordinator — main loop
// --------------------------------------------------------------------

class Coordinator {
  var util = 0;
  var generator = 0;
  var evaluator = 0;
  var elite = 0;
  var lineage = 0;
  var profiles = 0;
  var worker = 0;

  var seed_count = 6;
  var generations = 20;
  var cell_axes_csv = "paradigm";
  var task_csv = "S1_PriorityAging,S2_MLFQ,S3_DeadlineHints,S4_IdlePower,M1_BuddyAllocator,M2_SlabCache,M3_DemandPaging,N1f_FixSmc91c111,N2_ZeroCopyBuffers,N3_SocketSyscalls,A1_ArmRpi3Port,A2_MmuBringup,A3_RealRpiGPIO,Sec1_StackCanaries,Sec2_CapTokens,Sec3_MeasuredBoot,R_AiplBackwardCompat,ImplCost";
  var next_id = 0;

  method init(u, g, e, em, lg, tp, w) {
    util = u;
    generator = g;
    evaluator = e;
    elite = em;
    lineage = lg;
    profiles = tp;
    worker = w;
  }

  method run() {
    print("=== Xinu_KernelEvolution_Round1 (AIPL — Actor-based Intelligent Parallel Language — orchestrator) ===");
    print("seed_count=" ++ seed_count ++ "  generations=" ++ generations);

    // Phase 1: seed
    var i = 0;
    while (i < seed_count) do {
      var g = now generator.seed() timeout 5000 else 0;
      next_id = next_id + 1;
      var id = "I" ++ next_id;
      var cell = now worker.compute_cell(g, cell_axes_csv) timeout 5000 else 0;
      var score = now worker.compute_score(g, task_csv) timeout 5000 else 0;
      send lineage.add(id, g, "", score, 0, "seed", cell);
      send elite.propose(cell, id, g, score);
      i = i + 1;
    }
    print("[seed] elite cells filled: " ++ (now elite.size() timeout 5000 else 0));

    // Phase 2: evolution
    var gen = 1;
    while (gen <= generations) do {
      var parent = now elite.sample_random_genome() timeout 5000 else "";
      var size = now elite.size() timeout 5000 else 0;
      var do_cross = 0;
      if (random(10) < 3) {
        if (size >= 2) { do_cross = 1; }
      }
      var child = "";
      var op = "";
      if (do_cross == 1) {
        var partner = now elite.sample_random_genome() timeout 5000 else "";
        child = now generator.cross(parent, partner) timeout 5000 else 0;
        op = "uniform_crossover";
      } else {
        child = now generator.mutate(parent) timeout 5000 else 0;
        op = "axis_resample";
      }
      next_id = next_id + 1;
      var cid = "I" ++ next_id;
      var ccell = now worker.compute_cell(child, cell_axes_csv) timeout 5000 else 0;
      var cscore = now worker.compute_score(child, task_csv) timeout 5000 else 0;
      send lineage.add(cid, child, "", cscore, gen, op, ccell);
      send elite.propose(ccell, cid, child, cscore);
      // crash-recovery: flush lineage every generation so silent SDK
      // hangs (cf. Pi_Phase1_OpenSearch v3 attempt 2026-05-16) do not
      // lose the partial result.  Cost: one fs write per generation.
      var ckpt_n = now lineage.dump("out/Xinu_KernelEvolution_Round1.aipl_lineage.json") timeout 5000 else 0;
      print("[ckpt gen=" ++ gen ++ "] flushed " ++ ckpt_n ++ " individuals");
      gen = gen + 1;
    }

    print("[done] cells filled: " ++ (now elite.size() timeout 5000 else 0));
    print(now elite.best_summary(5) timeout 5000 else 0);

    var n = now lineage.dump("out/Xinu_KernelEvolution_Round1.aipl_lineage.json") timeout 5000 else 0;
    print("[lineage] wrote " ++ n ++ " individuals to out/Xinu_KernelEvolution_Round1.aipl_lineage.json");
  }
}

// --------------------------------------------------------------------
// Bootstrap (top-level)
// --------------------------------------------------------------------

var util = new Util();
var digits = new DigitOps();
var generator = new Generator(util, "scheduler,memory_alloc,ipc_primitive,isolation,arch_target,power_mgmt,concurrency_safety", "scheduler:round_robin,priority_static,priority_aging,mlfq,edf_soft,cfs_like|memory_alloc:bump,freelist,buddy,slab,demand_paged,cow|ipc_primitive:sem_mailbox,channel_typed,capability,tuple_space,actor_lockfree|isolation:none,user_kernel_split,mmu_per_process,capability_token,container_like|arch_target:arm_versatilepb,arm_rpi3,arm_rpi4,x86_64,riscv32,multi_arch|power_mgmt:always_on,halt_idle,dvfs,deep_sleep|concurrency_safety:critical_section,spinlock,lock_free,rcu,stm");
var elite = new EliteMap();
var lineage = new Lineage();
var profiles = new TaskProfiles();

var rev1 = new Reviewer("R_KernelSafety", "あなたは R_KernelSafety を判定するレビュアーです。候補設計 (scheduler / memory_alloc / ipc_primitive / isolation / arch_target / power_mgmt / concurrency_safety の 7 軸) を見て、Embedded Xinu の kernel として『誤った user code が kernel を panic させない』『double-free / use-after-free / race-stack-corruption が起きない』『割り込み中の disable() 漏れで dead-lock しない』を判定する。スコア基準: 1.0 = isolation=mmu_per_process or container_like + concurrency_safety=lock_free/rcu/stm + memory_alloc=demand_paged/cow (= 強い空間分離 + 安全な並行制御 + page-fault 経由の lazy commit)、0.7 = isolation=capability_token + concurrency_safety=lock_free + memory_alloc=slab/buddy (= ケーパビリティ + lockfree、メモリ管理は古典)、0.3 = isolation=user_kernel_split + concurrency_safety=spinlock + memory_alloc=freelist (= 基本的な分離のみ)、0.0 = isolation=none + concurrency_safety=critical_section + memory_alloc=bump (= 教育用最小)。半角数字の decimal で答えてください。", 1, 0.3, util, digits);
var rev2 = new Reviewer("R_PerformanceLatency", "あなたは R_PerformanceLatency を判定するレビュアーです。候補設計の scheduler と concurrency_safety を見て、AIPL actor の message-passing 平均 latency p99 と、wake-from-idle latency、IRQ → user-thread dispatch latency を推定する。スコア基準: 1.0 = scheduler=cfs_like + concurrency_safety=lock_free/rcu (= 公平 + 競合フリー、p99 < 100us 想定)、0.7 = scheduler=mlfq + concurrency_safety=lock_free (= 階層 + lockfree)、0.3 = scheduler=priority_aging + concurrency_safety=spinlock、0.0 = scheduler=round_robin + concurrency_safety=critical_section (= ベース)。半角数字の decimal で答えてください。", 1, 0.25, util, digits);
var rev3 = new Reviewer("R_ImplementabilityArm", "あなたは R_ImplementabilityArm を判定するレビュアーです。candidate の arch_target と memory_alloc / isolation の組合せが、実 Raspberry Pi 3/4 (32-bit AArch32 mode) + arm-qemu の両方で現実的に実装できるかを判定する。基準: 1.0 = arch_target=arm_rpi3 or arm_rpi4 + memory_alloc=buddy/slab + isolation=user_kernel_split or capability_token (= MMU の標準的な使い方、500-1500 LOC で書ける)、0.7 = arch_target=multi_arch + memory_alloc=buddy + isolation=user_kernel_split (= マルチアーキ抽象、1500-3000 LOC)、0.3 = arch_target=x86_64 or riscv32 (= Xinu 既存資産との不一致、3000+ LOC)、0.0 = arch_target=arm_versatilepb + memory_alloc=demand_paged or cow (= MMU を晒さない VersatilePB で page management は意味薄)。半角数字の decimal で答えてください。", 1, 0.25, util, digits);
var rev4 = new Reviewer("R_AiplBackwardCompat", "あなたは R_AiplBackwardCompat を判定するレビュアーです。候補設計の変更が AIPL Round 1 で確立した 17 smoke + RemoteRPC host_rpc_demo / host_diners を壊さない確率を判定する。重視: (a) Xinu の API surface (semcreate/wait/signal, create/ready/sleep, kprintf, getmem/freemem, mailbox interface) を ABI 互換に保てるか、(b) UART0 console と UART1 RPC を両方 alive に保てるか、(c) AIPL 生成 C コード (apps/abcl_program.c) の前提 (object_t layout / abcl_enqueue 引数) を破らないか。スコア基準: 1.0 = ipc_primitive=sem_mailbox or actor_lockfree + isolation=none/user_kernel_split (= AIPL の MPSC + critical-section パターンをそのまま支える)、0.7 = ipc_primitive=channel_typed (新 API だが旧 API も並走)、0.3 = ipc_primitive=capability + isolation=container_like (= 大幅 ABI 変更で旧 sample の修正が必要)、0.0 = ipc_primitive=tuple_space (= 完全に違う model)。半角数字の decimal で答えてください。", 1, 0.2, util, digits);
var eval_actor = new Evaluator(rev1, rev2, rev3, rev4);
var worker = new Worker(util, eval_actor, profiles);
var coord = new Coordinator(util, generator, eval_actor, elite, lineage, profiles, worker);
send coord.run();
