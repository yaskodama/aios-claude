        var b0_r = str_sub(genome, b0_i + str_len(b0_k));
        var b0_b = str_index(b0_r, "|");
        if (b0_b < 0) { b0 = b0_r; }
        else { b0 = str_sub(b0_r, 0, b0_b); }
      }

      if (b0 != "") {
        var in_set = 0;
        if (b0 == "demand_paged") { in_set = 1; }
        if (b0 == "cow") { in_set = 1; }
        if (b0 == "buddy") { in_set = 1; }
        if (b0 == "slab") { in_set = 1; }
        if (in_set == 0) { ok = 0; }
