// host_diners.abcl
// Pure-AIPL host side of the 5-philosopher dining problem.
// Runs under the Python AIPL interpreter (src/python-aipl/aipl_main.py)
// and addresses the Xinu Fork actors via the remote() builtins.
//
// PC side  (this file) : Philosopher P1 / P2 / P3 — 3 AIPL actors.
// Xinu side (DiningPhilosophersDistXinu.abcl) : Fork F0..F4 +
//   Philosopher P4 / P5 — 7 AIPL actors.
//
// Both sides are entirely AIPL — no Python orchestration code.
//
// Remote-actor messaging — semantically `send remote(...).a(b,c)` /
// `now remote(...).d(e,f)`, expressed in Py-I's builtin form:
//
//   remote_call(hub, "<id>", "acquire", my_id)
//      ≡ send remote(hub, "<id>").acquire(my_id)       // async
//
//   var h = remote_now(hub, "<id>", "field", 0)
//      ≡ now  remote(hub, "<id>").field(0)             // sync
//
// The "uart1://host:port" hub URL tells aipl_remote.py to route the
// call over the Xinu UART1 RPC dispatcher (SEND/QUERY) instead of
// HTTP/JSON.  The actor name is the numeric Xinu actor id (Forks
// F0..F4 → "0".."4").
//
// Topology (deadlock-free via resource-hierarchy ordering):
//   P1 : low="0" (F0)  high="4" (F4)
//   P2 : low="0" (F0)  high="1" (F1)
//   P3 : low="1" (F1)  high="2" (F2)
//   P4 : low="2" (F2)  high="3" (F3)   (Xinu)
//   P5 : low="3" (F3)  high="4" (F4)   (Xinu)

class Philosopher {
  var my_id        = 0;
  var lo_fork      = "0";   // string actor id "0".."4"
  var hi_fork      = "0";
  var meals_target = 20;
  var meals_done   = 0;
  var attempts     = 0;

  // hub = "uart1://host:port" — the Xinu UART1 RPC endpoint.
  var hub = "uart1://127.0.0.1:5555";

  method init(pid, lo, hi, target) {
    my_id        = pid;
    lo_fork      = lo;
    hi_fork      = hi;
    meals_target = target;
    meals_done   = 0;
    attempts     = 0;
    print("  [P" + my_id + "] thinking (low=F" + lo_fork
          + " high=F" + hi_fork + ")");
    send self.try_eat();
  }

  // Whole acquire/release/eat sequence is inlined.  Each retry
  // re-enters via `send self.try_eat()` (Py-I quirk: an actor cannot
  // do a synchronous self-call from inside another self-call).
  method try_eat() {
    if (meals_done >= meals_target) {
      print("  [P" + my_id + "] done after " + attempts + " attempts");
    } else {
      attempts = attempts + 1;

      // 1. acquire lo_fork  (= send remote(hub, lo_fork).acquire(my_id))
      remote_call(hub, lo_fork, "acquire", my_id);
      sleep(0.025);
      // 2. poll lo_fork.holder  (= now remote(hub, lo_fork).field(0))
      var hlo = remote_now(hub, lo_fork, "field", 0);
      if (hlo != my_id) {
        sleep(0.030);
        send self.try_eat();
      } else {
        // 3. acquire hi_fork
        remote_call(hub, hi_fork, "acquire", my_id);
        sleep(0.025);
        var hhi = remote_now(hub, hi_fork, "field", 0);
        if (hhi != my_id) {
          // got lo only — back off
          remote_call(hub, lo_fork, "release", my_id);
          sleep(0.030);
          send self.try_eat();
        } else {
          // 4. eat
          meals_done = meals_done + 1;
          // Log every meal up to 10, then every 10th to avoid spam
          // when meals_target is large.
          if (meals_done <= 10) {
            print("  [P" + my_id + " ate meal=" + meals_done
                  + "] (attempts=" + attempts + ")");
          } else {
            var bucket = meals_done - ((meals_done / 10) * 10);
            if (bucket == 0) {
              print("  [P" + my_id + " ate meal=" + meals_done
                    + "] (attempts=" + attempts + ")");
            }
          }
          sleep(0.040);
          // 5. release both (high first, mirror of acquire order)
          remote_call(hub, hi_fork, "release", my_id);
          remote_call(hub, lo_fork, "release", my_id);
          sleep(0.010);
          send self.try_eat();
        }
      }
    }
  }
}

// ---- Main orchestration --------------------------------------------

print("=== pure-AIPL diners: 3 PC + 2 Xinu, meals=20 each ===");

var hub_url = "uart1://127.0.0.1:5555";

print("PING -> " + remote_now(hub_url, "_", "ping"));
print("LIST -> " + remote_now(hub_url, "_", "list"));

// Three PC philosophers — each is a real AIPL actor running in its
// own thread.  The Xinu side hosts F0..F4 (Forks) and P4 + P5 at
// the same UART1 endpoint, all addressed by their numeric actor id.
var p1 = new Philosopher(1, "0", "4", 20);
var p2 = new Philosopher(2, "0", "1", 20);
var p3 = new Philosopher(3, "1", "2", 20);
