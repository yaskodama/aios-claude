// host_diners.aipl
// Pure-AIPL host side of the 5-philosopher dining problem.
// Runs under the Python AIPL interpreter (src/python-aipl/aipl_main.py)
// and talks to Xinu's UART1 RPC dispatcher over a single TCP socket.
//
// PC side  (this file) : Philosopher P1 / P2 / P3 — 3 AIPL actors.
// Xinu side (DiningPhilosophersDistXinu.abcl) : Fork F0..F4 +
//   Philosopher P4 / P5 — 7 AIPL actors.
//
// Both sides are entirely AIPL — no Python orchestration code.
//
// Topology (deadlock-free via resource-hierarchy ordering):
//   P1 : low=F0 high=F4
//   P2 : low=F0 high=F1
//   P3 : low=F1 high=F2
//   P4 : low=F2 high=F3   (Xinu)
//   P5 : low=F3 high=F4   (Xinu)
//
// Wire protocol (TCP 127.0.0.1:5555 → Xinu UART1):
//   SEND  <fork_id> acquire <pid>    — try to grab fork
//   SEND  <fork_id> release <pid>    — release fork
//   QUERY <fork_id> 0                — read holder ("OK value=<pid>")
//   LIST                             — sanity check
//
// All socket I/O is funnelled through one Coordinator actor so each
// (request, reply) pair stays atomic across the three concurrent
// philosopher actors that share the connection.

class Coordinator {
  var sock = 0;

  method init(host, port) {
    sock = tcp_connect(host, port, 10.0);
    if (sock <= 0) {
      print("FAIL: tcp_connect failed");
    }
    // Drain the boot greeting ("OK ready=1") best-effort.
    var banner = tcp_recv_line(sock, 0.5);
    print("[greet] " + banner);
  }

  // Synchronous RPC: send a line, return the reply line.
  // `call` is a reserved word in the AIPL parser; the method is
  // therefore named `rpc`.
  method rpc(line) {
    tcp_send_line(sock, line);
    var r = tcp_recv_line(sock, 10.0);
    reply(r);
  }

  method close() {
    tcp_close(sock);
    reply(0);
  }
}

class Philosopher {
  var coord       = 0;
  var my_id       = 0;
  var lo_fork     = 0;
  var hi_fork     = 0;
  var meals_target = 5;
  var meals_done   = 0;
  var attempts     = 0;

  method init(c, pid, lo, hi, target) {
    coord = c;
    my_id = pid;
    lo_fork = lo;
    hi_fork = hi;
    meals_target = target;
    meals_done = 0;
    attempts = 0;
    print("  [P" + my_id + "] thinking (low=F" + lo_fork
          + " high=F" + hi_fork + ")");
    send self.try_eat();
  }

  // Whole acquire/release/eat sequence is inlined.  `now self.X`
  // would deadlock this actor (Py-I quirk: an actor cannot do a
  // synchronous self-call from inside another self-call), so each
  // retry re-enters via `send self.try_eat()` instead.
  method try_eat() {
    if (meals_done >= meals_target) {
      print("  [P" + my_id + "] done after " + attempts + " attempts");
    } else {
      attempts = attempts + 1;

      // 1. acquire lo_fork
      var _a1 = now coord.rpc("SEND " + lo_fork + " acquire " + my_id);
      sleep(0.025);
      var qlo = now coord.rpc("QUERY " + lo_fork + " 0");
      var wlo = "value=" + my_id;
      var plo = str_index(qlo, wlo);
      var glo = 0;
      if (plo >= 0) {
        var tlo = str_sub(qlo, plo + str_len(wlo));
        if (str_len(tlo) == 0) { glo = 1; }
      }
      if (glo == 0) {
        sleep(0.030);
        send self.try_eat();
      } else {
        // 2. acquire hi_fork
        var _a2 = now coord.rpc("SEND " + hi_fork + " acquire " + my_id);
        sleep(0.025);
        var qhi = now coord.rpc("QUERY " + hi_fork + " 0");
        var whi = "value=" + my_id;
        var phi = str_index(qhi, whi);
        var ghi = 0;
        if (phi >= 0) {
          var thi = str_sub(qhi, phi + str_len(whi));
          if (str_len(thi) == 0) { ghi = 1; }
        }
        if (ghi == 0) {
          // got lo only — release and back off
          var _r = now coord.rpc("SEND " + lo_fork + " release " + my_id);
          sleep(0.030);
          send self.try_eat();
        } else {
          // 3. eat
          meals_done = meals_done + 1;
          print("  [P" + my_id + " ate meal=" + meals_done
                + "] (attempts=" + attempts + ")");
          sleep(0.040);
          // 4. release both forks (high first, mirror of acquire order)
          var _rh = now coord.rpc("SEND " + hi_fork + " release " + my_id);
          var _rl = now coord.rpc("SEND " + lo_fork + " release " + my_id);
          sleep(0.010);
          send self.try_eat();
        }
      }
    }
  }
}

// ---- Main orchestration --------------------------------------------

print("=== pure-AIPL diners: 3 PC + 2 Xinu, meals=5 each ===");

var coord = new Coordinator("127.0.0.1", 5555);

print("PING -> " + (now coord.rpc("PING")));
print("LIST -> " + (now coord.rpc("LIST")));

// Three PC philosophers — each is a real AIPL actor running in its
// own thread, all sharing `coord` for socket I/O.  P4 + P5 are
// already alive on the Xinu side via the kernel's AIPL_AUTOSTART.
// Three PC philosophers — each eats 3 times.  The AIPL message-
// dispatch path is much slower than the Python-threaded host
// orchestrator (~60× per round-trip), so 3 meals × 3 PC philos
// plus the Xinu pair finishes in ~2-3 minutes.  Bump MEALS via the
// env var if you want a longer run.
var p1 = new Philosopher(coord, 1, 0, 4, 3);
var p2 = new Philosopher(coord, 2, 0, 1, 3);
var p3 = new Philosopher(coord, 3, 1, 2, 3);
