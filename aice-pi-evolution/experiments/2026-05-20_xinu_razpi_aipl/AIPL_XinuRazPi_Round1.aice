// AIPL_XinuRazPi_Round1.aice  (2026-05-20)
//
// AIPL を Raspberry Pi 系 Embedded Xinu (arm-qemu / 実 Pi) 上で動かす
// 既存パイプラインの進化.
//
//   Round 0 (= 現状, commit f4dd437 以前から残存):
//     - src/aipl2c.ml --xinu フラグ + src/c_translator.ml の
//       gen_program_xinu (3283 行) で .abcl → C への Xinu 専用 codegen
//     - abclc/{Rotate4LinesXinu, Philosophers5Xinu,
//       BoundedBufferXinu}.abcl の 3 サンプル
//     - run_{r4l,p5,bb,pingpong}_xinu.sh 起動スクリプト
//     - /Users/kodamay/projects/xinu-raz/xinu に Xinu カーネルソース.
//       Cross-compiler arm-none-eabi + QEMU versatilepb (Cocoa GUI) で動く
//     - PL110 LCD framebuffer + PL050 mouse + window manager は
//       既に xinu/compile に組み込まれている
//
//   Round 0 で観測した regression (2026-05-20 動作確認):
//     - 3 サンプル全てが現行 src/aipl2c の型チェッカーで reject
//       (e.g. "tick : () -> 'a [Type error] type mismatch",
//        "send target is not actor",
//        "put : ('a) -> 'b [Type error] type mismatch")
//     - --no-typecheck でバイパスすれば C コードは生成され、
//       Xinu カーネルにリンクして QEMU でブートまでは到達 (xsh$ プロンプト)
//     - 自動起動の正しい掛け方が宙ぶらりん (xsh コマンド呼び出し?
//       kernel main からの hook? 確認要)

aice AIPL_XinuRazPi_Round1 {
  dialect = "aice_evolution_v2";

  task = "AIPL を Embedded Xinu / Raspberry Pi 系 (arm-qemu + 実 Pi) で進化させる.Round 0 (= 既存 src/aipl2c.ml --xinu + gen_program_xinu + 3 サンプル + xinu-raz) を base に、(R) regression 修復、(P) パフォーマンス/スケジューラ、(F) AIPL 機能拡張 (Xinu C ランタイム上)、(G) GUI/I/O 拡張、(N) 分散/ネットワーク の 5 軸で進化.全 phase は (1) aipl2c の .abcl → C 翻訳 ✅ + (2) Xinu kernel build ✅ + (3) QEMU で起動成功 ✅ の 3 段ゲートを通過すること.";

  gene_schema = "../../../aice-evolution-v2/schemas/programming_paradigm.schema.json";

  seed_from {
    base_compiler  = "src/aipl2c.ml --xinu  + src/c_translator.ml:gen_program_xinu";
    base_samples   = "abclc/{Rotate4LinesXinu, Philosophers5Xinu, BoundedBufferXinu}.abcl";
    base_runner    = "run_{r4l,p5,bb,pingpong}_xinu.sh";
    base_kernel    = "/Users/kodamay/projects/xinu-raz/xinu  (arm-qemu, PL110 LCD, PL050 mouse, WM)";
    base_toolchain = "arm-none-eabi-gcc + qemu-system-arm + dune 3.20";
    parity_anchor  = "C runtime CE-1..13 + DR-1..13 ✅ (project_aipl_nextgen_parity)";
  }

  // ─── 評価タスク = phase 候補 ───────────────────────────────────
  evaluation_tasks {

    // ═══════════════════════════════════════════════════════════
    //  Direction R — 既存サンプルの型チェック regression 修復
    // ═══════════════════════════════════════════════════════════

    task R0_RestoreSampleTyping {
      spec = "Rotate4LinesXinu / Philosophers5Xinu / BoundedBufferXinu の 3 サンプルが --no-typecheck なしで通るよう、型注釈を補う or 型チェッカーの該当ルールを緩和する.各サンプルが C 出力 → Xinu リンク → QEMU ブートまで通ること.";
      weight = 0.12;
      acceptance = "5 assertion: (1) R4L が typecheck pass, (2) P5 も pass, (3) BB も pass, (4) kernel link 成功, (5) QEMU で xsh$ プロンプトまで到達 (タイムアウト 20s).";
    }

    task R1_SmokeAutomation {
      spec = "QEMU を nographic + serial-stdio で起動し、Xinu kernel から AIPL actor が走ったことを示すマーカー (printf 'aipl-start' 等) を serial に出すよう gen_program_xinu に kernel-main フックを追加.smoke スクリプトが grep で確認できる.";
      weight = 0.08;
      acceptance = "3 assertion: serial に 'aipl-start' が出る、actor の send/recv マーカーが ≥ 1 個、kernel が panic しない.";
    }

    // ═══════════════════════════════════════════════════════════
    //  Direction P — パフォーマンス / スケジューラ
    // ═══════════════════════════════════════════════════════════

    task P1_ActorAsXinuThread {
      spec = "AIPL actor を Xinu thread (create() + resume()) に 1:1 マップ.各 actor の mailbox は Xinu semaphore + ring buffer.message send は P() / V() の対で wakeup.scheduling は Xinu の native priority に委譲.";
      weight = 0.10;
      acceptance = "4 assertion: actor 数 N で N+α 個のスレッド存在、send が wake target、cpu 使用率が低下 (busy-wait 排除)、deadlock 起きない.";
    }

    task P2_PriorityClassesAndTimeslice {
      spec = "AIPL の `priority(high|normal|low)` 属性を Xinu の priority に変換.scout (UAV1 風 / 情報収集) は normal、shooter (UAV2 風 / 制御) は high、background は low.time-slice quantum をターゲット workload で測定 + tune.";
      weight = 0.08;
      acceptance = "3 assertion: priority 設定で Xinu thread の getprio() が一致、high actor が low actor を preempt 観測、starvation 無し.";
    }

    task P3_LockFreeMailbox {
      spec = "現在の semaphore + critical-section 版 mailbox を SPSC / MPSC lock-free ring buffer (atomic CAS) に置換.message send で disable()/restore() が消える.";
      weight = 0.08;
      acceptance = "3 assertion: send/recv が ISR-context 安全、競合 1M 操作で消失なし、scheduling latency が短縮 (1 桁 us 単位).";
    }

    task P4_SchedulingVisualizer {
      spec = "Xinu の thread state 遷移 (READY/CURR/SLEEP/RECV) をリアルタイムで LCD に bar-chart 表示.serial に CSV 形式で trace 出力も.UAV1/UAV2 (or other actors) のメッセージ流量を視覚化.";
      weight = 0.06;
      acceptance = "2 assertion: bar-chart が描かれる、CSV ログから 4 状態の occupancy 計算可.";
    }

    // ═══════════════════════════════════════════════════════════
    //  Direction F — AIPL 機能拡張 (Xinu C ランタイム上)
    // ═══════════════════════════════════════════════════════════

    task F1_P3DistCheckpoint {
      spec = "spreadsheet で実装した P3 (D5 JSON 全状態 export) の Xinu 版.SD カード or virtio-blk に actor state を周期保存、再起動時に復元.checkpoint テキストは line-protocol で /tmp/state.txt 相当.";
      weight = 0.08;
      acceptance = "3 assertion: checkpoint ファイル生成、再起動後 restore で同一 state、未対応 actor は warn のみで boot 続行.";
    }

    task F2_LWWCellSemantics {
      spec = "spreadsheet C4/C5 の per-cell Last-Writer-Wins を Xinu C ランタイムに移植.actor state slot は {value, ts:lamport, origin:nodeId} 三つ組.原子的 update.分散シナリオ (N4) と組み合わせて使う.";
      weight = 0.08;
      acceptance = "3 assertion: concurrent write でも cone が一意、Lamport が単調増加、tie-break が origin id で決定.";
    }

    task F3_EffectAndTypeParity {
      spec = "Py-I / OCaml / JS ランタイム本体に存在する effect handler / row polymorphism 等の機能を Xinu C ランタイムまで拡張.gen_program_xinu に effect 表 codegen.既存 CE-1..13 + DR-1..13 parity (memory: project_aipl_nextgen_parity) を Xinu 列も green に.";
      weight = 0.10;
      acceptance = "5 assertion: CE-1..13 のうち 3 個以上が Xinu で動く、DR-1..13 のうち 3 個以上が同様、parity matrix の Xinu 列が ≥ 6/13 埋まる.";
    }

    task F4_StringsAndArrays {
      spec = "Xinu C ランタイムで string / array primitives を強化.GC な heap 管理 (現在の linear heap を簡易 mark-sweep に).abcl では `var arr: int[10]` のような構文をサポート.";
      weight = 0.06;
      acceptance = "3 assertion: 1000 alloc / free でリーク無し、array OOB が検出される、string concat / split が動く.";
    }

    // ═══════════════════════════════════════════════════════════
    //  Direction G — GUI / I/O 拡張
    // ═══════════════════════════════════════════════════════════

    task G1_FramebufferPrimitives {
      spec = "PL110 framebuffer 上に新規 drawing primitive: triangle / circle / rounded rect / polyline / dashed line.AIPL 側から call できる builtin (`fb_circle x y r color` 等).";
      weight = 0.06;
      acceptance = "3 assertion: 3 種の primitive が描かれる、color 24-bit 対応、anti-alias の有無を toggle 可.";
    }

    task G2_BitmapFontText {
      spec = "8x16 か 12x16 の bitmap font をリンクし、テキスト描画 builtin `fb_text x y \"hello\" color`.漢字対応は最小 ASCII から開始、JIS / Unicode は後続 phase.";
      weight = 0.06;
      acceptance = "3 assertion: font が memory に乗る、ASCII が描かれる、改行が処理される.";
    }

    task G3_MouseEventDispatch {
      spec = "PL050 mouse event を AIPL actor の `on_click(x, y)` メソッドに dispatch.既存の WM mouse cursor とコオーディネート、click 範囲判定は actor 側で行う.";
      weight = 0.06;
      acceptance = "3 assertion: 矩形 click が actor に届く、x/y が画面座標で正しい、複数 actor の重なりで一番上が選ばれる.";
    }

    task G4_RealPiGPIO {
      spec = "実 Raspberry Pi 上 (QEMU ではなく) で GPIO ピンを AIPL builtin `gpio_set` / `gpio_get` で操作.LED / ボタン入力サンプル.SOC-specific レジスタアクセスは BCM2837 (Pi 3) から.";
      weight = 0.06;
      acceptance = "3 assertion: 実機ビルド成功、LED 点滅サンプルが動く、ボタン押下を AIPL actor が受け取る.";
    }

    task G5_ImageBitmapLoad {
      spec = "PPM / BMP の単純画像を memory image としてリンクし、framebuffer に貼れる builtin.プログレッシブ表示 (1 frame ずつ).";
      weight = 0.05;
      acceptance = "2 assertion: PPM がロードできる、16x16 / 32x32 サイズが framebuffer に出る.";
    }

    // ═══════════════════════════════════════════════════════════
    //  Direction N — 分散 / ネットワーク
    // ═══════════════════════════════════════════════════════════

    task N1_TCPIPStack {
      spec = "Xinu の既存 lwip / 自前 TCP/IP stack を AIPL ランタイムから利用可能に.builtin `net_connect host port` / `net_send buf len` / `net_recv buf maxlen`.smc91c111 NIC (versatilepb) 経由で QEMU host へ ping 可.";
      weight = 0.08;
      acceptance = "3 assertion: TCP connect 成功、send 完了、recv で host からのデータ受信.";
    }

    task N2_WSBridgeToBrowser {
      spec = "AIPL actor message を WebSocket frame で browser-abcl に送り、逆方向も.spreadsheet C3/C4/C5 / drone-sim C2 の ws frame と同形式.QEMU 側からは host ws://localhost:8090/ws?sid=xinu:<id> に接続.";
      weight = 0.10;
      acceptance = "4 assertion: Xinu kernel が ws ハンドシェイク成功、frame send → host で receive、host send → Xinu actor 受信、disconnect で graceful close.";
    }

    task N3_MultiPiActorCluster {
      spec = "複数 Raspberry Pi (or QEMU instance) で AIPL actor cluster を形成.actor が remote send (`send peer.X.method(args)`) を呼べる.ノード id は startup config or mDNS で決定.";
      weight = 0.08;
      acceptance = "3 assertion: 2 ノードで peer の actor を呼べる、message ordering が peer 内で保たれる、片方落ちても自ノードは continue.";
    }

    task N4_mDNSDiscovery {
      spec = "mDNS / DNS-SD で同一サブネットの AIPL Pi クラスタを自動発見.AIPL builtin `cluster_peers()` が IP リストを返す.";
      weight = 0.05;
      acceptance = "2 assertion: 2 ノード起動で互いが peers に出現、ノード離脱で peers から消える.";
    }

    // ═══════════════════════════════════════════════════════════
    //  横断的タスク
    // ═══════════════════════════════════════════════════════════

    task R_BackwardCompat {
      spec = "既存 abcl C runtime smoke (project_aipl_nextgen_parity の CE-1..13 + DR-1..13 全 26 個) と、 Xinu 以外のランタイム (Py-I / OCaml / JS-O / JS-B / JS-N) の振る舞いを変えない.";
      weight = 0.08;
      acceptance = "C runtime 既存 smoke 全 PASS、他 5 ランタイムも変化なし.";
    }

    task ImplCost {
      spec = "Round 1 全 phase 合計で C ランタイム +800..+1500 LOC、aipl2c +200..+400 LOC、xinu-raz 外部リポは触らない範囲で.";
      weight = 0.05;
    }
  }

  // ─── 実装順序 (依存関係) ─────────────────────────────────────
  implementation_order {
    // 最初に regression を直さないと他の何も verify できない.
    step R0_RestoreSampleTyping        { dep = "round 0 base"; }
    step R1_SmokeAutomation            { dep = "R0"; }
    // Direction P: スケジューリングを固める
    step P1_ActorAsXinuThread          { dep = "R1"; }
    step P2_PriorityClassesAndTimeslice { dep = "P1"; }
    step P3_LockFreeMailbox            { dep = "P2"; }
    step P4_SchedulingVisualizer       { dep = "P1 + G1"; }
    // Direction G: 視覚化 / 入出力
    step G1_FramebufferPrimitives      { dep = "R0"; }
    step G2_BitmapFontText             { dep = "G1"; }
    step G3_MouseEventDispatch         { dep = "G1"; }
    step G5_ImageBitmapLoad            { dep = "G1"; }
    step G4_RealPiGPIO                 { dep = "R0";  note="QEMU 不可、実 Pi が必要"; }
    // Direction F: ランタイム機能
    step F4_StringsAndArrays           { dep = "P1"; }
    step F1_P3DistCheckpoint           { dep = "P1 + F4"; }
    step F3_EffectAndTypeParity        { dep = "R0";  note = "並行作業可"; }
    // Direction N: 分散
    step N1_TCPIPStack                 { dep = "P1"; }
    step N2_WSBridgeToBrowser          { dep = "N1"; }
    step N3_MultiPiActorCluster        { dep = "N2"; }
    step N4_mDNSDiscovery              { dep = "N1"; }
    step F2_LWWCellSemantics           { dep = "N2"; }
  }

  // ─── アーキテクチャ決定 ──────────────────────────────────────
  decisions {

    decision target_platform {
      // QEMU を一次ターゲットとして smoke を回し、実 Pi は G4 と
      // N3/N4 検証のときだけ.
      primary = "qemu-system-arm -M versatilepb -cpu arm1176";
      secondary = "Raspberry Pi 3 / 4 実機 (G4, N3, N4 のみ)";
      tertiary = "Raspberry Pi Zero / Pico (将来検討)";
    }

    decision build_pipeline {
      compiler = "src/aipl2c.ml --xinu  → /tmp/<sample>.c";
      install  = "cp /tmp/<sample>.c $XINU/apps/abcl_program.c";
      kernel   = "make -C $XINU/compile PLATFORM=arm-qemu COMPILER_ROOT=/opt/homebrew/bin/arm-none-eabi-";
      runner   = "qemu-system-arm -kernel xinu.elf  ( -nographic for smoke, -display cocoa for GUI )";
    }

    decision smoke_strategy {
      method   = "QEMU -nographic + serial-stdio + grep on stdout";
      timeout  = "20-40 秒";
      markers  = "kernel が出す 'xsh$' プロンプト + AIPL 側が出す 'aipl-start' 行";
      regression_floor = "xsh$ プロンプトまで到達することは absolute 不変条件";
    }

    decision external_repo {
      // /Users/kodamay/projects/xinu-raz は外部 (この abclcp-project の
      // git 管理外).abclcp 側からは絶対パスで参照、xinu-raz を
      // 直接編集する場合は別途明示する.
      xinu_raz = "/Users/kodamay/projects/xinu-raz/xinu  (separately versioned)";
      changes_record = "Xinu 側に手を入れた phase は commit message に明記";
    }
  }

  // ─── 検証 (期待 assertion 合計) ──────────────────────────────
  verification {
    round0_baseline       = "(R0 完了後) 3 サンプルが --no-typecheck なしで build + boot";
    direction_R           = "8 assertion (R0:5 + R1:3)";
    direction_P           = "12 assertion (P1:4 + P2:3 + P3:3 + P4:2)";
    direction_F           = "14 assertion (F1:3 + F2:3 + F3:5 + F4:3)";
    direction_G           = "17 assertion (G1:3 + G2:3 + G3:3 + G4:3 + G5:2 + 連動 1)";
    direction_N           = "12 assertion (N1:3 + N2:4 + N3:3 + N4:2)";
    grand_total           = "63 assertion for Round 1";
  }

  // ─── ファイル更新範囲 ─────────────────────────────────────────
  file_impact {
    primary = [
      "src/aipl2c.ml                                       (~20 LOC: flag handling)",
      "src/c_translator.ml::gen_program_xinu               (~600-1000 LOC)",
      "abclc/*Xinu.abcl                                    (~50-150 LOC across 3 samples — R0)",
      "abclc/*.abcl 新規 Xinu サンプル                      (~200-400 LOC: P/F/G/N 用デモ)",
      "run_*_xinu.sh                                       (~20 LOC: smoke + headless mode)"
    ];
    new_files = [
      "aice-pi-evolution/experiments/2026-05-20_xinu_razpi_aipl/_smoke_*.sh",
      "abclc/<NetXinu / FontXinu / DistXinu / etc>.abcl",
      "abclc/_smoke_logs/<phase>.log"
    ];
    external = [
      "/Users/kodamay/projects/xinu-raz/xinu  (別管理リポ、Xinu kernel が必要なら明示変更)"
    ];
    untouched = [
      "browser-abcl 系 (spreadsheet/drone-sim) — 完全に独立"
    ];
  }

  // ─── 最終目標 ─────────────────────────────────────────────────
  goal = "Round 1 全 19 phase (R0/R1 + P1-P4 + F1-F4 + G1-G5 + N1-N4) 完了後、(a) 3 サンプルが型チェック通過 + QEMU で動作、(b) AIPL actor が Xinu thread として priority + lock-free mailbox で動く、(c) Xinu C ランタイムが effect / LWW / dist-checkpoint まで対応、(d) framebuffer に primitive / font / image / mouse が揃う、(e) 実 Pi GPIO で LED 制御、(f) TCP/IP + WebSocket で browser-abcl と通信、(g) 複数 Pi で actor cluster + mDNS discovery — の 7 軸の進化を獲得する.";
}
