// AIPL_XinuRPi5_Round1.aice  (2026-05-22)
//
// Bring up Embedded Xinu on the Raspberry Pi 5 (BCM2712, Cortex-A76,
// AArch64-only) as a new platform "arm-rpi5" — joining the existing
// arm-qemu (versatilepb), arm-rpi (Pi 1/Zero), and the partial
// arm-rpi3 work from Round 2.
//
// Boot reference: https://github.com/radlyeel/leex  (Pi 4 / BCM2711
// AArch64 stub by radlyeel).  We carry over leex's overall shape —
// AArch64 boot.S, load address 0x80000, BSS-zero + main entry,
// objcopy ELF → flat kernel image — but replace the Pi-4 specifics
// with their Pi-5 equivalents.
//
//   Pi 4 (leex baseline)              Pi 5 (this round)
//   ──────────────────────────────────────────────────────────────
//   SoC          BCM2711              BCM2712
//   Cores        Cortex-A72 × 4       Cortex-A76 × 4
//   Periph base  0xFE000000           0x107C000000  (high-mem MMIO)
//   I/O hub      direct on SoC        RP1 chip      (separate PCIe)
//   UART         Mini UART (AUX)      PL011 UART0 via RP1 or
//                                     debug UART on header pins
//   Firmware     kernel8.img          kernel_2712.img (firmware
//                                     refuses to boot 8.img on Pi 5)
//   IRQ ctrl     GIC-400 (Cortex)     GIC-400 + RP1-internal IRQs
//   USB          on-SoC               via RP1 + PCIe
//   Ethernet     BCM54213PE on SoC    same chip, behind RP1 PCIe
//   GPIO         on-SoC               via RP1 (mailbox / RP1 regs)
//
// QEMU support for Pi 5 is not upstream yet (as of 2026-05-22), so
// the smoke harness for arm-rpi5 has to terminate at a real Pi 5
// connected over USB-serial.  arm-qemu / arm-rpi3 stay as the
// regression anchors during development.

aice AIPL_XinuRPi5_Round1 {
  dialect = "aice_evolution_v2";

  task = "Embedded Xinu を Raspberry Pi 5 (BCM2712 / Cortex-A76 / AArch64) で起動させる新プラットフォーム arm-rpi5 を作る.Round 0 (= leex の AArch64 boot を Xinu の build pipeline に合体させた、PL011 hello-world まで) を経て、Round 1 で Xinu 本体 (scheduler / threads / clock / IRQ / framebuffer / GPIO / UART RPC / AIPL ランタイム) を Pi 5 上で立ち上げる.全 phase は (1) arm-none-eabi → aarch64-none-elf ツールチェーンに切替えた make が通る ✅、(2) firmware (config.txt + kernel_2712.img) が boot ✅、(3) UART0 に Xinu バナーが出て xsh$ プロンプトに到達 ✅、(4) arm-qemu (versatilepb) + arm-rpi3 の既存 smoke が regression-clean ✅ の 4 段ゲートを通る.";

  gene_schema = "../../../aice-evolution-v2/schemas/xinu_kernel.schema.json";

  seed_from {
    base_kernel      = "/Users/kodamay/projects/xinu-raz/xinu (= arm-qemu / arm-rpi 系の動く Xinu、Round 1+2 + kernel-evo まで載った状態)";
    base_aarch64_boot = "github.com/radlyeel/leex/kernel/{boot.S,link.ld,Makefile,io.c} — Pi 4 AArch64 stub.boot.S は mpidr_el1 で boot core 確定、stack を _start 直前にセット、BSS ゼロクリア、bl main、wfe 無限ループ";
    base_load_addr    = "0x80000 (kernel_2712.img も Pi 5 firmware が同じ高さに読む)";
    base_toolchain    = "aarch64-none-elf-gcc 14.3 (rel1 GNU Arm Toolchain) — leex の HOME/aarch64/ パス慣行に倣う";
    base_qemu_anchor  = "qemu-system-arm -M versatilepb (= 既存 arm-qemu) は AArch32 のままで Pi5 codegen には触れない";
    base_pi3_anchor   = "Round 2 kernel-evo の A1 ArmRpi3 port が一部済 — arm-rpi3 は AArch32 のままで Pi5 (AArch64) からは独立";
    target_hardware   = "Raspberry Pi 5 4GB/8GB.USB-Serial UART debug cable で UART0 に接続、microSD に firmware + kernel_2712.img を書く";
    parity_anchor     = "AIPL CE-1..13 + DR-1..13 × 6 runtimes (project_aipl_nextgen_parity)";
    abi_anchor        = "AAPCS64 (AArch64 calling convention) — x0-x7 引数、x29 fp / x30 lr、struct returns に x8";
  }

  // ─── 評価タスク = phase 候補 ───────────────────────────────────
  evaluation_tasks {

    // ═══════════════════════════════════════════════════════════
    //  Direction B — Boot / build chain
    // ═══════════════════════════════════════════════════════════

    task B0_Toolchain {
      spec = "aarch64-none-elf-gcc 14.3 を /opt/homebrew/bin から呼べる状態にする (brew install gcc-arm-embedded ≒ Pi 用ツールチェーン).Xinu の compile/Makefile の COMPILER_ROOT を arm-rpi5 platform 時だけ aarch64-none-elf- に切替える.既存 arm-qemu / arm-rpi3 ビルドは arm-none-eabi のまま regression なし.";
      weight = 0.06;
      acceptance = "3 assertion: (1) aarch64-none-elf-gcc -v が動く、(2) PLATFORM=arm-rpi5 make でツールチェーン解決、(3) PLATFORM=arm-qemu の旧ビルドがそのまま通る.";
    }

    task B1_AArch64BootStub {
      spec = "leex の boot.S を arm-rpi5 platform に移植.compile/platforms/arm-rpi5/loader.S として、mpidr_el1 で boot core を選択、他コアは wfe、stack を _start 直前にセット、BSS をクリア、_kernel_main を呼ぶ.AArch64 EL2→EL1 降格は Pi 5 firmware が EL1 で渡してくる前提でひとまずスキップ (Round 2 で EL2 経由を入れる).";
      weight = 0.10;
      acceptance = "4 assertion: (1) loader.S が aarch64-none-elf-as で通る、(2) link.ld が 0x80000 ロード address でリンクできる、(3) objcopy -O binary で kernel_2712.img が出る、(4) Pi 5 SD カードに焼いて UART0 に何か出る.";
    }

    task B2_Kernel2712Image {
      spec = "Pi 5 firmware は kernel_2712.img のみ受け付ける (kernel8.img は無視).Makefile の install ターゲットを SDCARD/bootfs に config.txt + kernel_2712.img を配置するよう変更.config.txt には `arm_64bit=1` + `kernel=kernel_2712.img` + UART debug 用 `enable_uart=1` を書く.";
      weight = 0.05;
      acceptance = "3 assertion: (1) make install が SDCARD/bootfs に正しく書く、(2) config.txt の必須項目が揃っている、(3) Pi 5 が image を拒否しない (= ACT LED が点滅 → 静止 → 起動).";
    }

    // ═══════════════════════════════════════════════════════════
    //  Direction U — UART / early I/O
    // ═══════════════════════════════════════════════════════════

    task U0_PL011UART {
      spec = "Pi 5 の debug UART (header pin 8/10 = TXD/RXD、RP1 経由ではなく SoC 直結の PL011 UART0、`enable_uart=1` で 48MHz 固定) を初期化、115200/8N1 で putc/getc.Xinu の uart-pl011 driver を arm-rpi5 base address (0x107D001000) で再利用.";
      weight = 0.10;
      acceptance = "4 assertion: (1) UART0 init が成功、(2) `Hello from Xinu on Pi 5` が出る、(3) ホスト screen /dev/tty.usbserial-xxxx で受信、(4) Round 2 既存 uart-pl011 path との回帰なし.";
    }

    task U1_KprintfMin {
      spec = "kprintf を Pi 5 base に向かわせる.既存 kprintf は uart-pl011 経由なので U0 で動くはず、ただし base address が違う (Pi 5 は MMIO が 0x107C000000 オフセット領域).platform 別 base アドレス table を導入.";
      weight = 0.05;
      acceptance = "2 assertion: (1) kprintf でフォーマット出力、(2) banner + memory map が読める.";
    }

    // ═══════════════════════════════════════════════════════════
    //  Direction M — Memory / MMU
    // ═══════════════════════════════════════════════════════════

    task M0_FlatIdentityMap {
      spec = "MMU を有効化、0..2GB を 1:1 identity map (RAM 領域) + MMIO 領域を 0x107C000000.. に device-nGnRnE で map.AArch64 の TTBR0_EL1 + TCR_EL1 + SCTLR_EL1 を設定.まずは flat、page-fault は後続 phase.";
      weight = 0.08;
      acceptance = "3 assertion: (1) MMU 有効化後も UART 動く、(2) kprintf が引き続き出る、(3) data abort 発生時に handler に飛ぶ (panic 出力).";
    }

    task M1_KernelHeap {
      spec = "getmem / freemem を AArch64 で動かす.既存 freelist allocator のポインタを 64-bit に拡張、size_t をきちんと unsigned long に.Xinu の MEMHEAD struct の 32-bit 前提を全部点検.";
      weight = 0.06;
      acceptance = "3 assertion: (1) 1MB alloc/free が leak なし、(2) thrtab[] の初期化が成功、(3) heap 統計が正しい.";
    }

    // ═══════════════════════════════════════════════════════════
    //  Direction S — Scheduler / threads
    // ═══════════════════════════════════════════════════════════

    task S0_AArch64ContextSwitch {
      spec = "ctxsw を AArch64 用に書き直す.x19-x30 + sp + lr を struct ctxblk に保存/復元 (AAPCS64 callee-saved set).resched.c の中の ctxsw 呼出は変更なし、定義先のアセンブリだけ差し替え.";
      weight = 0.10;
      acceptance = "4 assertion: (1) idle thread → null thread → idle のループが回る、(2) 2 thread が yield で交互に動く、(3) clkhandler ベースのタイムスライス、(4) Round 2 arm-qemu 17 smoke regression なし.";
    }

    task S1_GICAndTimer {
      spec = "GIC-400 (Pi 5 の割り込みコントローラ — Cortex-A76 周りは GICv2 互換) を初期化、SP804 / ARM generic timer のいずれかで periodic clock interrupt を発生させる.AArch64 だと CNTPCT_EL0 + CNTP_CVAL_EL0 の generic timer 経路が標準.";
      weight = 0.08;
      acceptance = "3 assertion: (1) IRQ で clkhandler が呼ばれる、(2) clktime が ms 単位で進む、(3) sleep(N) が N ms 程度で復帰.";
    }

    // ═══════════════════════════════════════════════════════════
    //  Direction X — xsh shell + 既存 sample 移植
    // ═══════════════════════════════════════════════════════════

    task X0_XshOnRPi5 {
      spec = "Xinu の xsh シェルを Pi 5 UART0 に接続し、`xsh$ ` プロンプト + 既存コマンド (date, ps, halt, free) を動かす.shell/ 配下の C は arm-qemu と同じものを使い、tty device だけ差し替え.";
      weight = 0.06;
      acceptance = "3 assertion: (1) xsh$ プロンプト到達、(2) ps が thrtab[] を列挙、(3) date / free が動く.";
    }

    task X1_AbclProgramOnRPi5 {
      spec = "Round 1 で動いていた `abclc/HelloPrintXinu.aipl` (もしくは最小の AIPL hello) を arm-rpi5 platform でコンパイル + 実行.aipl2c --xinu の codegen が AArch64 でも問題なく link する (= 32-bit 前提のキャストや fixed-width 型がない) ことを確認.";
      weight = 0.08;
      acceptance = "4 assertion: (1) AIPL hello が UART0 に出力、(2) actor mailbox の send/recv が AArch64 で動く、(3) value_t の layout が 64-bit でも壊れない、(4) Round 2 既存 sample (DiningPhilosophersDistXinu.aipl 等) が arm-qemu で regression なし.";
    }

    // ═══════════════════════════════════════════════════════════
    //  Direction N — Network / I/O (stretch)
    // ═══════════════════════════════════════════════════════════

    task N0_RP1Discover {
      spec = "RP1 (Pi 5 の I/O コントローラチップ) を PCIe 越しに識別.既存 Pi5 Linux ドライバ (drivers/misc/rp1.c, drivers/pci/controller/pcie-brcmstb.c) を参照しつつ、最小限の PCI config space 読み取りで RP1 のベンダ ID + リソース範囲を取得.この phase は『RP1 がそこにあると Xinu が認識した』ことの確認まで.";
      weight = 0.05;
      acceptance = "2 assertion: (1) PCI config 読みで RP1 のベンダ ID (Raspberry Pi Ltd, 0x1de4) が読める、(2) BAR が想定範囲.";
    }

    task N1_FramebufferMailbox {
      spec = "Pi 5 の VideoCore VII に mailbox 経由で framebuffer 要求を出す (BCM2712 でも従来の mailbox property tag が使える).取得した FB base を kprintf 経由で確認、Xinu の framebuffer_rpi driver と互換させる予定.";
      weight = 0.05;
      acceptance = "2 assertion: (1) mailbox property API が応答、(2) FB base + pitch + size が妥当 (1920x1080 程度).";
    }

    // ═══════════════════════════════════════════════════════════
    //  横断的タスク
    // ═══════════════════════════════════════════════════════════

    task R_LegacyPlatformsUnchanged {
      spec = "arm-qemu (versatilepb) + arm-rpi3 の既存ビルド + smoke が完全に regression-clean.compile/platforms/arm-rpi5/ は完全に新規追加、共有コードはあっても #ifdef _XINU_PLATFORM_ARM_RPI5_ で guard.";
      weight = 0.08;
      acceptance = "Round 2 累積 smoke (backwardcompat Gate1 88/88, Gate2 75/88, N1 4/4, host_rpc_demo 9/9, _diag_http_direct, 3 diners variants) が全部 PASS のまま.";
    }

    task ImplCost {
      spec = "Round 1 全 12 phase 合計で xinu-rpi5 (新規 repo) ~3000..5000 LOC、abclcp-project 側の src/ 変更は +50..200 LOC (platform 別の Makefile 分岐とごく一部の codegen guard のみ).新規ファイルは aice-pi-evolution/experiments/2026-05-22_xinu_rpi5/ + 別 git repo xinu-rpi5/.";
      weight = 0.05;
    }
  }

  // ─── レビュアー (Gemini 進化計算の選択圧) ───────────────────
  evaluator = "ai_v1";

  reviewers {

    reviewer R_BootBringup {
      persona = "あなたは R_BootBringup を判定するレビュアーです。候補設計 (scheduler / memory_alloc / ipc_primitive / isolation / arch_target / power_mgmt / concurrency_safety の 7 軸) が、AArch64 Pi 5 上の早期 boot (firmware → loader.S → C main → UART hello) を成立させる現実性を判定する。重視: (a) arch_target が arm_rpi5 or arm_aarch64 を取れる、(b) memory_alloc が起動初期にシンプル (bump / freelist) で済む、(c) isolation が none か user_kernel_split に留まり MMU 初期化が単段、(d) concurrency_safety が critical_section / spinlock で AArch64 atomics の最小利用に収まる。スコア基準: 1.0 = arch_target=arm_rpi5 + memory_alloc=freelist + isolation=none、0.7 = arch_target=arm_rpi3 + memory_alloc=freelist + isolation=user_kernel_split、0.3 = arch_target=arm_versatilepb + memory_alloc=buddy + isolation=user_kernel_split (= レガシー寄り)、0.0 = arch_target=x86_64 + memory_alloc=demand_paged + isolation=container_like (= 軸が違う)。半角数字の decimal で答えてください。";
      weight = 0.30;
    }

    reviewer R_AArch64SchedulerImpl {
      persona = "あなたは R_AArch64SchedulerImpl を判定するレビュアーです。候補設計の scheduler + concurrency_safety + ipc_primitive を見て、AArch64 (AAPCS64) で動く Xinu のスレッド + ctxsw + clock IRQ を実装する困難度を判定する。基準: 1.0 = scheduler=priority_static + concurrency_safety=critical_section + ipc_primitive=sem_mailbox (= 既存 Xinu パターンをそのまま AArch64 ABI に焼き直す、最小コスト)、0.7 = scheduler=priority_aging + concurrency_safety=spinlock + ipc_primitive=actor_lockfree (= ロックフリー mailbox を AArch64 atomics で組み直す追加コスト)、0.3 = scheduler=mlfq or edf_soft + concurrency_safety=lock_free (= 時計割り込み内で MLFQ 維持は AArch64 でも組めるが Round 1 後半相当)、0.0 = scheduler=cfs_like + concurrency_safety=rcu (= 複雑、Linux 寄り、Round 1 では不可)。半角数字の decimal で答えてください。";
      weight = 0.25;
    }

    reviewer R_Pi5HardwareReality {
      persona = "あなたは R_Pi5HardwareReality を判定するレビュアーです。候補の arch_target + isolation + memory_alloc が、Raspberry Pi 5 (BCM2712 / Cortex-A76 / RP1 / VideoCore VII / 0x107C000000 MMIO) という実物の hardware と整合する程度を判定する。基準: 1.0 = arch_target=arm_rpi5 + isolation=none or user_kernel_split + memory_alloc=freelist or buddy (= まさに Pi 5 を狙った設計)、0.7 = arch_target=multi_arch + isolation=user_kernel_split (= Pi 5 も含まれるが汎用)、0.3 = arch_target=arm_rpi3 (= 旧 Pi、Pi 5 で動かそうとすると config.txt / kernel image 名から手を入れる必要)、0.0 = arch_target=x86_64 or riscv32 (= 物理的に Pi 5 で動かない)。半角数字の decimal で答えてください。";
      weight = 0.25;
    }

    reviewer R_LegacyBackwardCompat {
      persona = "あなたは R_LegacyBackwardCompat を判定するレビュアーです。Round 1 + Round 2 + kernel-evo が arm-qemu で築いた smoke ベース (17 AIPL smokes + RemoteRPC 2 + kernel-evo S1-S4/Sec1 + memfs/make + N1 4/4 + 3 diners variants) を Pi 5 platform 追加で壊さない確率を判定する。重視: (a) arch_target=multi_arch なら arm-qemu と共存、(b) isolation / memory_alloc / ipc_primitive を既存値から動かさない、(c) platform-specific コードは新ディレクトリ (compile/platforms/arm-rpi5/) に分離。スコア基準: 1.0 = arch_target=multi_arch + isolation 等は全て Round 2 baseline と同じ (= 純粋追加)、0.7 = arch_target=arm_rpi5 specialised + isolation 据置 (= 共存だが整理コストあり)、0.3 = arch_target=arm_rpi5 + memory_alloc or isolation が更新 (= 既存 platform にも波及)、0.0 = arch_target=arm_rpi5 + ipc_primitive=tuple_space (= AIPL mailbox 全替えで既存全壊)。半角数字の decimal で答えてください。";
      weight = 0.20;
    }
  }

  // ─── 実装順序 (依存最小トポロジー) ─────────────────────────
  implementation_order {

    // Boot 系を最初に固める。toolchain が無いと何もコンパイルできない。
    step B0_Toolchain               { dep = "baseline"; }
    step B1_AArch64BootStub         { dep = "B0"; }
    step B2_Kernel2712Image         { dep = "B1"; }

    // UART が無いと何が起きているか確認できない → Boot のすぐ次。
    step U0_PL011UART               { dep = "B1"; }
    step U1_KprintfMin              { dep = "U0"; }

    // Memory / MMU。UART で観測しながら段階的に。
    step M0_FlatIdentityMap         { dep = "U1"; }
    step M1_KernelHeap              { dep = "M0"; }

    // Scheduler / threads。AArch64 ctxsw を最初に解決すれば残りは線形。
    step S0_AArch64ContextSwitch    { dep = "M1"; }
    step S1_GICAndTimer             { dep = "S0"; }

    // ここまでで「Pi 5 上で xsh プロンプトと AIPL hello」 ≒ Round 1 ゴール。
    step X0_XshOnRPi5               { dep = "S1"; }
    step X1_AbclProgramOnRPi5       { dep = "X0"; }

    // Stretch (Round 1 内に間に合えば).RP1 と FB は独立に進められる。
    step N0_RP1Discover             { dep = "M0";  note = "並行可"; }
    step N1_FramebufferMailbox      { dep = "U1";  note = "並行可"; }
  }

  // ─── アーキテクチャ決定 ──────────────────────────────────────
  decisions {

    decision target_hardware {
      primary    = "Raspberry Pi 5 4GB/8GB — BCM2712 / Cortex-A76 / RP1 / VideoCore VII";
      smoke_conn = "USB-Serial UART cable on header pins 8/10 (GPIO14 TXD / GPIO15 RXD) — host から screen /dev/tty.usbserial-xxxx 115200 で読む";
      sd_layout  = "FAT32 bootfs に bootcode.bin + start4.elf 系 firmware + config.txt + kernel_2712.img";
      qemu_path  = "QEMU の Pi 5 サポートは 2026-05-22 時点で upstream に無い → Pi 5 専用 smoke は実機経由のみ";
    }

    decision toolchain {
      compiler   = "aarch64-none-elf-gcc 14.3 (rel1, GNU Arm Embedded Toolchain) — leex の HOME/aarch64/ 慣行";
      flags      = "-Wall -O2 -ffreestanding -nostdinc -nostdlib -nostartfiles -mcpu=cortex-a76 -mgeneral-regs-only";
      objcopy    = "aarch64-none-elf-objcopy -O binary kernel.elf kernel_2712.img";
      makefile   = "compile/platforms/arm-rpi5/platformVars で COMPILER_ROOT を分岐.既存 arm-qemu / arm-rpi3 は arm-none-eabi のまま、PLATFORM_TOOLCHAIN_PREFIX を変数化";
    }

    decision boot_sequence {
      stage1 = "Pi 5 firmware が kernel_2712.img を 0x80000 にロード、x0..x3 に DTB / chosen 等を渡して EL1 で _start にジャンプ";
      stage2 = "loader.S (leex 由来) で mpidr_el1 boot core 確定 → 他コア wfe → stack 設定 → BSS ゼロ";
      stage3 = "C 言語 _kernel_main() (xinu の sys_main 相当) に bl で入り、UART / clock / memory / threads の順に初期化";
      stage4 = "AIPL_AUTOSTART が定義されていれば aipl_main を spawn、最後に shell をスポーン";
    }

    decision peripheral_map {
      mmio_base    = "0x107C000000 (BCM2712 high-mem peripheral block)";
      uart0_pl011  = "0x107D001000 (= MMIO base + 0x1001000, debug UART expose されている pin 8/10 経路)";
      gic_dist     = "0x107FFF9000 + 0x107FFFA000 (GIC-400 distributor + CPU interface、要 datasheet 確認)";
      mailbox_vc   = "従来通り の property tag interface (channel 8 = property)、実 base は datasheet 要再確認";
      sdcard       = "RP1 内 EMMC controller — Round 1 後半 / Round 2 で着手予定";
    }

    decision compile_layout {
      new_subdir   = "compile/platforms/arm-rpi5/  (loader.S, link.ld, config.txt, platformVars)";
      new_arch     = "arch/aarch64/  (start.S, ctxsw.S, exception_vectors.S, platformVars)";
      legacy_split = "arch/arm/ は AArch32 のまま、arch/aarch64/ を別ディレクトリで新設.共通ヘッダは include/ に置き、AArch64 専用 inline asm は #if defined(__aarch64__) でガード";
    }

    decision repo_strategy {
      // 既存 xinu-raz は arm-qemu / arm-rpi (32-bit) で十分稼働しており、
      // Pi 5 (AArch64) を同じ repo に混ぜると Makefile / 多数の inline
      // asm に大量の guard を入れる必要が出る.分離して独立 repo にする.
      new_repo_name = "xinu-rpi5  (GitHub yaskodama/xinu-rpi5.git)";
      relation_to_xinu_raz = "初期に xinu-raz から fork、AArch64 化に伴って unused な device/* (smc91c111 等の 32-bit 周辺) を順次廃止";
      submodule    = "abclcp-project からは絶対パスで参照、submodule 化は将来検討";
    }

    decision smoke_strategy {
      method       = "USB-Serial UART で stdio 接続 + grep on banner / xsh prompt";
      timeout      = "Pi 5 boot は ~3-8 秒なので 30 秒で確認";
      regression_floor = "arm-qemu / arm-rpi3 の Round 1 + Round 2 累積 smoke を absolute 不変条件として保持";
      hardware_required = "Pi 5 + microSD + USB-Serial cable + ホスト Mac で screen.CI 自動化は real Pi が必要なので manual smoke が当面";
    }
  }

  // ─── 検証 (期待 assertion 合計) ──────────────────────────────
  verification {
    direction_B   = "10 assertion (B0:3 + B1:4 + B2:3)";
    direction_U   = " 6 assertion (U0:4 + U1:2)";
    direction_M   = " 6 assertion (M0:3 + M1:3)";
    direction_S   = " 7 assertion (S0:4 + S1:3)";
    direction_X   = " 7 assertion (X0:3 + X1:4)";
    direction_N   = " 4 assertion (N0:2 + N1:2)";
    cross_cut     = "arm-qemu + arm-rpi3 の Round 2 累積 smoke を不変に保つ";
    grand_total   = "40 assertion for Pi 5 Round 1";
  }

  // ─── ファイル更新範囲 ─────────────────────────────────────────
  file_impact {
    new_repo_xinu_rpi5 = [
      "compile/platforms/arm-rpi5/loader.S         (~120 LOC: leex boot.S を AAPCS64 化)",
      "compile/platforms/arm-rpi5/link.ld          (~30 LOC: 0x80000 ロード)",
      "compile/platforms/arm-rpi5/platformVars     (~30 LOC: aarch64-none-elf- 切替)",
      "compile/platforms/arm-rpi5/config.txt       (firmware 設定)",
      "arch/aarch64/start.S                         (~80 LOC: arch 共通 entry)",
      "arch/aarch64/ctxsw.S                         (~120 LOC: AAPCS64 callee-saved retain)",
      "arch/aarch64/exception_vectors.S             (~200 LOC: EL1 sync / IRQ / SError)",
      "arch/aarch64/mmu.c                           (~300 LOC: TTBR0_EL1 flat ID map)",
      "system/initialize.c                          (~50 LOC: AArch64 path 分岐)",
      "system/clkinit.c                             (~50 LOC: ARM generic timer init)",
      "device/uart-pl011/                           (~30 LOC: base address 切替)"
    ];
    abclcp_project = [
      "src/c_translator.ml                          (~30 LOC: AAPCS64 でも壊れない fixed-width 型の見直し、64-bit value_t 確認)",
      "abclc/HelloPi5Xinu.aipl  (new)               (~20 LOC: 最小 hello sample)",
      "aice-pi-evolution/experiments/2026-05-22_xinu_rpi5/_smoke_pi5_boot.sh (~80 LOC: 実機 USB-serial 経由)"
    ];
    untouched = [
      "/Users/kodamay/projects/xinu-raz/xinu  — arm-qemu / arm-rpi 経路は変更しない (新 repo xinu-rpi5 で完全分離)"
    ];
  }

  // ─── 実行例 (進化計算の起動コマンド) ─────────────────────────
  sample_session {

    parse_only {
      cmd = "cd aice-evolution-v2 && python3 -m src.cli --no-run -o ../aice-pi-evolution/experiments/2026-05-22_xinu_rpi5/ ../aice-pi-evolution/experiments/2026-05-22_xinu_rpi5/AIPL_XinuRPi5_Round1.aice";
      output = "AIPL_XinuRPi5_Round1.ga.json (parse 確認)";
    }

    generate_aipl {
      cmd = "cd aice-evolution-v2 && python3 -m src.cli --no-run --abcl -o ../aice-pi-evolution/experiments/2026-05-22_xinu_rpi5/ ../aice-pi-evolution/experiments/2026-05-22_xinu_rpi5/AIPL_XinuRPi5_Round1.aice";
      output = "AIPL_XinuRPi5_Round1.aipl (= MAP-Elites orchestrator)";
      post   = "use_ai 0 -> 1 を 4 reviewer に patch (Round 2 と同じ手順)";
    }

    run_evolution {
      requires = "GEMINI_API_KEY が export 済、google-genai SDK が import 可";
      cmd      = "AIPL_AI_PROVIDER=gemini python3 -u src/python-aipl/aipl_main.py aice-pi-evolution/experiments/2026-05-22_xinu_rpi5/AIPL_XinuRPi5_Round1.aipl --timeout 2400 --idle-ms 600000";
      output   = "out/AIPL_XinuRPi5_Round1.aipl_lineage.json";
      duration = "30-50 分 (seed=8 + gen=15 + 4 reviewers × 12 tasks ≈ 1500 LLM calls)";
    }

    bootstrap_xinu_rpi5_repo {
      cmd = "gh repo create yaskodama/xinu-rpi5 --public --description 'Embedded Xinu port for Raspberry Pi 5 (BCM2712, AArch64).  Bootstrapped from xinu-rpi/arm-qemu + leex-style AArch64 boot.'  && \\\n           git clone yaskodama/xinu-rpi5 /Users/kodamay/projects/xinu-rpi5  && \\\n           cd /Users/kodamay/projects/xinu-rpi5  && \\\n           # ここから xinu-raz の中身を選択的にコピーして AArch64 化していく";
      output = "yaskodama/xinu-rpi5.git が空 + ローカル clone 完了";
    }
  }

  // ─── 最終目標 ─────────────────────────────────────────────────
  goal = "Round 1 全 12 phase (B0-B2 + U0-U1 + M0-M1 + S0-S1 + X0-X1 + N0-N1) 完了後、Raspberry Pi 5 実機で (a) firmware が kernel_2712.img を読み込んで AArch64 boot stub が動き、(b) UART0 (header pin 8/10、115200/8N1) に Xinu バナーが出て、(c) MMU + memory + scheduler + timer + IRQ が立ち上がり、(d) xsh$ プロンプトに到達して date / ps / halt が動き、(e) AIPL hello サンプル (HelloPi5Xinu.aipl) が AArch64 上で実行できる — を達成する.既存 arm-qemu / arm-rpi3 platform の Round 1 + Round 2 + kernel-evo + Round 2 拡張で築いた smoke (合計 30+ 個) は absolute 不変条件として保持.";
}
