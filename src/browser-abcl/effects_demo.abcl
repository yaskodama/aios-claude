// effects_demo.abcl — CE-10 effect inference sample for JS-B / JS-N.
//
// runTypeCheck() / /api/typecheck returns effects per method.  This
// .abcl exercises every primitive group:
//   ai   : ai_call_with_system   →  ai
//   fs   : read_file / write_file →  fs (+ mut for writes)
//   net  : crdt_replicate         →  mut,net
//   mut  : field write / send     →  mut
//
// Expected effectsStr (any order):
//   AIReporter.summarise  : "ai,mut"     (ai_call + reply)
//   FileLog.write         : "fs,mut"
//   FileLog.peek          : "fs"
//   Pure.add              : "pure"
//   Caller.run            : "mut"        (just sends)

class AIReporter {
  method summarise(text) {
    var s = ai_call_with_system("you summarise text", text);
    reply(s);
  }
}

class FileLog {
  var path = "/tmp/effects_demo.log";
  method write(line) { append_file(path, line); }
  method peek() {
    var c = read_file(path);
    print("[filelog] " + c);
  }
}

class Pure {
  method add(a, b) { print("[pure] " + (a + b)); }
}

class Caller {
  method run(r, l) {
    send l.write("hello\n");
    send r.summarise("AIPL is an actor language");
  }
}

var r = new AIReporter();
var l = new FileLog();
var c = new Caller();
var p = new Pure();
send c.run(r, l);
send p.add(2, 3);
