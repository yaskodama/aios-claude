// CE-10 / sample 1 — pure method vs ai_call method (Py-I).
//
// Run:
//   python3 aipl_main.py samples/nextgen/ce10_effects/sample1_pure_vs_ai.abcl --check
// Expected: type-check is clean.  Bound `pure_add` declares no
// effects ({∅}); `ask_ai` declares {ai, net} and the static
// checker is satisfied because ai_call propagates exactly that.

function pure_add(x: int, y: int) -> int {
  return x + y;
}

function ask_ai(q: string) -> string !{ai, net} {
  return ai_call_with_system("Answer in one word.", q);
}

print("[ce10/1] sum = " + pure_add(3, 4));
print("[ce10/1] ai  = " + ask_ai("hello"));
