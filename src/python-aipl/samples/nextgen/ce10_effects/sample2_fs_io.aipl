// CE-10 / sample 2 — filesystem effects inferred from read/write.
//
// Run:
//   python3 aipl_main.py samples/nextgen/ce10_effects/sample2_fs_io.aipl
// Expected: --check shows write_log → {fs}, read_log → {fs}.

function write_log(path: string, msg: string) -> int !{fs} {
  return write_file(path, msg);
}

function read_log(path: string) -> string !{fs} {
  return read_file(path);
}

write_log("/tmp/aipl_ce10_log.txt", "hello CE-10\n");
print("[ce10/2] read = " ++ read_log("/tmp/aipl_ce10_log.txt"));
