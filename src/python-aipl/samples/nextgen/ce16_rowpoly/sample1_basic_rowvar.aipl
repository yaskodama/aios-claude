// CE-16 V1 / sample 1 — row-polymorphic record receiver.
//
// Two methods access disjoint single fields on parameter `p`.  Under
// CE-13 (intersection-based width subtyping) the inferred type for
// `p` was {} (the intersection); under CE-16 V1 each access pushes a
// row-variable constraint, so the receiver accumulates a {name, age}
// open record and unifies cleanly against a caller record literal.
//
// Run with:
//   AIPL_ROWPOLY=1 python3 aipl_main.py --check \
//     samples/nextgen/ce16_rowpoly/sample1_basic_rowvar.aipl
// Expected: `p` inferred as `{age: Int, name: Str | ρ}`.

class Greeter {
  method greet(p) {
    return "Hello, " ++ p.name;
  }
  method label(p) {
    return "id=" ++ p.id;
  }
}

var g = new Greeter();
var u = {name: "Alice", id: "u-001", email: "alice@example.com"};
var hi  = now g.greet(u);
var aud = now g.label(u);
print(hi);
print(aud);
