// CE-13 / sample 2 — explicit-annotation forces a disjoint rejection.
//
// Py-I record subtyping is *gradual* by default: when no parameter
// type is annotated, the inference accumulates required fields from
// `.field` accesses, and a record literal that's missing them
// returns None at runtime instead of failing type-check.  Adding
// the explicit `: record {name: string, email: string}` annotation
// makes the disjoint-record case a static error again.
//
// Run with `--check` to surface the type error:
//   python3 aipl_main.py --check \
//     samples/nextgen/ce13_record_subtyping/sample2_disjoint_rejected.abcl

class Mailer {
  method deliver(p: record {name: string, email: string}) -> string {
    return "To " + p.name + " <" + p.email + ">";
  }
}

var m = new Mailer();
var bad = {label: "abc"};

// At runtime the call still proceeds (Py-I's runtime is permissive)
// but `aipl_main --check` and `--infer` will flag the unify failure.
var s = now m.deliver(bad);
print("[ce13/2] runtime result = " + s);
print("[ce13/2] (run --check to see the type error)");
