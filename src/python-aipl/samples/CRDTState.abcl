// DR-10 — CRDT actor state.
//
// Three replicated data types — G-Counter, OR-Set, LWW-Register —
// merge cleanly across replicas without coordination.  Useful for
// shared state in a multi-region deployment (paired with DR-12).
//
// Replica identity comes from AIPL_DIST_REPLICA_ID (defaults to
// hostname).  `crdt_replicate` logs a `crdt_replicate` event for
// the deployment-layer replicator to subscribe to.
//
// Run with:
//   AIPL_DIST_ENABLE=1 AIPL_DIST_LOG_FILE=/tmp/crdt.ndjson \
//   AIPL_DIST_REPLICA_ID=node-a \
//   python3 src/python-aipl/aipl_main.py samples/CRDTState.abcl

class Demo {
  method run() {
    // ── G-Counter ──
    var c = crdt_gcounter_new();
    crdt_gcounter_inc(c, 3);
    crdt_gcounter_inc(c, 4);
    print("[g-counter] local value: " + crdt_gcounter_value(c));

    var c2 = crdt_gcounter_new();
    crdt_gcounter_inc(c2, 10);
    var merged = crdt_gcounter_merge(c, c2);
    print("[g-counter] merged value: " + crdt_gcounter_value(merged));

    // ── OR-Set ──
    var s = crdt_orset_new();
    crdt_orset_add(s, "apple");
    crdt_orset_add(s, "banana");
    crdt_orset_add(s, "cherry");
    crdt_orset_remove(s, "banana");
    print("[or-set] contains apple: " + crdt_orset_contains(s, "apple"));
    print("[or-set] contains banana: " + crdt_orset_contains(s, "banana"));
    print("[or-set] values: " + crdt_orset_values(s));

    // ── LWW-Register ──
    var r = crdt_lww_new("v0");
    crdt_lww_write(r, "v1");
    crdt_lww_write(r, "v2");
    print("[lww] value: " + crdt_lww_value(r));

    // Replicate hook (no-op unless AIPL_DIST_ENABLE=1).
    crdt_replicate("demo_counter", merged);
    crdt_replicate("demo_set", s);
    crdt_replicate("demo_reg", r);
    print("[demo] done");
  }
}

var d = new Demo();
send d.run();
