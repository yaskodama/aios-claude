// Demo of all three message-passing types in AIPL:
//   past:   send target.method(args);                    // fire-and-forget
//   now:    var x = now target.method(args) timeout 5000 else 0;             // blocks until reply
//   future: var f = future target.method(args);          // returns Future
//           var v = await(f) timeout 5000 else 0;                            //   ... await later
//
// The callee uses reply(value) to deliver the result back to the
// caller's future.  In a past-type send there is no future, so reply()
// just logs [REPLY] for visibility.
//
// Phase 11+ idiom: typed method signatures (params + returns).
class Calculator {
  method add(a: int, b: int) -> int {
    reply(a + b);
  }
  method slow_double(x: int) -> int {
    wait(80);          // pretend this is expensive work
    reply(x * 2);
  }
}

class Driver {
  var calc = 0;             // bound to actor(Calculator) at construction

  method init(c) {
    calc = c;
  }

  method run() {
    // past — no reply value here, just logged
    send calc.add(1, 2);

    // now — synchronous, returns the value
    var s: int = now calc.add(3, 4) timeout 5000 else 0;
    print("[now] 3 + 4 = " ++ s);

    // future — fire two parallel jobs, then await both
    var f1 = future calc.slow_double(10);
    var f2 = future calc.slow_double(20);
    print("[future] both jobs running in parallel");
    var v1: int = await(f1) timeout 5000 else 0;
    var v2: int = await(f2) timeout 5000 else 0;
    print("[future] results: " ++ v1 ++ ", " ++ v2);
  }
}

var calc = new Calculator();
var driver = new Driver(calc);
send driver.run();
