// CE-12 — refinement-aware unification (early subset check).
//
// HM's `unify` previously dropped refinement predicates and relied
// on a post-hoc Z3 sweep (`_check_refinements`) to flag violations
// at the END of a method.  CE-12 adds an *early* refinement subset
// check at unify time: when both sides of a unify are `TRefined`
// and `AIPL_REFINE_UNIFY=1` is set, the runtime asks Z3
//
//     P_actual ∧ ¬P_expected  →  UNSAT?
//
// If UNSAT the implication P_actual ⇒ P_expected holds (the
// subtype check succeeds).  If SAT, a counterexample exists and
// unify raises a `UnifyError` immediately at the call site
// instead of waiting for end-of-pass.
//
// Without the env var the behaviour is the legacy "drop the
// refinement, unify bases" path, so this sample (and every
// existing AIPL program) runs unchanged.
//
// Verify the runtime path:
//   python3 -c '
//   import os; os.environ["AIPL_REFINE_UNIFY"] = "1"
//   from aipl_inference import TRefined, T_INT, unify, UnifyError
//   r1 = TRefined(T_INT, "k", "k > 5")
//   r2 = TRefined(T_INT, "k", "k >= 0")
//   r3 = TRefined(T_INT, "k", "k >= 0")
//   r4 = TRefined(T_INT, "k", "k > 5")
//   unify(r1, r2)           # OK   — k>5 ⇒ k>=0
//   unify(r3, r4)           # raises UnifyError — k>=0 does NOT imply k>5
//   '
//
// The .aipl side simply demonstrates the language-level shape: a
// counter actor that exposes inc / value / reset.  Real refinement
// annotations would gain early-flag behaviour from the unify-level
// check without the sample's body changing.

class Counter {
  var n = 0;
  method inc(d) {
    n = n + d;
  }
  method value() -> int {
    reply(n);
  }
  method reset() {
    n = 0;
  }
}

var c = new Counter();
send c.inc(3);
send c.inc(4);
var v = now c.value() timeout 5000 else 0;
print("count = " ++ v);
