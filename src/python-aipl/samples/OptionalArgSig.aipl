// 末尾が省略可能な組込みの署名（str_sub(s, start [, end]) など）。
//
// 署名パーサが末尾の [, end:int] を読めていなかったため、
//   str_sub(s, i, j) -> 「arity 3 vs declared [2]」
//   str_sub(s, i)    -> 「start の型が int [, end:int] と不一致」
// と、どちらの呼び方も誤って弾かれていた（実行は正しく動いていた）。
class U {
  method both(s) : string !{} { reply(str_sub(s, 1, 3)); }
  method tail(s) : string !{} { reply(str_sub(s, 2)); }
}
var u = new U();
print("both = " ++ (now u.both("abcdef") timeout 200 else "?"));
print("tail = " ++ (now u.tail("abcdef") timeout 200 else "?"));
